    "19406": {
        "created_time": "2018-01-16T16:13:52.465Z",
        "semantic": 1,
        "aka_name": [],
        "entity_type": "intrusion-set",
        "unique_id": "f7ee80f5-3a7b-4cbc-8012-e8e397381109",
        "modified_time": "2025-08-28T08:29:13.553Z",
        "group_name": "APT35",
        "name": "unkown_apt_group",
        "description": "",
        "no_semantic_neighbors": [
            "464c5cd7dd4f32a0893b9fff412b52165855a94d193c08b114858430c26a9f1d",
            "8a47fd166059e7e3c0c1740ea8997205f9e12fc87b1ffe064d0ed4b0bf7c2ce1",
            "ddead6e794b72af26d23065c463838c385a8fdff9fb1b8940cd2c23c3569e43b",
            "5dca88f08b586a51677ff6d900234a1568f4474bbbfef258d59d73ca4532dcaf",
            "5aee738121093866404827e1db43c8e1a7882291afedfe90314ec90b198afb36",
            "d033db88065bd4f548ed13287021ac899d8c3215ebc46fdd33f46a671bba731c",
            "{'SHA-256': 'f2dec56acef275a0e987844e98afcc44bf8b83b4661e83f89c6a2a72c5811d5f'}",
            "e4e3f09c4257269cef6cfbebc83c8a60376ce5e547080502e3e408a3f9916218",
            "f2dec56acef275a0e987844e98afcc44bf8b83b4661e83f89c6a2a72c5811d5f",
            "574fc53ba2e9684938d87fc486392568f8db0b92fb15028e441ffe26c920b4c5",
            "258d9d67e14506b70359daabebd41978c7699d6ce75533955736cdd2b8192c1a",
            "dc5c963f1428db051ff7aa4d43967a4087f9540a9d331dea616ca5013c6d67ce",
            "dcb072061defd12f12deb659c66f40473a76d51c911040b8109ba32bb36504e3"
        ],
        "processed": true,
        "hsage": 0.0,
        "profile_without_enhance_5": "[profile]This intrusion set is likely associated with the APT group Charming Kitten, also known as APT35, Phosphorus, and Ajax Security Team. Its key malware includes BellaCiao and MediaPl, and it has used tools like Persistence.vbs. The group's TTPs involve reconnaissance via search engines and open websites (T1593, T1593.002), spear-phishing with malicious links for initial access, and credential access via API hooking (T1056.004). It is attributed to Iran and has targeted entities in Belgium, France, the UK, Germany, and Israel. Its primary motivation is cyber espionage, and it shows overlaps with groups like BackdoorDiplomacy.[/profile]"
    },
