    "24347": {
        "semantic": 1,
        "unique_id": "5b8db0d9-964a-4195-b032-8db393305c95",
        "entity_type": "malware",
        "name": "Glutton",
        "is_family": false,
        "no_semantic_neighbors": [
            "777c1fda4008f122ff3aef9e80b5b5720c9f2dbc3d7e708277e2ccad1afd8cc5"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "glutton",
        "uncertain_mes": "Glutton: A New Zero-Detection PHP Backdoor from Winnti Targets Cybercrimals\nIntroduction\nOn April 29, 2024, XLab's Cyber Threat Insight and Analysis System(CTIA)\ndetected anomalous activity: IP 172.247.127.210",
        "processed": true,
        "hsage": 13.378536736197134,
        "profile_without_enhance_5": "[profile]Glutton is a PHP backdoor malware attributed to the Winnti APT group. It establishes persistence via Boot or Logon Initialization Scripts (T1037) and uses Unix Shell (T1059.004) for execution. For command and control, it employs Traffic Signaling (T1205) and communicates over Non-Standard Ports (T1571), with observed infrastructure including domains like v6.thinkphp1.com and v20.thinkphp1.com. It targets web servers, specifically those running PHP.[/profile]"
    },
