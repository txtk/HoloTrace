        "unique_id": "11c6d60a-81e4-4b1e-96e4-1c0c72883522",
        "entity_type": "malware",
        "name": "r77 rootkit",
        "is_family": false,
        "no_semantic_neighbors": [
            "e3505901fd44c8f6597ca9c512375b6ecbf3dc21dbae3d373318c99929d62091",
            "42ca0d62a9516cbf4a1ffcd9097d2f2c3b135f82b1c07adf586ef5b23ce96197",
