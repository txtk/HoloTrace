            "8ee2df87e75cc8ab1b77c54288d7a2d9",
            "c3b2982854814e537cd25d27e295cefe",
            "{'MD5': '72645469b04af2d89bc24adda2705b68'}"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "triada",
        "uncertain_mes": "Criminals in 2017 managed to get an advanced backdoor preinstalled on Android devices before they left the factories of manufacturers, Google researchers confirmed on Thursday.",
        "processed": true,
        "hsage": 7.699500340161678,
        "profile_without_enhance_5": "[profile]Triada is an advanced Android backdoor malware family. It was preinstalled on devices before leaving factories in 2017. Its key technical behaviors include using encrypted strings in the Android framework to hinder analysis and communicating with C2 infrastructure via URLs like https://wa.zcnewy.com and http://av2wg.rt14v.com. Its target platform is Android."
    },
