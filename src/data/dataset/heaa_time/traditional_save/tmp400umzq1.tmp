    "22545": {
        "semantic": 1,
        "phase_names": [
            "collection",
            "credential-access"
        ],
        "entity_type": "attack-pattern",
        "unique_id": "da8fd22a-9f82-4181-9281-7a09968e8784",
        "aliases": [
            "Web Portal Capture"
        ],
        "name": "Web Portal Capture",
        "kill_chain_names": [
            "mitre-attack",
            "mitre-attack"
        ],
        "description": "Adversaries may install code on externally facing portals, such as a VPN login page, to capture and transmit credentials of users who attempt to log into the service. For example, a compromised login page may log provided user credentials before logging the user in to the service.\n\nThis variation on input capture may be conducted post-compromise using legitimate administrative access as a backup measure to maintain network access through [External Remote Services](https://attack.mitre.org/techniques/T1133) and [Valid Accounts](https://attack.mitre.org/techniques/T1078) or as part of the initial compromise by exploitation of the externally facing web service.(Citation: Volexity Virtual Private Keylogging)",
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows"
        ],
        "standard_attck_id": "T1056.003",
        "standard_attck_name": "Web Portal Capture",
        "gid": 6435,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "winter vivern"
        ],
        "uncertain_id": "t1056.003",
        "uncertain_name": "web portal capture",
        "uncertain_mes": "Adversaries may install code on externally facing portals, such as a VPN login page, to capture and transmit credentials of users who attempt to log into the service. For example, a compromised login page may log provided user credentials before logging the user in to the service.\n\nThis variation on input capture may be conducted post-compromise using legitimate administrative access as a backup measure to maintain network access through [External Remote Services](https://attack.mitre.org/techniques/T1133) and [Valid Accounts](https://attack.mitre.org/techniques/T1078) or as part of the initial compromise by exploitation of the externally facing web service.(Citation: Volexity Virtual Private Keylogging)",
        "processed": true,
        "hsage": 14.742559410562272,
        "profile_without_enhance_5": "[profile]Web Portal Capture is a technique with MITRE ATT&CK ID T1056.003, falling under the Credential Access and Collection tactics, and is applicable to Windows, Linux, and macOS platforms. It involves adversaries installing malicious code on externally facing portals, such as VPN login pages, to capture and transmit user credentials. This can be executed post-compromise using administrative access or as part of an initial web service exploitation, as observed in campaigns by groups like Winter Vivern.[/profile]"
    },
    "22546": {
        "semantic": 1,
        "phase_names": [
            "collection",
            "credential-access"
        ],
        "entity_type": "attack-pattern",
        "aliases": [
            "Web Portal Capture"
        ],
        "unique_id": "b9d76ae5-80d8-4342-b7f5-25a75b6b546d",
        "name": "T1056.003",
        "description": "Adversaries may install code on externally facing portals, such as a VPN login page, to capture and transmit credentials of users who attempt to log into the service. For example, a compromised login page may log provided user credentials before logging the user in to the service.\n\nThis variation on input capture may be conducted post-compromise using legitimate administrative access as a backup measure to maintain network access through [External Remote Services](https://attack.mitre.org/techniques/T1133) and [Valid Accounts](https://attack.mitre.org/techniques/T1078) or as part of the initial compromise by exploitation of the externally facing web service.(Citation: Volexity Virtual Private Keylogging)",
        "kill_chain_names": [
            "mitre-attack",
            "mitre-attack"
        ],
        "x_mitre_description": "",
        "platforms": [
            "macos",
