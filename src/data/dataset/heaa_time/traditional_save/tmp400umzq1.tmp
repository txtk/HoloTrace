        "hsage": 6.395753066452936
    },
    "22221": {
        "semantic": 1,
        "unique_id": "56d38680-c350-41d4-ac2e-2e2c6ff04875",
        "entity_type": "malware",
        "name": "FaceXInjector",
        "is_family": false,
        "no_semantic_neighbors": [
            "u4mrhg3y6jyfw2dmm2wnocz3g3etp2xc5thzx77uelk7mrk7qtjmc6qd.onion"
        ],
        "processed": true,
        "hsage": 5.6243768415466615,
        "profile_without_enhance_5": "[profile]FaceXInjector, also known as Facestealer, is an Android malware family that masquerades as legitimate applications like photo editors or fitness apps (e.g., com.rapidface.smart.scanner, com.editor.xinphoto) on official stores, achieving tens of thousands of installs. It operates as a loader, utilizing the com.startapp.android.publish library. Its primary function is to steal Facebook credentials by injecting malicious code into the Facebook app. It communicates with command-and-control infrastructure via specific .onion domains (e.g., xozid.onion, mc6qd.onion), indicating the use of the Tor network for stealth.[/profile]"
    },
    "22222": {
        "semantic": 1,
        "unique_id": "7888edda-248f-4714-9576-6ea63e43eb36",
        "entity_type": "malware",
        "name": "HiddenFace",
        "is_family": false,
        "no_semantic_neighbors": [
            "u4mrhg3y6jyfw2dmm2wnocz3g3etp2xc5thzx77uelk7mrk7qtjmc6qd.onion"
        ],
        "processed": true,
        "hsage": 5.6243768415466615,
        "profile_without_enhance_5": "[profile]HiddenFace is a malware targeting Japan, using Tor-based C2 infrastructure including the domains xozid.onion, mc6qd.onion, and vu4fleh3yd4ehpfpciinnwbnh4b77rdeypubhqr2dgfibjtvxpdxozid.onion for command and control.[/profile]"
    },
    "22223": {
        "semantic": 1,
        "unique_id": "343b62d6-df21-4b0a-8a83-c655f56577ba",
        "entity_type": "malware",
        "name": "UPPERCUT",
        "is_family": true,
        "no_semantic_neighbors": [
            "u4mrhg3y6jyfw2dmm2wnocz3g3etp2xc5thzx77uelk7mrk7qtjmc6qd.onion"
        ],
        "uncertain_related_groups": [
            "menupass"
        ],
        "uncertain_name": "uppercut",
        "uncertain_mes": "[UPPERCUT](https://attack.mitre.org/software/S0275) is a backdoor that has been used by [menuPass](https://attack.mitre.org/groups/G0045). (Citation: FireEye APT10 Sept 2018)",
        "processed": true,
        "hsage": 13.373941449925367,
        "profile_without_enhance_5": "[profile]UPPERCUT is a backdoor malware family used by the APT group menuPass (also known as APT10). It employs the Defense Evasion technique 'Compile After Delivery' (T1027.004), delivering payloads as uncompiled source code to be compiled on the victim's system, and uses 'Bypass User Account Control' (T1548.002) for privilege escalation on Windows. Its infrastructure includes the onion domain 'vu4fleh3yd4ehpfpciinnwbnh4b77rdeypubhqr2dgfibjtvxpdxozid.onion' and related indicators like 'xozid.onion' and 'mc6qd.onion'. Its primary target is Japan.[/profile]"
    },
    "22224": {
        "semantic": 1,
        "unique_id": "290449a9-de82-4b06-8629-182d9368201e",
        "entity_type": "malware",
        "name": "UPPERCUT - S0275",
        "is_family": false,
        "no_semantic_neighbors": [
            "u4mrhg3y6jyfw2dmm2wnocz3g3etp2xc5thzx77uelk7mrk7qtjmc6qd.onion"
        ],
        "uncertain_related_groups": [
            "menupass"
        ],
        "uncertain_name": "uppercut",
        "uncertain_mes": "[UPPERCUT](https://attack.mitre.org/software/S0275) is a backdoor that has been used by [menuPass](https://attack.mitre.org/groups/G0045). (Citation: FireEye APT10 Sept 2018)",
        "processed": true,
        "hsage": 13.379324268389448,
        "profile_without_enhance_5": "[profile]UPPERCUT - S0275, also known as uppercut, is a backdoor used by the APT group menuPass (G0045). Its key TTPs include Compile After Delivery (T1027.004) to deliver payloads as source code for on-victim compilation, abuse of Software Deployment Tools (T1072) for lateral movement, Access Token Manipulation (T1134) for privilege escalation, and Bypass User Account Control (T1548.002) for defense evasion. It targets Windows systems and has been associated with infrastructure indicators like the onion domains mc6qd.onion, xozid.onion, and vu4fleh3yd4ehpfpciinnwbnh4b77rdeypubhqr2dgfibjtvxpdxozid.onion.[/profile]"
    },
