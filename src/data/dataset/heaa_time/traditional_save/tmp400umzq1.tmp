        "entity_type": "malware",
        "name": "Ladon",
        "is_family": false,
        "no_semantic_neighbors": [
            "8109902d9d6f819c49452ad04725dd5c2fd80c9d9aa4307af9fcbfa3ffff2082",
            "3cf4c882fdc79b40ae8690dcd61ee29c10b758284ce3d801aa63a0574dcdd5b8",
            "3ca1d30a555498b9cd52d2c113c62296b9251b663fb2228ee32d1f8493554e10",
            "451e5a4c4849ed948431accc30e1664ee13b8edb132a7fa15d8a6826cfd290ef",
            "46a9ca7d5364fbe5fd3d6ffb0f8d86e9a9e566708657e59ef8873d3ed536348d",
            "21d1324c4ff4d68453d6745a1467ef3acf8a853052e3425d12ad85c9b631f968",
            "49a6dad486c203ddf01291455c4a9dbdfa3286836e5e91d1300d2a814eca165d",
            "367ce073e19a8cc30ff8201155afa4be7a6f238c543cf7607fcb3387ce4a1b2d",
            "2ab1807811e0fa7484f6017f2b9ff7f8277ba5a4ddf59d371acef8a1d7e758b8",
            "2d705f0b76f24a18e08163db2f187140ee9f03e43697a9ea0d840c829692d43c",
            "ce79cb1cb66373da8544c6285b20ed09a27bd4f719db2f04d2e826d73215edbe",
            "bfb722ff35162c8af2b9f2ea97f0d60af025a596565145dc91d567daadbebd59",
            "c9d5dc956841e000bfd8762e2f0b48b66c79b79500e894b4efa7fb9ba17e4e9e",
            "7dd168b3a77abac8a8e8503cf4dae72844be2c1d7e6070858283a798e91246c5",
            "64a0ee9c0ce64b797ac4c2b8edafc0cca1d65ccbc7d9f745c77cea6bd17c0cdd",
            "9b7985876c2396dee791e506bd1e4bd212512ea4c47134f7ac1e743977395a40"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "ladon",
        "uncertain_mes": "Web servers are vulnerable to attacks because they are publicly accessible to a wide range of users for the purpose of delivering web services. This accessibility makes them a prime target for threat actors. AhnLab Security Emergency response Center (ASEC) is monitoring attacks targeting vulnerable web servers that have not been patched or are poorly managed.",
        "processed": true,
        "hsage": 13.39778720387936,
        "profile_without_enhance_5": "[profile]Ladon is a malware tool associated with the Andariel group (also known as Silent Chollima). Its key technical behaviors include credential theft via techniques like Golden Ticket forgery (T1558.001) and OS credential dumping, network and host information gathering (T1590, T1592), and data obfuscation (T1001) for command and control. It targets Windows platforms and performs specific actions such as FTP/HTTP sniffing, dumping LSASS memory, enumerating processes, and stealing passwords from services like IIS, FileZilla, and WiFi. Its infrastructure includes domains like www2.sdelanasnou.com, server.dotomater.club, doc.redstrpela.net, tech.songuulcomiss.com, and www1.dotomater.club.[/profile]"
    },
