    "19976": {
        "semantic": 1,
        "unique_id": "6280fac3-0c88-4ee9-9078-c1db3a0f7b29",
        "entity_type": "malware",
        "name": "Tsunami",
        "is_family": false,
        "no_semantic_neighbors": [
            "5bb45f372fb4df6a9c6a5460fa1845f5e96af53aa41939eb251cbe989a5cac6c",
            "0af1b8cd042b6e2972c8ef43d98c0a0642047ec89493d315909629bcf185dffd",
            "f6069886728686c5c6566c0332ba37c16805fb623b6fcbbd1dd2e09ee5cc75b1",
            "e68263fcc9b1f8729bba00f63fb5482f069218333a65cf1b0caa0fe6d7ce1ff3",
            "43545f6cd370e6f200347bd9bbafdc3d94240775d816cd5e24dc8072d0f1c9b5",
            "1fcc2061f767574044ca1e97f92ca1d44ee0b35e0a796e3bd6a949ad4b1175e5",
            "5100dbaf942556184928fc0387fb5aab69dc2ef7e77b29db75905329697f2350",
            "c964791501a48e919446892fe14ed101c27da375668ac7a24de891dc68356f9b",
            "9a5d68ca481091fbfde4d63087a836412bc8805b9a7cae000bd53899b0399e87",
            "7b229b173b32cde47963de2a6e4bfcf243a8646fbf100fb2e379526b42ee4515",
            "11be73a9516ace88b1a0af52e4454f4bc1db514cc2511b3e02318bd8be2bcf09",
            "10c2913361debb5f1db95c170ce2d6892d598d97b9f1f7f76a8bc7b5053e801a"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "tsunami",
        "uncertain_mes": "Tsunami Backdoor Can Be Used for Denial of Service Attacks\nPosted on by Peter James\nA new backdoor and hacker tool, Tsunami, has been discovered. This hacker tool seems to be a port of a Linux malware, which has been around for some time, and provides remote access to hackers by listening in on an IRC (Internet relay chat) channel for instructions.",
        "processed": true,
        "hsage": 12.806822693704271,
        "profile_without_enhance_5": "[profile]Tsunami is a backdoor malware, also known as a hacker tool, that provides remote access via IRC channels and can be used for denial-of-service attacks. It is associated with groups like APT29 and is linked to the malware families Dacls, ELF.WellMess, and Cloud Snooper. Its key behaviors include credential access via unsecured credentials (T1552), defense evasion through rootkits (T1014) and impairing defenses (T1562), discovery of container resources (T1613), and command and control using DNS tunneling (T1071.004). It targets Linux platforms and exploits vulnerabilities including CVE-2017-10271, CVE-2020-14883, and CVE-2023-46604, with infrastructure involving IP addresses like 51.222.111.116.[/profile]"
    },
