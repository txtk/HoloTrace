    "17717": {
        "semantic": 1,
        "unique_id": "3b573c18-ec07-4765-be36-5b9165a4d3b9",
        "entity_type": "malware",
        "name": "SpyPress.MDAEMON",
        "is_family": false,
        "no_semantic_neighbors": [],
        "processed": true,
        "hsage": 5.678204463611325,
        "profile_without_enhance_5": "[profile]SpyPress.MDAEMON is a malware variant that exploits vulnerabilities including CVE-2024-11182, CVE-2020-35730, CVE-2024-27443, CVE-2023-43770, and CVE-2023-23397. It has been observed targeting systems in Cameroon, Serbia, Cyprus, Greece, and Romania. The malware uses infrastructure such as the domains terembg.com, hfuu.de, jiaw.shop, raxia.top, and tgh24.xyz. Analysis of related RATs like DcRAT, AsyncRAT, and Venom RAT reveals a shared configuration pattern for command and control, including a specific salt value (\"4463526174427971777164616e6368756e\"), connection to host 20.200.63.2 on port 2525, and installation in the %AppData% folder.[/profile]"
    },
    "17718": {
        "semantic": 1,
        "unique_id": "32319e9d-cc38-4230-86a3-9fe4548193ab",
        "entity_type": "malware",
        "name": "SpyPress.ZIMBRA",
        "is_family": false,
        "no_semantic_neighbors": [],
        "processed": true,
        "hsage": 5.678204463611325,
        "profile_without_enhance_5": "[profile]SpyPress.ZIMBRA is a malware targeting Zimbra Collaboration Suite (ZCS) email servers, exploiting vulnerabilities including CVE-2020-35730, CVE-2023-43770, CVE-2024-27443, CVE-2024-11182, and CVE-2023-23397. It is associated with infrastructure indicators such as lsjb.digital, skiff.com, ikses.net, terembg.com, and hijx.xyz. Its deployment has been observed in Cameroon, Serbia, Cyprus, Greece, and Romania. The malware is related to tools like Ladon for scanning and exploitation and shares operational context with other malware like Zyklon and Agent Tesla.[/profile]"
    },
    "17719": {
        "semantic": 1,
        "unique_id": "0693f7b0-d735-4210-a117-0a1c88139c98",
        "entity_type": "malware",
        "name": "SpyPress.ROUNDCUBE",
        "is_family": false,
        "no_semantic_neighbors": [],
        "processed": true,
        "hsage": 5.678204463611325,
        "profile_without_enhance_5": "[profile]SpyPress.ROUNDCUBE, a JavaScript payload, is part of the SpyPress malware family which targets vulnerable webmail clients like Roundcube. It operates by collecting email mailbox data when a malicious email is received or viewed, then exfiltrating this data to a command-and-control server. It has been used in campaigns attributed to the Sednit group. Associated infrastructure includes domains like raxia.top, hijx.xyz, ikses.net, lsjb.digital, and hfuu.de, and it exploits vulnerabilities including CVE-2023-43770, CVE-2024-27443, CVE-2020-35730, CVE-2024-11182, and CVE-2023-23397, with observed targeting in Cameroon, Serbia, Cyprus, Greece, and Romania.[/profile]"
    },
    "17720": {
        "semantic": 1,
        "unique_id": "fe19afea-d433-4dc7-a339-e48a5b06f806",
        "entity_type": "malware",
        "name": "SpyPress.HORDE",
        "is_family": false,
        "no_semantic_neighbors": [],
        "processed": true,
        "hsage": 5.678204463611325,
        "profile_without_enhance_5": "[profile]SpyPress.HORDE, also known as SpyPress, is a JavaScript-based malware payload that targets vulnerable webmail clients to collect email mailbox data upon receipt or viewing of a malicious email, exfiltrating it to a command-and-control server. It has been associated with campaigns by the Sednit group and targets locations including Serbia, Cameroon, Cyprus, Greece, and Romania. Key indicators of compromise include domains like victim.org, hijx.xyz, lsjb.digital, global-world-news.net, and hfuu.de, and it exploits vulnerabilities such as CVE-2020-35730, CVE-2024-11182, CVE-2024-27443, CVE-2023-43770, and CVE-2023-23397.[/profile]"
    },
