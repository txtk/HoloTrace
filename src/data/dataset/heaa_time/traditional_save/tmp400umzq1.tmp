    "19437": {
        "semantic": 1,
        "unique_id": "e154c3bc-c40f-4d3b-9669-7486ba2c5750",
        "entity_type": "malware",
        "name": "MediaPl",
        "is_family": false,
        "no_semantic_neighbors": [
            "f2dec56acef275a0e987844e98afcc44bf8b83b4661e83f89c6a2a72c5811d5f"
        ],
        "processed": true,
        "hsage": 5.655635894211864,
        "profile_without_enhance_5": "[profile]MediaPl is a backdoor malware, with a related variant known as EYEGLASS. It operates by establishing persistence through Windows Registry keys for automatic startup and monitors specific applications on the victim system. Its infrastructure includes domains like ndrrftqrlblfecpupppp.supabase.co and east-healthy-dress.glitch.me. Associated ATT&CK techniques include T1020 (Automated Exfiltration), T1566 (Phishing for initial access), T1036 (Masquerading), T1176 (Software Extensions for persistence), and T1053 (Scheduled Task/Job). It has been observed targeting entities in Belgium, France, the UK, Israel, and the United States.[/profile]"
    },
    "19438": {
        "semantic": 1,
        "unique_id": "1229fea2-e07b-4c41-b040-3e713c9f75f1",
        "entity_type": "malware",
        "name": "MischiefTut",
        "is_family": false,
        "no_semantic_neighbors": [
            "f2dec56acef275a0e987844e98afcc44bf8b83b4661e83f89c6a2a72c5811d5f"
        ],
        "processed": true,
        "hsage": 5.655248818034508,
        "profile_without_enhance_5": "[profile]MischiefTut is a malware entity with no known aliases or attributed groups. Its key technical behaviors include using Automated Exfiltration (T1020) for data transfer, establishing persistence via Browser Extensions (T1176) and Scheduled Task/Job (T1053), employing Masquerading (T1036) for defense evasion, and utilizing Phishing (T1566) for initial access. Its target platforms are Windows, Linux, and macOS. Associated infrastructure includes domains like coral-polydactyl-dragonfruit.glitch.me and supabase.co subdomains, with observed targeting in Belgium, France, the UK, Israel, and the USA.[/profile]"
    },
