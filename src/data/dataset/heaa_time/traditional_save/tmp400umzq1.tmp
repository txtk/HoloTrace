        "unique_id": "5b29d250-3429-4d99-8a4b-972e28905e78",
        "entity_type": "malware",
        "name": "vmmisc.ko",
        "is_family": false,
        "no_semantic_neighbors": [
            "118.163.30.46",
            "118.163.30.45",
            "218.92.0.210",
            "163.29.3.119",
            "59.125.159.81",
            "59.125.159.254",
            "122.114.233.77"
        ],
        "processed": true,
        "hsage": 5.628013228892011,
        "profile_without_enhance_5": "[profile]vmmisc.ko is a malware entity (not a family) targeting Taiwan, with indicators including domains like webcloud-notice.com, wuzak.com, nid-security.com, and koala-app.com. Its key technical behavior involves checking for the presence of specific VirtualBox-related kernel module directories and files (e.g., under /sys/module/vboxguest and /sys/module/vboxsf), which is a tactic associated with the ztorg malware for reconnaissance or evasion in virtualized environments. The target platform is Linux-based systems.[/profile]"
    },
