    "16637": {
        "semantic": 1,
        "unique_id": "b51099d0-8b5c-4b13-9f88-80d0443b6e7b",
        "entity_type": "malware",
        "name": "FPSpy",
        "is_family": false,
        "no_semantic_neighbors": [
            "c69cd6a9a09405ae5a60acba2f9770c722afde952bd5a227a72393501b4f5343",
            "faf666019333f4515f241c1d3fcfc25c67532463245e358b90f9e498fe4f6801",
            "a173a425d17b6f2362eca3c8ea4de9860b52faba414bbb22162895641dda0dc2",
            "2e768cee1c89ad5fc89be9df5061110d2a4953b336309014e0593eb65c75e715",
            "990b7eec4e0d9a22ec0b5c82df535cf1666d9021f2e417b49dc5110a67228e27"
        ],
        "processed": true,
        "hsage": 5.6619639320321165,
        "profile_without_enhance_5": "[profile]FPSpy is a malware entity, not a family, associated with the Kimsuky group. Its technical behaviors include automated data exfiltration (T1020), data encoding for C2 obfuscation (T1132), staging collected data (T1074), keylogging (T1056.001), and screen capture (T1113). It targets Windows, Linux, and macOS platforms. Infrastructure indicators include domains like nidlogin.apollo.r-e.kr and mail.apollo-page.r-e.kr, and it has been referenced in analysis of toolsets linked to Sparkling Pisces.[/profile]"
    },
    "16638": {
        "semantic": 1,
        "unique_id": "39328061-f175-420d-94f5-57a5b4932e15",
        "entity_type": "malware",
        "name": "KLogEXE",
        "is_family": false,
        "no_semantic_neighbors": [
            "faf666019333f4515f241c1d3fcfc25c67532463245e358b90f9e498fe4f6801",
            "2e768cee1c89ad5fc89be9df5061110d2a4953b336309014e0593eb65c75e715",
            "990b7eec4e0d9a22ec0b5c82df535cf1666d9021f2e417b49dc5110a67228e27",
            "c69cd6a9a09405ae5a60acba2f9770c722afde952bd5a227a72393501b4f5343",
            "a173a425d17b6f2362eca3c8ea4de9860b52faba414bbb22162895641dda0dc2"
        ],
        "processed": true,
        "hsage": 5.665388642471321,
        "profile_without_enhance_5": "[profile]KLogEXE is a keylogger malware attributed to the Kimsuky group, which uses the GetKeyState API to capture keystrokes and writes logs to disk in a <Date><Title bar><content> format. Its technical behaviors include data staging (T1074), data encoding (T1132), automated exfiltration (T1020), and input capture/keylogging (T1056/T1056.001). It targets Windows platforms and has been associated with infrastructure domains like nidlogin.apollo.r-e.kr and mail.apollo-page.r-e.kr, with registrant email cfa4a551515dc742s@gmail.com linking it to related malware.[/profile]"
    },
