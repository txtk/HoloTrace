            "aa09e9dca4994404a5f654be2a051c46f8799b0e987bcefef2b52412ac402105",
            "d1ca5349da287dbb13a1ea2a2982d23e6ce34ed822baee7468ce1980a4179d42",
            "12bf973b503296da400fd6f9e3a4c688f14d56ce82ffcfa9edddd7e4b6b93ba9",
            "a265ae8fed205efb5bcc2fb59e60f743f45b7ad402cb827bc98dee397069830c",
            "b55f70467f13fbad6dde354d8653d1d6180788569496a50b06f2ece1f57a5e91",
            "ac9e3bf1cc87bc86318b258498572793d9fb082417e3f2ff17050cf6ec1d0bb5",
            "01ebc558aa7028723bebd8301fd110d01cbd66d9a8b04685afd4f04f76e7b80c"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "romcom rat",
        "uncertain_mes": "Ukraine remains Russia’s biggest cyber focus in 2023\nGoogle’s Threat Analysis Group (TAG) continues to disrupt campaigns from multiple sets of Russian government-backed attackers focused on the war in Ukraine. This blog provides insights on attacker trends from primarily January - March 2023, continuing our analysis from Fog of War: How the Ukraine Conflict Transformed the Cyber Threat Landscape.",
        "processed": true,
        "hsage": 13.425837694056781,
        "profile_without_enhance_5": "[profile]RomCom is a Remote Access Trojan (RAT) also known as RomCom RAT. It has been attributed to the threat actor Gold Prelude. Its key technical behaviors include subverting trust controls for defense evasion, performing domain trust and network share discovery, and using protocol tunneling for command and control. It archives collected data prior to exfiltration. The malware targets Windows platforms and has used infrastructure domains including speedymarker.com, redditanalytics.pm, and pap-cut.com, with campaigns observed targeting Ukraine and Poland.[/profile]"
    },
    "21308": {
        "semantic": 1,
        "unique_id": "ec689090-99ce-492c-8564-b1cd00f09bd8",
        "entity_type": "malware",
        "name": "PEAPOD",
        "is_family": false,
        "no_semantic_neighbors": [
            "d1ca5349da287dbb13a1ea2a2982d23e6ce34ed822baee7468ce1980a4179d42",
            "3c014d59cf22acbd062a4e2cab8cb8ede7127b6a69af9db45a7dcefde866369a",
            "4f66d6ec70a49aaddb8018af1bf859284a6a4a27eb2615c80a32d5c7c156e476",
            "4299c16e11a725dd2ac9468c5c0aabf94ea5a90d2232810c19ba13b35b3708f9",
            "41e995a8554fb6e4160d0e445856221ece2117a2b030012ead9efe76611bdc14",
            "83448756a4cafbfd784d36add719cffa65b912e550d3a5fd63d407201c6ff94c"
        ],
        "processed": true,
        "hsage": 5.656160053715638,
        "profile_without_enhance_5": "[profile]PEAPOD is a malware that connects to C2 infrastructure via domains like redditanalytics.pm, mctelemetryzone.com, and netstaticsinformation.com, and uses URLs such as https://redditanalytics.pm/Mi8xMzI0NTY3ODk= and http://onedrive.live.com/?authkey=%21AAdO%2Di5%2DikrnuaA&id=79E2A760F4732317%21106&cid=79E2A760F4732317. Its TTPs include Defense Evasion techniques like Subvert Trust Controls to bypass execution controls and Deobfuscate/Decode Files or Information to decode hidden artifacts, as well as Persistence techniques like Browser Extensions (T1176) and Event Triggered Execution (T1546) to maintain access and achieve privilege escalation.[/profile]"
    },
