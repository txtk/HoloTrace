    "21069": {
        "semantic": 1,
        "unique_id": "57c2a798-a59e-4f6d-a13a-4a58313cfb9c",
        "entity_type": "malware",
        "name": "Tactical RMM",
        "is_family": false,
        "no_semantic_neighbors": [
            "60c387d9d52c98de5c5d8453f64a6541ec4db645f6709d1fe51903182943438c"
        ],
        "processed": true,
        "hsage": 5.735244512163727,
        "profile_without_enhance_5": "[profile]Tactical RMM is a legitimate Remote Monitoring and Management (RMM) tool abused by threat actors as a command and control (C2) agent. It has been deployed by groups including Vanilla Tempest, Gold Cabin, Mummy Spider, and Mealybug, often via installation commands specifying a C2 API endpoint like 'api.floppasoftware[.]com'. Associated infrastructure domains include vatacloud.com, softwaree-cloud.com, mafateehgroup.com, webapicloud.com, and nc6010721b.biz. Its use is linked to techniques like Exfiltration Over Web Service (T1567) and Access Token Manipulation (T1134), primarily targeting Windows systems, with victimology including Jordan, Saudi Arabia, and Israel.[/profile]"
    },
