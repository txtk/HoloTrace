            "dragonfly",
            "ke3chang",
            "magic hound",
            "medusa group",
            "apt41",
            "wizard spider",
            "threat group-3390",
            "fin8",
            "volt typhoon",
            "earth lusca",
            "chimera",
            "gamaredon group",
            "fin7",
            "muddywater",
            "apt3",
            "fin10",
            "apt32",
            "gallium",
            "sandworm team",
            "lazarus group",
            "oilrig",
