    "17757": {
        "semantic": 1,
        "unique_id": "416b7de4-6426-4c24-8462-6733ef9e7ef7",
        "entity_type": "malware",
        "name": "GooseEgg",
        "is_family": false,
        "no_semantic_neighbors": [
            "c60ead92cd376b689d1b4450f2578b36ea0bf64f3963cfa5546279fa4424c2a5",
            "6b311c0a977d21e772ac4e99762234da852bbf84293386fbe78622a96c0b052f",
            "41a9784f8787ed86f1e5d20f9895059dac7a030d8d6e426b9ddcaf547c3393aa",
            "7d51e5cc51c43da5deae5fbc2dce9b85c0656c465bb25ab6bd063a503c1806a9"
        ],
        "processed": true,
        "hsage": 5.66395434785274,
        "profile_without_enhance_5": "[profile]GooseEgg is a tool used by APT28 to exploit the Windows Print Spooler vulnerability CVE-2022-38028 for privilege escalation, manipulating a JavaScript constraints file to execute with SYSTEM permissions. Its associated techniques include abusing Accessibility Features (T1546.008), BITS Jobs (T1197), Bypass User Account Control (T1548.002), credential dumping from the Security Account Manager (T1003.002), and general Exploitation for Privilege Escalation (T1068). It targets Windows platforms and has been observed in operations against Ukraine and the United States.[/profile]"
    },
