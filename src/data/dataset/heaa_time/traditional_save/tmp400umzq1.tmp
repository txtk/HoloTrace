    "21374": {
        "semantic": 1,
        "unique_id": "666a51d7-1848-4adf-b3e2-a4e059352440",
        "entity_type": "malware",
        "name": "GRAPELOADER",
        "is_family": false,
        "no_semantic_neighbors": [
            "653db3b63bb0e8c2db675cd047b737cefebb1c955bd99e7a93899e2144d34358",
            "adfe0ef4ef181c4b19437100153e9fe7aed119f5049e5489a36692757460b9f8",
            "d931078b63d94726d4be5dc1a00324275b53b935b77d3eed1712461f0c180164",
            "420d20cddfaada4e96824a9184ac695800764961bad7654a6a6c3fe9b1b74b9a",
            "85484716a369b0bc2391b5f20cf11e4bd65497a34e7a275532b729573d6ef15e",
            "24c079b24851a5cc8f61565176bbf1157b9d5559c642e31139ab8d76bbb320f8",
            "78a810e47e288a6aff7ffbaf1f20144d2b317a1618bba840d42405cddc4cff41"
        ],
        "processed": true,
        "hsage": 5.699251189254328,
        "profile_without_enhance_5": "[profile]GRAPELOADER, also known as GuLoader, is a loader malware. It employs techniques including Boot or Logon Autostart Execution for persistence, System Binary Proxy Execution for defense evasion, and Data Encoding or Encrypted Channel (T1573) for command-and-control obfuscation. Its C2 infrastructure has involved domains such as bravecup.com, silry.com, and ophibre.com, with specific URIs like /inva.php and /invb.php. It has been used in attacks targeting organizations in European countries including Ireland, Belgium, Denmark, Greece, and Spain.[/profile]"
    },
