    "22035": {
        "semantic": 1,
        "unique_id": "54e67163-36e0-4be1-bf20-6544263712ab",
        "entity_type": "malware",
        "name": "JSObfuscated",
        "is_family": false,
        "no_semantic_neighbors": [
            "a0f183ea54cb25dd8bdba586935a258f0ecd3cba0d94657985bb1ea02af8d42c",
            "e25a8a21fffb5ae871022f4342db2a0e6561191e",
            "9809f2bbfff6559775bbe3f2656155515e3cd137",
            "d61ff2430473f06fc42a1d452597c610027aace2"
        ],
        "processed": true,
        "hsage": 5.693626716906163,
        "profile_without_enhance_5": "[profile]JSObfuscated is a malware entity. Its technical behaviors include using Multi-Stage Channels for command and control, Boot or Logon Autostart Execution for persistence, Access Token Manipulation for privilege escalation, and Indicator Removal for defense evasion. It has been observed targeting systems in Peru, Italy, Latvia, Germany, and India, and utilizes infrastructure such as the domains waterforvoiceless.org and siestakeying.com. The malware employs obfuscation techniques.[/profile]"
    },
    "22036": {
        "semantic": 1,
        "unique_id": "8c5f9122-a3f7-4baa-bbc4-c7e30cf68904",
        "entity_type": "malware",
        "name": "APT29",
        "is_family": false,
        "no_semantic_neighbors": [
            "a0f183ea54cb25dd8bdba586935a258f0ecd3cba0d94657985bb1ea02af8d42c",
            "e25a8a21fffb5ae871022f4342db2a0e6561191e",
            "9809f2bbfff6559775bbe3f2656155515e3cd137",
            "d61ff2430473f06fc42a1d452597c610027aace2"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "unidentified 107 (apt29)",
        "uncertain_mes": "EclecticIQ analysts assess with high confidence that two observed PDF documents are part of an ongoing campaign targeting Ministries of Foreign Affairs of NATO aligned countries. The PDF files masquerade as coming from the German embassy and contained two diplomatic invitation lures.",
        "processed": true,
        "hsage": 13.395192978185877,
        "profile_without_enhance_5": "[profile]APT29 is a malware entity attributed to the APT29 group, which has targeted Ministries of Foreign Affairs in NATO-aligned countries using diplomatic invitation lures. Its technical behaviors include employing Multi-Stage Channels (T1104) for command-and-control, Brute Force (T1110) for credential access, System Service Discovery (T1007), Boot or Logon Autostart Execution (T1547) for persistence, and Access Token Manipulation (T1134) for defense evasion and privilege escalation. Associated infrastructure includes domains like waterforvoiceless.org and siestakeying.com, with observed targeting in locations such as Peru, Italy, Latvia, Germany, and India.[/profile]"
    },
    "22037": {
        "semantic": 1,
        "unique_id": "a0abd5a0-0235-4d3b-97bb-e0531c058442",
        "entity_type": "malware",
        "name": "ROOTSAW",
        "is_family": false,
        "no_semantic_neighbors": [
            "a0f183ea54cb25dd8bdba586935a258f0ecd3cba0d94657985bb1ea02af8d42c",
            "e25a8a21fffb5ae871022f4342db2a0e6561191e",
            "9809f2bbfff6559775bbe3f2656155515e3cd137",
            "d61ff2430473f06fc42a1d452597c610027aace2"
        ],
        "processed": true,
        "hsage": 5.6948759206546,
        "profile_without_enhance_5": "[profile]ROOTSAW is a malicious HTML dropper that uses HTML smuggling to deliver payloads like IMG or ISO files to victim systems. It is associated with APT29 and employs techniques including Boot or Logon Autostart Execution for persistence, Multi-Stage Channels for C2, and Indicator Removal for defense evasion. Its infrastructure involves domains such as waterforvoiceless.org and siestakeying.com, with observed targeting in Peru, Italy, Latvia, Germany, and India.[/profile]"
    },
    "22038": {
        "semantic": 1,
