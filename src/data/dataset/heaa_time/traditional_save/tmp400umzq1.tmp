        "hsage": 0
    },
    "18150": {
        "semantic": 1,
        "unique_id": "29c5b0c5-38e3-4f18-af05-4c2e17fcad97",
        "entity_type": "malware",
        "name": "TranslucentGh0st",
        "is_family": false,
        "no_semantic_neighbors": [
            "7587ca6b8163e3e5b05e4a9fc79ec19deee9c971e6f76adadc4d970c99cad4f3",
            "1116efd48ca01623bf385cd612f4da1eb9eeba0329e41d0e068bcd6557a46f8f",
            "6b5b8b12af21700a212d5ece27f065f8f9ed38b2969ad5dfaa790bc76754de6c",
            "93abcc4062a14ba3d3309fc5e8a910e81a4e3ce1bbbf5e6f7857779b6e76f43a"
        ],
        "processed": true,
        "hsage": 5.758914217960742,
        "profile_without_enhance_5": "[profile]TranslucentGh0st, also known as a variant of the SilentGh0st family, is a malware featuring dynamic plugin loading and a lighter footprint for evasive operation. It is associated with the SparklingGoblin group. Its techniques include Execution Guardrails (T1480) to constrain payload execution to specific environmental conditions, and the use of BITS Jobs (T1197) for defense evasion and persistence on Windows. It targets Windows platforms and has utilized infrastructure domains such as link.theworkguyoo.com, sopho.kozow.com, images.emldn.com, mail.simpletra.com, and payroll.mywire.org.[/profile]"
    },
    "18151": {
        "created_time": "2025-08-14T07:31:32.425Z",
        "semantic": 1,
        "aka_name": [],
        "entity_type": "intrusion-set",
        "unique_id": "9a95f992-2d9d-412d-a248-07ed95263f6c",
        "modified_time": "2025-08-14T19:14:22.778Z",
        "group_name": "Unfading Sea Haze",
        "name": "unkown_apt_group",
        "description": "",
        "no_semantic_neighbors": [
            "93abcc4062a14ba3d3309fc5e8a910e81a4e3ce1bbbf5e6f7857779b6e76f43a",
            "7587ca6b8163e3e5b05e4a9fc79ec19deee9c971e6f76adadc4d970c99cad4f3",
            "1116efd48ca01623bf385cd612f4da1eb9eeba0329e41d0e068bcd6557a46f8f",
            "6b5b8b12af21700a212d5ece27f065f8f9ed38b2969ad5dfaa790bc76754de6c"
        ],
        "processed": true,
        "hsage": 0.0,
        "profile_without_enhance_5": "[profile]This intrusion set, likely the Chinese-aligned APT group Unfading Sea Haze, is also known as SilentGh0st actor. Its key malware includes SilentGh0st (the oldest Gh0stRAT variant), SharpJSHandler, and TranslucentGh0st. Its distinctive TTPs involve using BITS Jobs for persistence and download, employing Execution Guardrails to constrain payload execution to specific environments, and abusing elevation control mechanisms. It is attributed to China and primarily targets military and government entities in the South China Sea region. Its motivation is espionage, and it shows overlaps with groups like SparklingGoblin.[/profile]"
    },
