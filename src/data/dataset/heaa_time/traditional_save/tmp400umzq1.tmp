    "22015": {
        "semantic": 1,
        "unique_id": "1a2cd1c4-fd15-4868-9132-4d1722f6858d",
        "entity_type": "malware",
        "name": "HOMESTEEL",
        "is_family": false,
        "no_semantic_neighbors": [],
        "processed": true,
        "hsage": 5.715176133949779,
        "profile_without_enhance_5": "[profile]HOMESTEEL is a malware that uses Data Obfuscation (T1001) and Data Encoding (T1132) for command and control to evade detection, and employs Internal Spearphishing (T1534) for lateral movement. It stages capabilities (T1608) on infrastructure like compromised web servers and uses indicators including domains such as aws-s3.cloud, central-2-aws.ua-aws.army, s3-nsa.cloud, s3-fbi.cloud, and s3-aws.cloud. It has been associated with targeting locations including South Georgia and the South Sandwich Islands, Georgia, and Ukraine.[/profile]"
    },
