            "05880ff0442bbedc8f46076ef56d4d1ffeda68d9ef26b659c4868873fa84c1a9",
            "d6e6c786b793b46a1ee9b18b058e045d0aa1c83aa2b6aa493637f611d654d957",
            "3ccbd8bd7424506b26491e5ff5ff55b000adaab1074ccf3b7452d0883f668040",
            "1301ec3006ad03742bfaef047aa434320aa0e725a99be5d6be27b955a814fcf4",
            "03ee2011ad671b1781015024ea53edfbff92c28c2b123bba02d6a6f462e74105",
            "c3efbac8ebffcf3d8178ce23e59f3b4978f5a91bf93773889870d45cc1b554b0"
        ],
        "uncertain_related_groups": [
            "unc5537"
        ],
        "uncertain_name": "metastealer",
        "uncertain_mes": "MetaStealer: String Decryption and DGA overview\nBy: Jonathan McCay, Joshua Platt and Jason Reaves",
        "processed": true,
        "hsage": 13.341364494679752,
        "profile_without_enhance_5": "[profile]MetaStealer is a stealer malware active since at least May 2022, also known as metastealer. It is attributed to the threat group UNC5537. Its key technical behaviors include using a Domain Generation Algorithm (DGA), string decryption for obfuscation, and employing techniques like Indirect Command Execution and Virtualization/Sandbox Evasion for defense. It targets data such as files, crypto wallets, and browser information, and has been associated with infrastructure like the domain document-cdn.org.[/profile]"
    },
