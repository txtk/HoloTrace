            "9b7985876c2396dee791e506bd1e4bd212512ea4c47134f7ac1e743977395a40"
        ],
        "uncertain_related_groups": [
            "ta428"
        ],
        "uncertain_name": "cotx rat",
        "uncertain_mes": "OPERATION LAGTIME IT: COLOURFUL PANDA\nFOOTPRINT\nFumio Ozawa, Shogo Hayashi & Rintaro Koike\nNTT Security (Japan) KK\nfumio.ozawa@global.ntt\nsyogo.hayashi@global.ntt\nrintaro.koike@global.ntt\n30 September - 2 October, 2020 / vblocalhost.com\nwww.virusbulletin.com  \nOPERATION LAGTIME IT: COLOURFUL PANDA FOOTPRINT OZAWA ET AL.\n2\nVIRUS BULLETIN CONFERENCE SEPT - OCT 2020\nABSTRACT",
        "processed": true,
        "hsage": 13.39778720387936,
        "profile_without_enhance_5": "[profile]Cotx, also known as Cotx RAT, is a Remote Access Trojan associated with threat groups including TA428, Hellsing, Ice Fog, Pirate Panda, Rancor, Tick, Tonto Team, and Karma Panda. Its technical behaviors involve credential access via Golden Ticket Kerberos ticket forgery, reconnaissance through gathering victim network and host information, and command and control using data obfuscation. It targets Windows platforms and has utilized infrastructure such as the domains www1.nppnavigator.net, tech.songuulcomiss.com, fax.internnetionfax.com, custom.songuulcomiss.com, and www3.vpkimplus.com.[/profile]"
    },
    "22784": {
