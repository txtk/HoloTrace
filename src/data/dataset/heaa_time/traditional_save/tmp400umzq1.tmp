    "20247": {
        "semantic": 1,
        "phase_names": [
            "command-and-control"
        ],
        "entity_type": "attack-pattern",
        "aliases": [
            "Bidirectional Communication"
        ],
        "unique_id": "b84c171e-c1cd-4938-8466-0f659622d573",
        "name": "T1102.002",
        "description": "Adversaries may use an existing, legitimate external Web service as a means for sending commands to and receiving output from a compromised system over the Web service channel. Compromised systems may leverage popular websites and social media to host command and control (C2) instructions. Those infected systems can then send the output from those commands back over that Web service channel. The return traffic may occur in a variety of ways, depending on the Web service being utilized. For example, the return traffic may take the form of the compromised system posting a comment on a forum, issuing a pull request to development project, updating a document hosted on a Web service, or by sending a Tweet. \n\nPopular websites and social media acting as a mechanism for C2 may give a significant amount of cover due to the likelihood that hosts within a network are already communicating with them prior to a compromise. Using common services, such as those offered by Google or Twitter, makes it easier for adversaries to hide in expected noise. Web service providers commonly use SSL/TLS encryption, giving adversaries an added level of protection.",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows",
            "ESXi"
        ],
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "polonium",
            "apt37",
            "muddywater",
            "fin7",
            "apt12",
            "zirconium",
            "kimsuky",
            "gamaredon group",
            "magic hound",
            "sandworm team",
            "turla",
            "hexane",
            "apt28",
            "lazarus group",
            "apt39",
            "carbanak"
        ],
        "uncertain_id": "t1102.002",
        "uncertain_name": "bidirectional communication",
        "uncertain_mes": "Adversaries may use an existing, legitimate external Web service as a means for sending commands to and receiving output from a compromised system over the Web service channel. Compromised systems may leverage popular websites and social media to host command and control (C2) instructions. Those infected systems can then send the output from those commands back over that Web service channel. The return traffic may occur in a variety of ways, depending on the Web service being utilized. For example, the return traffic may take the form of the compromised system posting a comment on a forum, issuing a pull request to development project, updating a document hosted on a Web service, or by sending a Tweet. \n\nPopular websites and social media acting as a mechanism for C2 may give a significant amount of cover due to the likelihood that hosts within a network are already communicating with them prior to a compromise. Using common services, such as those offered by Google or Twitter, makes it easier for adversaries to hide in expected noise. Web service providers commonly use SSL/TLS encryption, giving adversaries an added level of protection. ",
        "processed": true,
        "hsage": 12.273130777791007,
        "profile_without_enhance_5": "[profile]T1102.002, known as Bidirectional Communication, is a command-and-control technique within the MITRE ATT&CK framework applicable to Windows, Linux, macOS, and ESXi platforms. It involves adversaries leveraging legitimate external web services like social media or document hosting sites to send commands to and receive output from a compromised system, using methods such as posting comments or updating documents to blend with normal traffic. This technique is associated with groups including APT28, Lazarus, and MuddyWater, and can be complemented by other methods like using custom protocols (T1094), adding junk data to C2 traffic (T1001.001), or employing multilayer encryption (T1079).[/profile]"
    },
    "20248": {
        "semantic": 1,
        "phase_names": [
            "command-and-control"
        ],
        "aliases": [
            "Bidirectional Communication"
        ],
        "entity_type": "attack-pattern",
        "unique_id": "e78fd60f-3901-437f-8915-c9cbce690ef1",
        "name": "Bidirectional Communication",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "description": "Adversaries may use an existing, legitimate external Web service as a means for sending commands to and receiving output from a compromised system over the Web service channel. Compromised systems may leverage popular websites and social media to host command and control (C2) instructions. Those infected systems can then send the output from those commands back over that Web service channel. The return traffic may occur in a variety of ways, depending on the Web service being utilized. For example, the return traffic may take the form of the compromised system posting a comment on a forum, issuing a pull request to development project, updating a document hosted on a Web service, or by sending a Tweet. \n\nPopular websites and social media acting as a mechanism for C2 may give a significant amount of cover due to the likelihood that hosts within a network are already communicating with them prior to a compromise. Using common services, such as those offered by Google or Twitter, makes it easier for adversaries to hide in expected noise. Web service providers commonly use SSL/TLS encryption, giving adversaries an added level of protection.",
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows",
            "ESXi"
        ],
        "standard_attck_id": "T1481.002",
        "standard_attck_name": "Bidirectional Communication",
        "gid": 4134,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "polonium",
            "apt37",
            "muddywater",
            "fin7",
            "apt12",
            "zirconium",
            "kimsuky",
            "gamaredon group",
            "magic hound",
            "sandworm team",
            "turla",
            "hexane",
            "apt28",
            "lazarus group",
            "apt39",
            "carbanak"
        ],
        "uncertain_id": "t1102.002",
        "uncertain_name": "bidirectional communication",
        "uncertain_mes": "Adversaries may use an existing, legitimate external Web service as a means for sending commands to and receiving output from a compromised system over the Web service channel. Compromised systems may leverage popular websites and social media to host command and control (C2) instructions. Those infected systems can then send the output from those commands back over that Web service channel. The return traffic may occur in a variety of ways, depending on the Web service being utilized. For example, the return traffic may take the form of the compromised system posting a comment on a forum, issuing a pull request to development project, updating a document hosted on a Web service, or by sending a Tweet. \n\nPopular websites and social media acting as a mechanism for C2 may give a significant amount of cover due to the likelihood that hosts within a network are already communicating with them prior to a compromise. Using common services, such as those offered by Google or Twitter, makes it easier for adversaries to hide in expected noise. Web service providers commonly use SSL/TLS encryption, giving adversaries an added level of protection. ",
        "processed": true,
        "hsage": 10.512101505126843,
        "profile_without_enhance_5": "[profile]Bidirectional Communication is a command and control technique (T1102.002) used on Windows, Linux, macOS, and ESXi platforms. It involves using a legitimate external web service, such as social media or popular websites, to both send commands to a compromised system and receive command output back over the same channel. Return traffic can be disguised as forum comments, document updates, or social media posts, leveraging the service's normal SSL/TLS encryption for stealth. This method is employed by groups like APT28, Lazarus, and FIN7."
    },
    "20249": {
        "semantic": 1,
        "phase_names": [
            "defense-evasion"
        ],
        "entity_type": "attack-pattern",
        "aliases": [
            "Timestomp"
        ],
        "unique_id": "868a3e08-07a9-4bdd-bf20-d90b87a6a6fe",
        "name": "T1070.006",
        "description": "Adversaries may modify file time attributes to hide new files or changes to existing files. Timestomping is a technique that modifies the timestamps of a file (the modify, access, create, and change times), often to mimic files that are in the same folder and blend malicious files with legitimate files.\n\nIn Windows systems, both the `$STANDARD_INFORMATION` (`$SI`) and `$FILE_NAME` (`$FN`) attributes record times in a Master File Table (MFT) file.(Citation: Inversecos Timestomping 2022) `$SI` (dates/time stamps) is displayed to the end user, including in the File System view, while `$FN` is dealt with by the kernel.(Citation: Magnet Forensics)\n\nModifying the `$SI` attribute is the most common method of timestomping because it can be modified at the user level using API calls. `$FN` timestomping, however, typically requires interacting with the system kernel or moving or renaming a file.(Citation: Inversecos Timestomping 2022)\n\nAdversaries modify timestamps on files so that they do not appear conspicuous to forensic investigators or file analysis tools. In order to evade detections that rely on identifying discrepancies between the `$SI` and `$FN` attributes, adversaries may also engage in “double timestomping” by modifying times on both attributes simultaneously.(Citation: Double Timestomping)\n\nIn Linux systems and on ESXi servers, threat actors may attempt to perform timestomping using commands such as `touch -a -m -t <timestamp> <filename>` (which sets access and modification times to a specific value) or `touch -r <filename> <filename>` (which sets access and modification times to match those of another file).(Citation: Inversecos Linux Timestomping)(Citation: Juniper Networks ESXi Backdoor 2022)\n\nTimestomping may be used along with file name [Masquerading](https://attack.mitre.org/techniques/T1036) to hide malware and tools.(Citation: WindowsIR Anti-Forensic Techniques)",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows",
            "ESXi"
        ],
        "standard_attck_id": "T1070.006",
        "standard_attck_name": "Timestomp",
        "gid": 4135,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "chimera",
            "apt38",
            "kimsuky",
            "lazarus group",
            "apt5",
            "mustang panda",
            "apt32",
            "rocke",
            "apt28",
            "apt29",
            "unc3886"
        ],
        "uncertain_id": "t1070.006",
        "uncertain_name": "timestomp",
        "uncertain_mes": "Adversaries may modify file time attributes to hide new files or changes to existing files. Timestomping is a technique that modifies the timestamps of a file (the modify, access, create, and change times), often to mimic files that are in the same folder and blend malicious files with legitimate files.\n\nIn Windows systems, both the `$STANDARD_INFORMATION` (`$SI`) and `$FILE_NAME` (`$FN`) attributes record times in a Master File Table (MFT) file.(Citation: Inversecos Timestomping 2022) `$SI` (dates/time stamps) is displayed to the end user, including in the File System view, while `$FN` is dealt with by the kernel.(Citation: Magnet Forensics)\n\nModifying the `$SI` attribute is the most common method of timestomping because it can be modified at the user level using API calls. `$FN` timestomping, however, typically requires interacting with the system kernel or moving or renaming a file.(Citation: Inversecos Timestomping 2022)\n\nAdversaries modify timestamps on files so that they do not appear conspicuous to forensic investigators or file analysis tools. In order to evade detections that rely on identifying discrepancies between the `$SI` and `$FN` attributes, adversaries may also engage in “double timestomping” by modifying times on both attributes simultaneously.(Citation: Double Timestomping)\n\nIn Linux systems and on ESXi servers, threat actors may attempt to perform timestomping using commands such as `touch -a -m -t <timestamp> <filename>` (which sets access and modification times to a specific value) or `touch -r <filename> <filename>` (which sets access and modification times to match those of another file).(Citation: Inversecos Linux Timestomping)(Citation: Juniper Networks ESXi Backdoor 2022)\n\nTimestomping may be used along with file name [Masquerading](https://attack.mitre.org/techniques/T1036) to hide malware and tools.(Citation: WindowsIR Anti-Forensic Techniques)",
        "processed": true,
        "hsage": 12.351972093137636,
        "profile_without_enhance_5": "[profile]T1070.006, also known as Timestomp, is a Defense Evasion technique for macOS, Linux, Windows, and ESXi platforms. It involves modifying file timestamps to hide new or altered files. On Windows, adversaries typically alter the user-accessible `$STANDARD_INFORMATION` attribute via API calls, and may perform \"double timestomping\" by also modifying the kernel-level `$FILE_NAME` attribute to evade forensic detection. On Linux and ESXi, commands like `touch -a -m -t <timestamp> <filename>` are used to set specific access and modification times, often combined with Masquerading (T1036) to blend malicious files with legitimate ones. This technique is associated with groups like APT28, APT29, and Lazarus.[/profile]"
    },
    "20250": {
        "semantic": 1,
        "phase_names": [],
        "entity_type": "attack-pattern",
        "aliases": [
            "T1099"
        ],
        "unique_id": "df4183df-0f93-41f7-a5f8-65da7d43c8ab",
        "name": "Timestomp",
        "description": "Adversaries may take actions to hide the deployment of new, or modification of existing files to obfuscate their activities. Timestomping is a technique that modifies the timestamps of a file (the modify, access, create, and change times), often to mimic files that are in the same folder. This is done, for example, on files that have been modified or created by the adversary so that they do not appear conspicuous to forensic investigators or file analysis tools. Timestomping may be used along with file name [Masquerading](https://attack.mitre.org/techniques/T1036) to hide malware and tools. (Citation: WindowsIR Anti-Forensic Techniques)",
        "kill_chain_names": [],
        "x_mitre_description": "",
        "platforms": [],
        "standard_attck_id": "T1070.006",
        "standard_attck_name": "Timestomp",
        "gid": 4136,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "chimera",
            "apt38",
