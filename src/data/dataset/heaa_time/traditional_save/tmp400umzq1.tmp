    "17900": {
        "semantic": 1,
        "phase_names": [
            "credential-access",
            "defense-evasion",
            "persistence"
        ],
        "aliases": [
            "Modify Authentication Process"
        ],
        "entity_type": "attack-pattern",
        "unique_id": "1b4aa59b-f467-4e66-abc7-038962d5d172",
        "name": "Modify Authentication Process",
        "kill_chain_names": [
            "mitre-attack",
            "mitre-attack",
            "mitre-attack"
        ],
        "description": "Adversaries may modify authentication mechanisms and processes to access user credentials or enable otherwise unwarranted access to accounts. The authentication process is handled by mechanisms, such as the Local Security Authentication Server (LSASS) process and the Security Accounts Manager (SAM) on Windows, pluggable authentication modules (PAM) on Unix-based systems, and authorization plugins on MacOS systems, responsible for gathering, storing, and validating credentials. By modifying an authentication process, an adversary may be able to authenticate to a service or system without using [Valid Accounts](https://attack.mitre.org/techniques/T1078).\n\nAdversaries may maliciously modify a part of this process to either reveal credentials or bypass authentication mechanisms. Compromised credentials or access may be used to bypass access controls placed on various resources on systems within the network and may even be used for persistent access to remote systems and externally available services, such as VPNs, Outlook Web Access and remote desktop.",
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows",
            "Network Devices",
            "IaaS",
            "Office Suite",
            "Identity Provider",
            "SaaS"
        ],
        "standard_attck_id": "T1556",
        "standard_attck_name": "Modify Authentication Process",
        "gid": 1779,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "fin13"
        ],
        "uncertain_id": "t1556",
        "uncertain_name": "modify authentication process",
        "uncertain_mes": "Adversaries may modify authentication mechanisms and processes to access user credentials or enable otherwise unwarranted access to accounts. The authentication process is handled by mechanisms, such as the Local Security Authentication Server (LSASS) process and the Security Accounts Manager (SAM) on Windows, pluggable authentication modules (PAM) on Unix-based systems, and authorization plugins on MacOS systems, responsible for gathering, storing, and validating credentials. By modifying an authentication process, an adversary may be able to authenticate to a service or system without using [Valid Accounts](https://attack.mitre.org/techniques/T1078).\n\nAdversaries may maliciously modify a part of this process to either reveal credentials or bypass authentication mechanisms. Compromised credentials or access may be used to bypass access controls placed on various resources on systems within the network and may even be used for persistent access to remote systems and externally available services, such as VPNs, Outlook Web Access and remote desktop.",
        "processed": true,
        "hsage": 14.532019313730654,
        "profile_without_enhance_5": "[profile]Modify Authentication Process is a MITRE ATT&CK technique with ID T1556, falling under the Credential Access, Defense Evasion, and Persistence tactics. It is applicable across Windows, Linux, macOS, and network/IaaS/SaaS platforms. The technique involves adversaries maliciously altering core authentication components to bypass mechanisms or harvest credentials. Specific implementations include patching the LSASS process on Windows domain controllers to create a backdoor (like Skeleton Key malware) or modifying Pluggable Authentication Modules (PAM) like `pam_unix.so` on Unix-based systems to accept adversary-supplied credentials. This enables persistent, unauthorized access to accounts and network services such as VPNs."
    },
