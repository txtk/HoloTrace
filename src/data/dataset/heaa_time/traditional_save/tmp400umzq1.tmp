    "20696": {
        "semantic": 1,
        "unique_id": "c98c676b-afa5-4e7c-aaf8-fbe141e83bb3",
        "entity_type": "malware",
        "name": "Tickler",
        "is_family": false,
        "no_semantic_neighbors": [
            "fb70ff49411ce04951895977acfc06fa468e4aa504676dedeb40ba5cea76f37f",
            "7eb2e9e8cd450fc353323fd2e8b84fbbdfe061a8441fd71750250752c577d198",
            "711d3deccc22f5acfd3a41b8c8defb111db0f2b474febdc7f20a468f67db0350",
            "dad53a78662707d182cdb230e999ef6effc0b259def31c196c51cc3e8c42a9b8",
            "ccb617cc7418a3b22179e00d21db26754666979b4c4f34c7fda8c0082d08cec4",
            "5df4269998ed79fbc997766303759768ce89ff1412550b35ff32e85db3c1f57b",
            "22017c9b022e6f2560fee7d544a83ea9e3d85abee367f2f20b3b0448691fe2d4",
            "56ac00856b19b41bc388ecf749eb4651369e7ced0529e9bf422284070de457b6",
            "e984d9085ae1b1b0849199d883d05efbccc92242b1546aeca8afd4b1868c54f5"
        ],
        "processed": true,
        "hsage": 5.683034923026346,
        "profile_without_enhance_5": "[profile]Tickler, also known as Cannon, is a malware attributed to APT28. It employs the T1102.003 (One-Way Communication) command-and-control technique, using external web services to send commands. For persistence, it utilizes Boot or Logon Autostart Execution (T1547) by creating a Windows Registry Run key. Its credential access capabilities include stealing the NTDS.dit file (T1003.003) and performing password spraying (T1110.003). It also leverages compromised cloud accounts (T1078.004) for access and evasion. This malware primarily targets Windows systems and has been observed in operations affecting Australia, the United Arab Emirates, and the United States.[/profile]"
    },
