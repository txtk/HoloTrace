    "20362": {
        "semantic": 1,
        "unique_id": "9b2cd372-bce9-4c32-8365-a81044b56e1c",
        "entity_type": "malware",
        "name": "LOSTKEYS",
        "is_family": false,
        "no_semantic_neighbors": [
            "b55cdce773bc77ee46b503dbd9430828cc0f518b94289fbfa70b5fbb02ab1847",
            "8af28bb7e8e2f663d4b797bf3ddbee7f0a33f637a33df9b31fbb4c1ce71b2fee",
            "4c7accba35edd646584bb5a40ab78f963de45e5fc816e62022cd7ab1b01dae9c",
            "3233668d2e4a80b17e6357177b53539df659e55e06ba49777d0d5171f27565dd",
            "6bc411d562456079a8f1e38f3473c33ade73b08c7518861699e9863540b64f9a",
            "6b85d707c23d68f9518e757cc97adb20adc8accb33d0d68faf1d8d56d7840816",
            "13f7599c94b9d4b028ce02397717a1282a46f07b9d3e2f8f2b3213fa8884b029",
            "02ce477a07681ee1671c7164c9cc847b01c2e1cd50e709f7e861eaab89c69b6f",
            "28a0596b9c62b7b7aca9cac2a07b067109f27d327581a60e8cb4fab92f8f4fa9"
        ],
        "processed": true,
        "hsage": 5.6688625443446865,
        "profile_without_enhance_5": "[profile]LOSTKEYS is a malware deployed by the Callisto group, which uses phishing (T1566) and user execution (T1204) for initial access. It conducts software discovery (T1518) and employs web services (T1102) and application layer protocols (T1071) like HTTP for command and control, utilizing domains such as njala.dev and cloudmediaportal.com. It primarily targets systems in Ukraine. YESROBOT was subsequently deployed as a stopgap mechanism following public reporting on LOSTKEYS.[/profile]"
    },
