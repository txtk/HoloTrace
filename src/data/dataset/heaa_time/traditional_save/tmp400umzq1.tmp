    "16451": {
        "semantic": 1,
        "unique_id": "f0c0b331-b72c-4071-97cd-c1ada6942983",
        "entity_type": "malware",
        "name": "XenoRAT",
        "is_family": false,
        "no_semantic_neighbors": [
            "d35b01fed4a359f81bd4e866d080e9b9a2462fb2997a24d088cbce7d9bb28efe",
            "a987762487db0d1535973e66f399f9b326effa2813178b9353188113caa416a6",
            "af182a9a50d79ec77d78a5896b7aa51d6ff8ac81d2401b67eca5362d0b6c42b7",
            "3f816153a7a468406ebcd3b8e0686633047c4682f6d9266598eba4092e127f36",
            "457fc3e0f47fa85e6df3fd4a94e988cf9e18e23cc7e3733c7d2723331a076354"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "xenorat",
        "uncertain_mes": "Xeno Rat is a remote access tool (RAT) that is used to control a computer remotely. It is written in C# and is compatible with Windows 10, 11. It is meant to stable, completely open source, easy to use and has a lot of features.\nXeno Rat stands out from the crowd for several reasons:\n-",
        "processed": true,
        "hsage": 7.699500340161678,
        "profile_without_enhance_5": "[profile]XenoRAT is a remote access tool (RAT) written in C# and compatible with Windows 10 and 11. Its key technical behaviors include exfiltrating data to cloud storage (T1567.002), collecting clipboard data (T1115), and using symmetric cryptography (T1573.001) and data encoding (T1132) for command-and-control obfuscation. It has been delivered in malicious documents, such as 'krumhan.rtf' and 'bobokan.rtf', and in a file named 'Urgent Letter from the Ambassador Embassy of Poland.zip'."
    },
