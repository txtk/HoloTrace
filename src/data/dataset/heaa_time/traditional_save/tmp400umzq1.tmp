    "20411": {
        "semantic": 1,
        "unique_id": "f53e43ec-3ad2-48cc-8a15-908c0b11e816",
        "entity_type": "malware",
        "name": "DevilsTongue",
        "is_family": false,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "caramel tsunami"
        ],
        "uncertain_name": "devilstongue",
        "uncertain_mes": "The Microsoft Threat Intelligence Center (MSTIC) alongside the Microsoft Security Response Center (MSRC) has uncovered a private-sector offensive actor, or PSOA, that we are calling SOURGUM in possession of now-patched, Windows 0-day exploits (CVE-2021-31979 and CVE-2021-33771).",
        "processed": true,
        "hsage": 13.490443560134242,
        "profile_without_enhance_5": "[profile]DevilsTongue, also known as devilstongue, is attributed to the private-sector offensive actor (PSOA) SOURGUM, also known as caramel tsunami. Its key technical behaviors include searching the call stack to find the return address of LoadLibraryExW to locate its own DLL base address, audio capture (T1123), subverting trust controls (T1553), gathering victim host information, capturing clipboard data (T1115), and capturing user input (T1056). It targets Windows platforms and has exploited vulnerability CVE-2022-2294, with associated infrastructure including domains like expertglobal.org, only-music.net, core-update.com, querylight.net, and smartstand.org, and has been deployed against entities in Turkey, Armenia, Palestine, Azerbaijan, and Uzbekistan.[/profile]"
    },
    "20412": {
        "semantic": 1,
        "unique_id": "fb9d0f5a-4271-4b25-b33b-4c4dd2927c57",
