    "20188": {
        "semantic": 1,
        "unique_id": "59d6a7f0-0f1f-4375-91c9-bdd05b952993",
        "entity_type": "malware",
        "name": "KoSpy",
        "is_family": false,
        "no_semantic_neighbors": [
            "0329be10a5be4350e0d2c15ed265f0f32557d869ce32566a248d4ed3f9a20c16",
            "0374615eeca4eaa4a9d97c0de82b7e36b0c60cd40332b61c86fa0b29f7712115",
            "d937ea795b97a6f6b99dad10b31557c54d91e95f13c851371796ff06ec65dda9",
            "da56b0416b205b36337af22738967445ff310ca0f6051b243f00b83baa67aa09",
            "b0c0f38551a119d0b633c1b65e61b493574ed7083e3e003c83aa19dff7a0524b",
            "3ca78cecb854ac65760f875c726a062c3dbfd9570adbaed473125c5c61c2ab21",
            "f1b33341b0dc25c84b92e6b3bc62125a216d62e746d06560a28f68deead406b9"
        ],
        "processed": true,
        "hsage": 5.634209305877323,
        "profile_without_enhance_5": "[profile]KoSpy, also known as AppleJeus, is attributed to the Lazarus Group and uses command-and-control infrastructure including domains like nidlogon.com, st0746.net, crowdon.info, resolveissue.org, and naverfiles.com. It establishes persistence by abusing software extensions (MITRE ATT&CK T1176) to execute arbitrary code and exfiltrate data, and it targets cryptocurrency platforms and services such as ads.google.com, binance.com, coinomi.co.nl, korbit.co.kr, and paypal.com."
    },
    "20189": {
        "semantic": 1,
        "unique_id": "fde7a1a7-05d2-4228-93e2-857a30bb0959",
        "entity_type": "malware",
        "name": "KONNI - S0356",
        "is_family": false,
        "no_semantic_neighbors": [
            "b0c0f38551a119d0b633c1b65e61b493574ed7083e3e003c83aa19dff7a0524b",
            "3ca78cecb854ac65760f875c726a062c3dbfd9570adbaed473125c5c61c2ab21",
            "da56b0416b205b36337af22738967445ff310ca0f6051b243f00b83baa67aa09",
            "f1b33341b0dc25c84b92e6b3bc62125a216d62e746d06560a28f68deead406b9",
            "0374615eeca4eaa4a9d97c0de82b7e36b0c60cd40332b61c86fa0b29f7712115",
            "0329be10a5be4350e0d2c15ed265f0f32557d869ce32566a248d4ed3f9a20c16",
            "d937ea795b97a6f6b99dad10b31557c54d91e95f13c851371796ff06ec65dda9"
        ],
        "uncertain_related_groups": [
            "apt37"
        ],
        "uncertain_name": "konni",
        "uncertain_mes": "After publishing our initial series of blogposts back in 2016, we have continued to track the ScarCruft threat actor. ScarCruft is a Korean-speaking and allegedly state-sponsored threat actor that usually targets organizations and companies with links to the Korean peninsula. The threat actor is highly skilled and, by all appearances, quite resourceful.",
        "processed": true,
        "hsage": 13.3340617036954,
        "profile_without_enhance_5": "[profile]KONNI - S0356, also known as konni, is a remote access tool (RAT) used by North Korean cyber actors, with potential links to APT37. It exhibits significant code overlap with the NOKKI malware family. Key technical behaviors include abusing browser extensions (T1176) for persistence and data exfiltration. Its command and control infrastructure has been associated with domains such as st0746.net, mailcorp.center, nidlogon.com, resolveissue.org, and naverfiles.com, and it shares infrastructure overlap with the CARROTBAT dropper. The malware primarily targets Windows systems and has been used in campaigns against political organizations in Russia, East Asia, Europe, and the Middle East."
    },
