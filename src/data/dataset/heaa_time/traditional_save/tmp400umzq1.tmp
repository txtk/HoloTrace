        "name": "REMCOS RAT",
        "is_family": false,
        "no_semantic_neighbors": [
            "77383eb5e1e6e0c4049ddcc359122adc39c13e5918c205ad71062bb441928f9b",
            "9b0d0284c48659a7d81399fc9e9174ba373363116e66a21ecf84246fa2591b8b",
            "6587de22729bf3dd6f3632d67881fbc75275b9fd6d88597c7f04462ec1b2bcdf",
            "b1d2f8d627af261a1556ba289a6d171e9eda3b9d9d28e330262dd9559e5a1da1",
            "75fed14fd61067a1c0c2a10d0eefcc349308e1f4a1993a075a9f0c768affab13",
            "613fb5ffbce15d7c71a019dd0f80256b2d05772e4f62c2fbf7c74164f1227755",
            "35c7eb685fa4b03fd1e852c936768f003f8284ca96b1e1c73082053cd41fe63a",
            "96791e52274fcb59709e8e705469934ea0feba59e96e6a60526fbd0da8bcebc3",
            "2cedf60566ee524440c85a8779d5e12a203d1dff140f4c3d32374b7eab547ef6",
            "5433726d3912a95552d16b72366eae777f5f34587e1bdaa0c518c5fcbc3d8506",
            "f28ffdb035e739806d6c9bfc9ef2cd86f7fac2656018c8d0f2706647bcf5332f",
            "35612c79bde985c957ba521bbc7aa8541c31fb235ca7a91d0ee225f988921eb4",
            "d31cf64cee89b83bf36a52cd28408ce4d2e9e584f66e2c397e8578cb01ecf2eb",
            "7a413732944fe4101f589e9ae49cd1b48c42c1287606b6badf4ce582cd8dedb5"
        ],
        "uncertain_related_groups": [
            "apt33",
            "the gorgon group",
            "uac-0050"
        ],
        "uncertain_name": "remcos",
        "uncertain_mes": "Over the past year, the Cybereason Nocturnus Team has observed various trends among cyber criminals and nation-state groups leveraging various global events such as COVID-19 and other topical themes and trending issues as phishing content to lure their victims into installing their malware of choice.",
        "processed": true,
        "hsage": 12.383670607279349,
        "profile_without_enhance_5": "[profile]REMCOS RAT, also known as Remcos, is a remote access tool (RAT) malware sold commercially and updated regularly. It is associated with groups including APT33, The Gorgon Group, and UAC-0050. Its key behaviors include using boot or logon autostart execution (T1547) for persistence, employing data obfuscation (T1001) and traffic signaling (T1205) for command and control, and staging capabilities (T1608) on infrastructure like Virtual Private Servers (VPS). It primarily targets Windows systems and has been distributed via spam emails and domains such as servicioseguroenlineabb.com and elyeso.ip-ddns.com.[profile]"
    },
