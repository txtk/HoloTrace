    "20449": {
        "created_time": "2025-08-14T07:31:35.614Z",
        "semantic": 1,
        "aka_name": [],
        "entity_type": "intrusion-set",
        "unique_id": "cd27b517-2448-4d9f-8a34-36a003cb4ba6",
        "modified_time": "2025-08-14T19:16:44.579Z",
        "group_name": "UTA0178",
        "name": "unkown_apt_group",
        "description": "",
        "no_semantic_neighbors": [
            "b422645db18e95aa0b4daaf5277417b73322bed306f42385ecfd6d49be26bfab",
            "f34db4ea8ec3c2cbe53fde3d73229ccaa2a9e7168cd96d9a49bf89adef5ab47c",
            "42692bd13333623e9085d0c1326574a3391efcbf18158bb04972103c9ee4a3b8",
            "b42159d68ba58d7857c091b5acc59e30e50a854b15f7ce04b61ff6c11cdf0156",
            "29ae4fa86329bf6d0955020319b618d4c183d433830187b80979d392bf159768",
            "44c4a0d1826369993d1a2c4fcc00a86bf45723342cfd9f3a8b44b673eee6733a",
            "7a4e0eb5fbab9709c8f42beb322a5dfefbc4ec5f914938a8862f8e26a31d30a5",
            "f48857263991eea1880de0f62b3d1d37101c2e7739dcd8629b24260d08850f9c",
            "64764ffe4b1e4fc5b9fe27b513e02f0392f659c4e033d23a4ba7a3b7f20c6d30",
            "1dd64c00f061425d484dd67b359ad99df533aa430632c55fa7e7617b55dab6a8",
            "b1221000f43734436ec8022caaa34b133f4581ca3ae8eccd8d57ea62573f301d",
            "150ccd3b24a1b40630e46300100a3f810aa7a6badeb6806b59ed6ba7bafb7b21"
        ],
        "processed": true,
        "hsage": 0.0,
        "profile_without_enhance_5": "[profile]This intrusion set, likely tracked as UNC5174 or associated with a China-nexus APT, is also known as BackdoorDiplomacy, BackDip, Quarian, and CloudComputating. Its key malware includes KrustyLoader and Auto-Color, which are Rust-based and Linux-focused backdoors exploiting vulnerabilities like CVE-2025-31324, CVE-2025-4427, and CVE-2025-4428. Its TTPs involve Dynamic Linker Hijacking for persistence, Scheduled Transfer for data exfiltration, and Data from Information Repositories for collection. The group is attributed to a China-nexus actor and has targeted sectors in Japan, with motivations focused on espionage, using infrastructure such as dnstunnel.run and ns1.cybertunnel.run.[/profile]"
    },
