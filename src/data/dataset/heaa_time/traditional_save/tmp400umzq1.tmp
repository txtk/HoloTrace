    "20446": {
        "semantic": 1,
        "unique_id": "a3efc0b8-f4b2-4f9e-aa68-954278414636",
        "entity_type": "malware",
        "name": "KrustyLoader",
        "is_family": false,
        "no_semantic_neighbors": [
            "150ccd3b24a1b40630e46300100a3f810aa7a6badeb6806b59ed6ba7bafb7b21",
            "b422645db18e95aa0b4daaf5277417b73322bed306f42385ecfd6d49be26bfab",
            "f34db4ea8ec3c2cbe53fde3d73229ccaa2a9e7168cd96d9a49bf89adef5ab47c",
            "29ae4fa86329bf6d0955020319b618d4c183d433830187b80979d392bf159768",
            "44c4a0d1826369993d1a2c4fcc00a86bf45723342cfd9f3a8b44b673eee6733a",
            "7a4e0eb5fbab9709c8f42beb322a5dfefbc4ec5f914938a8862f8e26a31d30a5",
            "64764ffe4b1e4fc5b9fe27b513e02f0392f659c4e033d23a4ba7a3b7f20c6d30"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "krustyloader",
        "uncertain_mes": "EclecticIQ analysts assess with high confidence that, in April 2025, China-nexus nation-state APTs (advanced persistent threat) launched high-temp exploitation campaigns against critical infrastructure networks by targeting SAP NetWeaver Visual Composer. Actors leveraged CVE-2025-31324 [1], an unauthenticated file upload vulnerability that enables remote code execution (RCE).",
        "processed": true,
        "hsage": 13.397830218911377,
        "profile_without_enhance_5": "[profile]KrustyLoader, also known as krustyloader, is a Rust-based malware linked to UNC5174 and potentially China-nexus APTs. Its key behaviors include exploiting vulnerabilities like CVE-2025-31324 for initial access, abusing Unix Shell for execution, and performing Account Discovery and Credentials In Files for credential access. It targets platforms including Linux and network devices, using infrastructure such as dnstunnel.run and ns1.cybertunnel.run for command and control.[/profile]"
    },
    "20447": {
        "semantic": 1,
        "unique_id": "7828d5ac-d027-4be7-ab2a-e813d2b534ba",
        "entity_type": "malware",
        "name": "Auto-Color",
        "is_family": false,
        "no_semantic_neighbors": [
            "29ae4fa86329bf6d0955020319b618d4c183d433830187b80979d392bf159768",
            "7a4e0eb5fbab9709c8f42beb322a5dfefbc4ec5f914938a8862f8e26a31d30a5",
            "44c4a0d1826369993d1a2c4fcc00a86bf45723342cfd9f3a8b44b673eee6733a",
            "64764ffe4b1e4fc5b9fe27b513e02f0392f659c4e033d23a4ba7a3b7f20c6d30",
            "150ccd3b24a1b40630e46300100a3f810aa7a6badeb6806b59ed6ba7bafb7b21",
            "b422645db18e95aa0b4daaf5277417b73322bed306f42385ecfd6d49be26bfab",
            "f34db4ea8ec3c2cbe53fde3d73229ccaa2a9e7168cd96d9a49bf89adef5ab47c"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "auto-color",
        "uncertain_mes": "Auto-color - Linux backdoor\nMeet Auto-colorPermalink",
        "processed": true,
        "hsage": 13.397830218911377,
        "profile_without_enhance_5": "[profile]Auto-Color is a Linux backdoor malware that uses an embedded custom encrypted configuration within its .data section. Its Tactics, Techniques, and Procedures (TTPs) include Data from Information Repositories (T1213) to gather sensitive data, Account Manipulation (T1098) for persistence, Credentials In Files (T1552.001) to search for stored secrets, Account Discovery (T1087) to enumerate user accounts, and Unix Shell (T1059.004) for command execution. It has been associated with indicators like the domains dnstunnel.run and ns1.cybertunnel.run and has been linked to exploitation of vulnerabilities including CVE-2025-4427, CVE-2025-31324, CVE-2025-4428, and CVE-2025-22457.[/profile]"
    },
