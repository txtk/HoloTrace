    "22295": {
        "semantic": 1,
        "unique_id": "9ce338d3-d429-4920-90df-842571019483",
        "entity_type": "malware",
        "name": "ROAMINGMOUSE",
        "is_family": false,
        "no_semantic_neighbors": [],
        "processed": true,
        "hsage": 5.677522000996168,
        "profile_without_enhance_5": "[profile]ROAMINGMOUSE is a malware entity. Its technical behaviors include using the Compile After Delivery technique (T1027.004) to evade detection by delivering source code for on-victim compilation, and employing Bypass User Account Control (T1548.002) for privilege escalation on Windows systems. It has been associated with the indicator Trojan_ANELLDR_type1 and has been observed targeting systems in Japan.[/profile]"
    },
    "22296": {
        "semantic": 1,
        "unique_id": "11e3e00f-14a1-4b33-aa1e-3153cb213cde",
        "entity_type": "malware",
        "name": "ANELLDR",
        "is_family": false,
        "no_semantic_neighbors": [],
        "processed": true,
        "hsage": 5.671290366688813,
        "profile_without_enhance_5": "[profile]ANELLDR is a malware entity, not a family, with an indicator named Trojan_ANELLDR_type1. Its known TTPs include Obfuscated Files or Information: Compile After Delivery (T1027.004), abuse of Software Deployment Tools (T1072), Access Token Manipulation (T1134), Bypass User Account Control (T1548.002), and User Execution (T1204). It has been observed targeting systems in Japan.[/profile]"
    },
    "22297": {
        "semantic": 1,
        "unique_id": "8f4e7032-79fc-4ac6-b509-dbb7df410c1c",
        "entity_type": "malware",
        "name": "NOOPDOOR",
        "is_family": false,
        "no_semantic_neighbors": [
            "93af6afb47f4c42bc0da3eedc6ecb9054134f4a47ef0add0d285404984011072"
        ],
        "processed": true,
        "hsage": 5.726581991140095,
        "profile_without_enhance_5": "[profile]NOOPDOOR is a malware targeting Japan, utilizing domains like inbullar.com, torefrog.com, ocouomors.com, foeake.org, and paunsonaz.com for its infrastructure. Its technical behaviors involve Defense Evasion techniques such as Compile After Delivery to subvert binary-based protections, Bypass User Account Control to elevate privileges on Windows, and Access Token Manipulation to operate under stolen security contexts. It also employs Software Deployment Tools for lateral movement and T1562 (Impair Defenses) to disable security mechanisms.[/profile]"
    },
