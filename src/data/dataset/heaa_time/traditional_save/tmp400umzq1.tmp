        "entity_type": "malware",
        "name": "SandStrike",
        "is_family": false,
        "no_semantic_neighbors": [
            "aa656a243d2008327e06fd5bbad919eea99aa271132dbaeabb146e22effbfd1b",
            "3a052d56706a67f918ed3a9acec9a2da428a20065e261d8e40b73badb4c9d7f4",
            "162ce2ad2611626988c8520366f1f76feca2c75505a3686c955ecc25f4946442",
            "79.132.128.81",
            "n14mit69company.top",
            "46.30.188.243",
            "422819e7f665ae0d411cf2a877a2f7b6721abb8df44df852d2d0e76eb74331b7",
            "55e8b2d87f80ba609dcf793afc50f66e5967e40dbf54229a256709fa348f3351",
            "a4913f52bd90add74b796852e2a1d9acb1d6ecffe359b5710c59c82af59483ec"
        ],
        "processed": true,
        "hsage": 5.707436851927169,
        "profile_without_enhance_5": "[profile]SandStrike is a malware entity. It has been linked to infrastructure including IP addresses 194.26.213.176 and 46.30.188.243 hosting a file 'mcrypt.php', and C2 servers at hs1.iphide.net and hs2.iphide.net on port 751. It is associated with the exploitation of vulnerability CVE-2025-4609 and has been observed targeting locations including Iran, Israel, and the United States. Its operational TTPs involve resource development techniques such as establishing social media and email accounts (T1585, T1585.001, T1586.002), staging capabilities (T1608), and searching open technical databases (T1596) for reconnaissance.[/profile]"
    },
