    "24243": {
        "semantic": 1,
        "unique_id": "b9c0c48e-891b-47bd-8119-8b1193447266",
        "entity_type": "malware",
        "name": "ScatterBrain",
        "is_family": false,
        "no_semantic_neighbors": [
            "d484b9b8c44558c18ef6147c6ca8276a462fccf2acb2863be4ee9bf37942f11e",
            "60678e352f3c849e36413f5de51b5eeca1180840c818f9ece0a0da803eb205a5"
        ],
        "processed": true,
        "hsage": 5.703970805938187,
        "profile_without_enhance_5": "[profile]ScatterBrain is a malware entity that is not classified as a family. It is used to obfuscate ShadowPad malware samples, with this activity observed since 2022 and attributed to clusters associated with the suspected Chinese APT umbrella actor APT41. Its technical behaviors involve obfuscation techniques, and it is associated with the attack patterns of modifying authentication processes (T1556), compromising host software binaries, removing indicators from tools (T1027.005), and stealing or forging Kerberos tickets (T1558), including the specific Golden Ticket technique for credential access on Windows platforms.[/profile]"
    },
