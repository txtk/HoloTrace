    "20113": {
        "semantic": 1,
        "unique_id": "8481e5ae-8fda-40f0-8d51-3d889e98bf6d",
        "entity_type": "malware",
        "name": "Konni RAT",
        "is_family": false,
        "no_semantic_neighbors": [
            "ee8e8471fbe1b7fc85508e549444893bdea7579c5032c2626abcb1356129787e",
            "f1b4eb84e77e39803a0463b49b66600adb19347512354d0481568a8411b75b24",
            "a19b9eb292395e0d84c4a1a8eb5c88abbe0f71060cd06a436bf79da914e3e0c1",
            "a8b0f9717bc16d48e55be95886500179ca4b7dad9610dd0865dbf8849901a791",
            "c348e945e1f6123bd054277d16a39da715deed8f5a6849bc70a57913b877e2ba",
            "e3c3981f65663c9923da9ca28c20951543ae3796bd39f86964769490b01c2bd7",
            "b81513f0f8d3db382bb8f931bf2b7a0d4f26f74cfcf60b5d889de87ef2f1d543",
            "474978a976de1c869385d37ae422b1718918bc8cc05353a4bebb2b75846ab74c",
            "61ce43ea1c2ddafb23ee8ee083417fd375bbefce200f9bb48166af7c67df4d3c",
            "4c53e24db4b7858fd9d17de2bfc3d73096f41172dfcc31a807231acb97aff9d0",
            "76ee4da0af1921b820cc0913b4011bb5382edac958eb2592ee1c3a00a41c2041"
        ],
        "uncertain_related_groups": [
            "apt37"
        ],
        "uncertain_name": "konni",
        "uncertain_mes": "After publishing our initial series of blogposts back in 2016, we have continued to track the ScarCruft threat actor. ScarCruft is a Korean-speaking and allegedly state-sponsored threat actor that usually targets organizations and companies with links to the Korean peninsula. The threat actor is highly skilled and, by all appearances, quite resourceful.",
        "processed": true,
        "hsage": 13.3713999614393,
        "profile_without_enhance_5": "[profile]Konni RAT is a remote access trojan (RAT) attributed to North Korean threat actors, including APT37 (ScarCruft). It is distributed via phishing emails and weaponized documents. Its key technical behaviors include establishing persistence through Boot or Logon Autostart Execution (T1547) via Windows Registry keys, performing OS Credential Dumping (T1003), and using Exploitation for Privilege Escalation (T1068). It targets Windows systems to gather information, capture screenshots, steal files, and provide a remote shell. Associated infrastructure includes domains like www.roofcolor.com and www.acschoolcatering.com.[/profile]"
    },
