    "16479": {
        "semantic": 1,
        "unique_id": "a50ebbf0-52e7-43c3-87a4-4f609286f111",
        "entity_type": "malware",
        "name": "SnakeKeylogger",
        "is_family": false,
        "no_semantic_neighbors": [
            "b1f9b450b97320de54f2450ace151b4f16444dc871f5e89487d52d862ce13cc2",
            "28f2fcece68822c38e72310c911ef007f8bd8fd711f2080844f666b7f371e9e1",
            "f73164bd4d2a475f79fb7d0806cfc3ddb510015f9161e7dce537d90956c11393"
        ],
        "processed": true,
        "hsage": 5.663260305288351,
        "profile_without_enhance_5": "[profile]SnakeKeylogger, also known as 404 keylogger, is a keylogger malware. Its key technical behaviors include using Boot or Logon Autostart Execution for persistence, performing Input Capture: Keylogging to steal credentials, and extracting Credentials from Web Browsers. It exfiltrates stolen data over its Command and Control channel, potentially to a Telegram bot, and may use Visual Basic for execution. It targets Windows systems and has been associated with infrastructure like the domain srvdown.ddns.net.[/profile]"
    },
