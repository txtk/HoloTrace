    },
    "20401": {
        "semantic": 0,
        "unique_id": "ae98d1a4-702b-4efc-8e45-a93ab343165f",
        "entity_type": "indicator",
        "valid_until": "2024-10-08T20:53:24.000Z",
        "name": "c042ad2947caf4449295a51f9d640d722b5a6ec6957523ebf68cddb87ef3545c",
