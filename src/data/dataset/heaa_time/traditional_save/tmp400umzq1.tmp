            "blacktech",
            "dragonfly",
            "transparent tribe",
            "exotic lily",
            "apt41",
            "threat group-3390",
            "darkhotel",
            "ta459",
            "apt29",
            "unc3886",
            "muddywater",
            "apt12",
            "the white company",
            "apt3",
            "leviathan",
            "inception",
            "apt32",
            "sandworm team",
            "bronze butler",
            "confucius",
            "lazarus group",
            "saint bear",
            "admin@338",
            "elderwood",
            "ember bear",
            "oilrig",
            "bitter",
            "sea turtle",
            "tropic trooper",
