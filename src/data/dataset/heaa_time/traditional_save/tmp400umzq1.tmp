    "17917": {
        "semantic": 1,
        "phase_names": [
            "exfiltration"
        ],
        "aliases": [
            "Exfiltration Over Web Service"
        ],
        "entity_type": "attack-pattern",
        "unique_id": "f9e624fe-e1b5-494d-b5be-8db453acc75a",
        "name": "Exfiltration Over Web Service",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "description": "Adversaries may use an existing, legitimate external Web service to exfiltrate data rather than their primary command and control channel. Popular Web services acting as an exfiltration mechanism may give a significant amount of cover due to the likelihood that hosts within a network are already communicating with them prior to compromise. Firewall rules may also already exist to permit traffic to these services.\n\nWeb service providers also commonly use SSL/TLS encryption, giving adversaries an added level of protection.",
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows",
            "ESXi",
            "Office Suite",
            "SaaS"
        ],
        "standard_attck_id": "T1567",
        "standard_attck_name": "Exfiltration Over Web Service",
        "gid": 1796,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "contagious interview",
            "blackbyte",
            "magic hound",
            "apt28"
        ],
        "uncertain_id": "t1567",
        "uncertain_name": "exfiltration over web service",
        "uncertain_mes": "Adversaries may use an existing, legitimate external Web service to exfiltrate data rather than their primary command and control channel. Popular Web services acting as an exfiltration mechanism may give a significant amount of cover due to the likelihood that hosts within a network are already communicating with them prior to compromise. Firewall rules may also already exist to permit traffic to these services.\n\nWeb service providers also commonly use SSL/TLS encryption, giving adversaries an added level of protection.",
        "processed": true,
        "hsage": 10.868423461815631,
        "profile_without_enhance_5": "[profile]Exfiltration Over Web Service is MITRE ATT&CK technique T1567 under the Exfiltration tactic, targeting platforms including Windows, Linux, and macOS. It involves adversaries using legitimate external web services like cloud storage or social media to covertly transfer stolen data, leveraging existing SSL/TLS encrypted connections and common firewall rules for cover. Groups such as APT28 and BlackByte have employed this method."
    },
    "17918": {
        "semantic": 1,
        "phase_names": [
            "resource-development"
        ],
        "entity_type": "attack-pattern",
        "aliases": [
            "Acquire Infrastructure"
        ],
        "unique_id": "7f2cd0bf-fdcd-45da-8345-5cfed58b1178",
        "name": "T1583",
        "description": "Adversaries may buy, lease, rent, or obtain infrastructure that can be used during targeting. A wide variety of infrastructure exists for hosting and orchestrating adversary operations. Infrastructure solutions include physical or cloud servers, domains, and third-party web services.(Citation: TrendmicroHideoutsLease) Some infrastructure providers offer free trial periods, enabling infrastructure acquisition at limited to no cost.(Citation: Free Trial PurpleUrchin) Additionally, botnets are available for rent or purchase.\n\nUse of these infrastructure solutions allows adversaries to stage, launch, and execute operations. Solutions may help adversary operations blend in with traffic that is seen as normal, such as contacting third-party web services or acquiring infrastructure to support [Proxy](https://attack.mitre.org/techniques/T1090), including from residential proxy services.(Citation: amnesty_nso_pegasus)(Citation: FBI Proxies Credential Stuffing)(Citation: Mandiant APT29 Microsoft 365 2022) Depending on the implementation, adversaries may use infrastructure that makes it difficult to physically tie back to them as well as utilize infrastructure that can be rapidly provisioned, modified, and shut down.",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "x_mitre_description": "",
        "platforms": [
            "PRE"
        ],
        "standard_attck_id": "T1583",
        "standard_attck_name": "Acquire Infrastructure",
        "gid": 1797,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "sea turtle",
            "kimsuky",
            "contagious interview",
            "star blizzard",
            "indrik spider",
            "agrius",
            "sandworm team",
            "ember bear"
        ],
        "uncertain_id": "t1583",
        "uncertain_name": "acquire infrastructure",
        "uncertain_mes": "Adversaries may buy, lease, rent, or obtain infrastructure that can be used during targeting. A wide variety of infrastructure exists for hosting and orchestrating adversary operations. Infrastructure solutions include physical or cloud servers, domains, and third-party web services.(Citation: TrendmicroHideoutsLease) Some infrastructure providers offer free trial periods, enabling infrastructure acquisition at limited to no cost.(Citation: Free Trial PurpleUrchin) Additionally, botnets are available for rent or purchase.\n\nUse of these infrastructure solutions allows adversaries to stage, launch, and execute operations. Solutions may help adversary operations blend in with traffic that is seen as normal, such as contacting third-party web services or acquiring infrastructure to support [Proxy](https://attack.mitre.org/techniques/T1090), including from residential proxy services.(Citation: amnesty_nso_pegasus)(Citation: FBI Proxies Credential Stuffing)(Citation: Mandiant APT29 Microsoft 365 2022) Depending on the implementation, adversaries may use infrastructure that makes it difficult to physically tie back to them as well as utilize infrastructure that can be rapidly provisioned, modified, and shut down.",
        "processed": true,
        "hsage": 11.58579728426216,
        "profile_without_enhance_5": "[profile]T1583, Acquire Infrastructure, is a Resource Development technique within the MITRE ATT&CK framework, applicable to the PRE platform. Adversaries obtain infrastructure such as physical or cloud servers, domains, and third-party web services by buying, leasing, renting, or compromising servers. This infrastructure supports staging and launching operations, including for proxy services, and can leverage free trials or rented botnets to blend in with normal traffic and obscure attribution.[/profile]"
    },
