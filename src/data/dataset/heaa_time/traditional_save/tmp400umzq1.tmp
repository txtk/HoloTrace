    "16422": {
        "semantic": 1,
        "phase_names": [
            "defense-evasion"
        ],
        "entity_type": "attack-pattern",
        "aliases": [
            "System Binary Proxy Execution"
        ],
        "unique_id": "182189dc-1e91-4c46-8e07-7cb052341fcf",
        "name": "T1218",
        "description": "Adversaries may bypass process and/or signature-based defenses by proxying execution of malicious content with signed, or otherwise trusted, binaries. Binaries used in this technique are often Microsoft-signed files, indicating that they have been either downloaded from Microsoft or are already native in the operating system.(Citation: LOLBAS Project) Binaries signed with trusted digital certificates can typically execute on Windows systems protected by digital signature validation. Several Microsoft signed binaries that are default on Windows installations can be used to proxy execution of other files or commands.\n\nSimilarly, on Linux systems adversaries may abuse trusted binaries such as `split` to proxy execution of malicious commands.(Citation: split man page)(Citation: GTFO split)",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows"
        ],
        "standard_attck_id": "T1218",
        "standard_attck_name": "System Binary Proxy Execution",
        "gid": 298,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "lazarus group",
            "volt typhoon"
        ],
        "uncertain_id": "t1218",
        "uncertain_name": "system binary proxy execution",
        "uncertain_mes": "Adversaries may bypass process and/or signature-based defenses by proxying execution of malicious content with signed, or otherwise trusted, binaries. Binaries used in this technique are often Microsoft-signed files, indicating that they have been either downloaded from Microsoft or are already native in the operating system.(Citation: LOLBAS Project) Binaries signed with trusted digital certificates can typically execute on Windows systems protected by digital signature validation. Several Microsoft signed binaries that are default on Windows installations can be used to proxy execution of other files or commands.\n\nSimilarly, on Linux systems adversaries may abuse trusted binaries such as <code>split</code> to proxy execution of malicious commands.(Citation: split man page)(Citation: GTFO split)",
        "processed": true,
        "hsage": 12.42217998702806,
        "profile_without_enhance_5": "[profile]T1218, System Binary Proxy Execution, is a Defense Evasion technique applicable to Windows, Linux, and macOS. It involves adversaries bypassing security controls by using trusted, often digitally signed, system binaries to proxy the execution of malicious commands or files. On Windows, this includes Microsoft-signed utilities like odbcconf.exe, which can execute DLLs via its REGSVR flag, while on Linux, trusted binaries like `split` can be similarly abused. This method can mask malicious activity under legitimate processes and is associated with groups like Lazarus Group and Volt Typhoon."
    },
    "16423": {
        "semantic": 1,
        "phase_names": [
            "collection"
        ],
        "entity_type": "attack-pattern",
        "aliases": [
            "Email Collection"
        ],
        "unique_id": "1aa462c1-5313-4571-b6b9-9b40f3c751d3",
        "name": "T1114",
        "description": "Adversaries may target user email to collect sensitive information. Emails may contain sensitive data, including trade secrets or personal information, that can prove valuable to adversaries. Emails may also contain details of ongoing incident response operations, which may allow adversaries to adjust their techniques in order to maintain persistence or evade defenses.(Citation: TrustedSec OOB Communications)(Citation: CISA AA20-352A 2021) Adversaries can collect or forward email from mail servers or clients.",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows",
            "Office Suite"
        ],
        "standard_attck_id": "T1114",
        "standard_attck_name": "Email Collection",
        "gid": 299,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "silent librarian",
            "scattered spider",
            "ember bear",
            "magic hound"
        ],
        "uncertain_id": "t1114",
        "uncertain_name": "email collection",
        "uncertain_mes": "Adversaries may target user email to collect sensitive information. Emails may contain sensitive data, including trade secrets or personal information, that can prove valuable to adversaries. Emails may also contain details of ongoing incident response operations, which may allow adversaries to adjust their techniques in order to maintain persistence or evade defenses.(Citation: TrustedSec OOB Communications)(Citation: CISA AA20-352A 2021) Adversaries can collect or forward email from mail servers or clients. ",
        "processed": true,
        "hsage": 11.93820219763957,
        "profile_without_enhance_5": "[profile]T1114, known as Email Collection, is a Collection tactic technique targeting macOS, Linux, Windows, and Office Suite platforms. It involves adversaries collecting or forwarding sensitive information from user email clients or mail servers. This activity can be performed locally or remotely, as indicated by its sub-techniques T1114.001 and T1114.002. The technique is associated with groups like Silent Librarian and Scattered Spider, and adversaries may later attempt to clear related mailbox data to remove evidence of their collection efforts.[/profile]"
    },
    "16424": {
        "semantic": 1,
        "phase_names": [],
        "entity_type": "attack-pattern",
        "unique_id": "0287da3c-751d-4d9f-a8f1-ab0e252ba9b3",
