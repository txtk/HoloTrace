        "no_semantic_neighbors": [
            "aca207b6cc683f93861e953d2e8100f21f72c875ade84c7c4584d39cae49b738",
            "c3efbac8ebffcf3d8178ce23e59f3b4978f5a91bf93773889870d45cc1b554b0",
            "ce2b6d3aad07d3dec2b24f676cc9d2022bab5a086c7e773f9cfa3e7b7dc6d66a",
            "d2140ab69551f9b5d5ccda0fcea9415561b80f13ad32c061989975262d72f1e5",
            "ce8ec776eb22c2bf9ec25fe36bd0dfa6617e4926103358b055fd55cdf7912328",
            "e50987f5f13de4a552778a691032d9fce3a102bfad3fb5b7edc4c48d2aa3b4f2",
            "086a0a68d3f8cbf4d07a7ea2c8d1e593d28de8b9cc7fa1fc144fa5e96333a1e1",
            "9eddffbef4d9d7329d062db0a93c933104d00f12106bf91fa3b58e8f8b19aa41",
            "80f59439f0d76b5e7b1331051da100022ac68639be8b16958a786f4cb5fd33a2",
            "217196571088cfd63105ae836482d742befcb7db37308ce757162c005a5af6ab",
            "82679512fa82267d64300db7d2d8b747dcb2f5c8c48e0ef8e92b2abb3c08c641",
            "d973e7854f10b4d0a1060e55022dceadc51d038cee85d05e2c2c2fd3b40a42be",
            "05880ff0442bbedc8f46076ef56d4d1ffeda68d9ef26b659c4868873fa84c1a9",
            "d6e6c786b793b46a1ee9b18b058e045d0aa1c83aa2b6aa493637f611d654d957",
            "078859c7dee046b193786027d5267be7724758810bdbc2ac5dd6da0ebb4e26bb",
            "9162ccb4816d889787a7e25ba680684afca1d7f3679c856ceedaf6bf8991e486",
            "03ee2011ad671b1781015024ea53edfbff92c28c2b123bba02d6a6f462e74105",
            "3ccbd8bd7424506b26491e5ff5ff55b000adaab1074ccf3b7452d0883f668040",
            "1301ec3006ad03742bfaef047aa434320aa0e725a99be5d6be27b955a814fcf4"
        ],
        "processed": true,
        "hsage": 0.0,
        "profile_without_enhance_5": "[profile]This intrusion set, likely associated with the Sandworm group, is also known as Backdoordiplomacy, Quarian, and Cloudcomputating. Its key malware includes the Rhadamanthys Stealer, DarkTrack, MetaStealer, Ozone RAT, and NETWIRE. Its TTPs emphasize Defense Evasion through Indirect Command Execution (using tools like Forfiles), Virtualization/Sandbox Evasion, and Credentials In Files, alongside Collection via Email Collection and Discovery via Account Discovery. The group is attributed to or shows strong overlaps with actors operating from or linked to Belarus and the Russian Federation. Its campaigns have utilized infrastructure domains such as document-cdn.org, innerverdanytiresw.shop, and marketplace24ei.ru.[/profile]"
    },
