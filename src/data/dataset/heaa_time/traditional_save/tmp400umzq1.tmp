    "21345": {
        "semantic": 1,
        "unique_id": "95ea0820-661e-4adb-bcc6-2b2fed96e4bd",
        "entity_type": "malware",
        "name": "DinodasRAT",
        "is_family": false,
        "no_semantic_neighbors": [
            "3d93b8954ed1441516302681674f4989bd0f20232ac2b211f4b601af0fcfc13b",
            "15412d1a6b7f79fad45bcd32cf82f9d651d9ccca082f98a0cca3ad5335284e45",
            "57f64f170dfeaa1150493ed3f63ea6f1df3ca71ad1722e12ac0f77744fb1a829",
            "6302acdfce30cec5e9167ff7905800a6220c7dda495c0aae1f4594c7263a29b2",
            "ebdf3d3e0867b29e66d8b7570be4e6619c64fae7e1fbd052be387f736c980c8e",
            "bf830191215e0c8db207ea320d8e795990cf6b3e6698932e6e0c9c0588fc9eff",
            "a2c3073fa5587f8a70d7def7fd8355e1f6d20eb906c3cd4df8c744826cb81d91",
            "98b5b4f96d4e1a9a6e170a4b2740ce1a1dfc411ada238e42a5954e66559a5541"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "dinodasrat",
        "uncertain_mes": "In February 2023, ESET researchers detected a spearphishing campaign targeting a governmental entity in Guyana. While we haven’t been able to link the campaign, which we named Operation Jacana, to any specific APT group, we believe with medium confidence that a China-aligned threat group is behind this incident.",
        "processed": true,
        "hsage": 13.332554906985017,
        "profile_without_enhance_5": "[profile]DinodasRAT, also known as Win32/DinodasRAT.B, is a Remote Access Trojan (RAT) used in campaigns such as Operation Jacana, which is suspected to be conducted by a China-aligned threat group. Its key behaviors include Process Injection for defense evasion, using Application Layer Protocols like HTTP for command and control, and performing discovery activities such as Process Discovery, System Service Discovery, and System Information Discovery to gather data from the victim's Windows system. It also employs Obfuscated Files or Information and Masquerading (T1036) to hide its presence.[/profile]"
    },
    "21346": {
        "semantic": 1,
        "unique_id": "ee603804-a24d-49c1-830e-579a7ab9ae8f",
        "entity_type": "malware",
        "name": "Linodas",
        "is_family": false,
        "no_semantic_neighbors": [
            "a2c3073fa5587f8a70d7def7fd8355e1f6d20eb906c3cd4df8c744826cb81d91",
            "98b5b4f96d4e1a9a6e170a4b2740ce1a1dfc411ada238e42a5954e66559a5541",
            "15412d1a6b7f79fad45bcd32cf82f9d651d9ccca082f98a0cca3ad5335284e45",
            "3d93b8954ed1441516302681674f4989bd0f20232ac2b211f4b601af0fcfc13b",
            "57f64f170dfeaa1150493ed3f63ea6f1df3ca71ad1722e12ac0f77744fb1a829",
            "6302acdfce30cec5e9167ff7905800a6220c7dda495c0aae1f4594c7263a29b2",
            "ebdf3d3e0867b29e66d8b7570be4e6619c64fae7e1fbd052be387f736c980c8e",
            "bf830191215e0c8db207ea320d8e795990cf6b3e6698932e6e0c9c0588fc9eff"
        ],
        "processed": true,
        "hsage": 5.633286526544438,
        "profile_without_enhance_5": "[profile]Linodas is a malware that employs techniques including User Execution (T1204) for initial access, Process Injection (T1055) for defense evasion and privilege escalation, and Masquerading (T1036) to appear legitimate. It uses Application Layer Protocol (T1071) for command and control communication and may obfuscate files or information (T1027). It is associated with infrastructure domains such as backup1service[.]com, backup1nas[.]com, and service-boostter[.]com, which are also linked to the Ryuk ransomware and groups like FIN6, Grim Spider, UNC1878, and Wizard Spider.[/profile]"
    },
    "21347": {
        "semantic": 1,
        "unique_id": "c8cc4005-2a26-4988-adc3-7964cdf1bf3d",
        "entity_type": "malware",
        "name": "XDealer",
        "is_family": false,
        "no_semantic_neighbors": [
            "bf830191215e0c8db207ea320d8e795990cf6b3e6698932e6e0c9c0588fc9eff",
            "a2c3073fa5587f8a70d7def7fd8355e1f6d20eb906c3cd4df8c744826cb81d91",
            "98b5b4f96d4e1a9a6e170a4b2740ce1a1dfc411ada238e42a5954e66559a5541",
            "3d93b8954ed1441516302681674f4989bd0f20232ac2b211f4b601af0fcfc13b",
            "57f64f170dfeaa1150493ed3f63ea6f1df3ca71ad1722e12ac0f77744fb1a829",
            "15412d1a6b7f79fad45bcd32cf82f9d651d9ccca082f98a0cca3ad5335284e45",
            "6302acdfce30cec5e9167ff7905800a6220c7dda495c0aae1f4594c7263a29b2",
            "ebdf3d3e0867b29e66d8b7570be4e6619c64fae7e1fbd052be387f736c980c8e"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "windealer",
        "uncertain_mes": "timer function. The Sleep()\nfunction is called in a loop until the timer timeout. In the sandbox, delays that are performed by the Sleep()\nfunction are skipped (replaced with a very short timeout) and the virtually elapsed time will be much higher than the requested timeout. The concept behind these methods is to measure elapsed time while running several forms of delays in parallel:\nsample2.exe:",
        "processed": true,
        "hsage": 13.333115428895113,
        "profile_without_enhance_5": "[profile]XDealer is a cross-platform backdoor malware. It is associated with the LuoYu threat group and targets entities in China, Taiwan, Japan, Korea, and Hong Kong, particularly in the financial, education, media, and technology sectors. Its key technical behaviors include user execution (T1204), command and control via application layer protocols (T1071), process injection (T1055), obfuscation of files or information (T1027), and masquerading (T1036). It has been deployed alongside other malware like ReverseWindow, ShadowPad, and PlugX.[/profile]"
    },
    "21348": {
        "semantic": 0,
        "unique_id": "4613d4ea-7d0a-4fdb-bed1-9b40fecc0a00",
