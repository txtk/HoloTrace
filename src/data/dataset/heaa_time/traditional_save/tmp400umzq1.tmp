    "20564": {
        "semantic": 1,
        "phase_names": [
            "collection"
        ],
        "entity_type": "attack-pattern",
        "unique_id": "8c32cc65-7267-491e-bec0-47b64275b1b8",
        "aliases": [
            "Archive via Library"
        ],
        "name": "Archive via Library",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "description": "An adversary may compress or encrypt data that is collected prior to exfiltration using 3rd party libraries. Many libraries exist that can archive data, including [Python](https://attack.mitre.org/techniques/T1059/006) rarfile (Citation: PyPI RAR), libzip (Citation: libzip), and zlib (Citation: Zlib Github). Most libraries include functionality to encrypt and/or compress data.\n\nSome archival libraries are preinstalled on systems, such as bzip2 on macOS and Linux, and zip on Windows. Note that the libraries are different from the utilities. The libraries can be linked against when compiling, while the utilities require spawning a subshell, or a similar execution mechanism.",
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows"
        ],
        "standard_attck_id": "T1560.002",
        "standard_attck_name": "Archive via Library",
        "gid": 4450,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "lazarus group",
            "threat group-3390"
        ],
        "uncertain_id": "t1560.002",
        "uncertain_name": "archive via library",
        "uncertain_mes": "An adversary may compress or encrypt data that is collected prior to exfiltration using 3rd party libraries. Many libraries exist that can archive data, including [Python](https://attack.mitre.org/techniques/T1059/006) rarfile (Citation: PyPI RAR), libzip (Citation: libzip), and zlib (Citation: Zlib Github). Most libraries include functionality to encrypt and/or compress data.\n\nSome archival libraries are preinstalled on systems, such as bzip2 on macOS and Linux, and zip on Windows. Note that the libraries are different from the utilities. The libraries can be linked against when compiling, while the utilities require spawning a subshell, or a similar execution mechanism.",
        "processed": true,
        "hsage": 14.335998044576836,
        "profile_without_enhance_5": "[profile]Archive via Library is technique T1560.002 under the Collection tactic. It operates on Windows, Linux, and macOS platforms. This technique involves compressing or encrypting collected data prior to exfiltration by linking against third-party libraries during compilation, such as Python's rarfile, libzip, or zlib, which avoids spawning a subshell. Pre-installed libraries like bzip2 on macOS/Linux and zip on Windows can be used. It has been associated with groups like Lazarus Group and Threat Group-3390.[/profile]"
    },
    "20565": {
