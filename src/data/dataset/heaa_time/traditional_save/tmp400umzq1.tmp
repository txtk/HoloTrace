    "22757": {
        "semantic": 0,
        "unique_id": "9de3dd9b-5ff5-422b-b5a9-7f2b8d0c0c55",
        "entity_type": "indicator",
        "valid_until": "2026-07-22T04:43:27.628Z",
        "name": "10e01ce96889c7b4366cfa1e7d99759e4e2b6e5dfe378087d9e836b7278abfb6",
        "valid_from": "2025-07-25T20:49:42.000Z",
        "no_semantic_neighbors": [
