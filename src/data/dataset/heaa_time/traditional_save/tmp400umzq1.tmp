{
    "16124": {
        "semantic": 1,
        "unique_id": "271ab77e-f814-4762-ba4d-c6b61decbf98",
        "entity_type": "malware",
        "name": "LessonOne",
        "is_family": false,
        "no_semantic_neighbors": [],
        "processed": true,
        "hsage": 5.775396380295326,
        "profile_without_enhance_5": "[profile]LessonOne is a malware that exploits vulnerabilities including CVE-2024-0769, CVE-2024-43093, CVE-2024-38112, CVE-2023-50164, and CVE-2024-21762. Its key tactics, techniques, and procedures involve Boot or Logon Autostart Execution for persistence, User Execution and Phishing for initial access, and the use of a Command and Scripting Interpreter for execution, while employing Obfuscated Files or Information for defense evasion. It has been associated with infrastructure such as the domain delphidigital.org.[/profile]"
    },
