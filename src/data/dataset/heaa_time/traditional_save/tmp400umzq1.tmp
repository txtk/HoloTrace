            "dd2675e2f6835f8a8a0e65e9dbc763ca9229b55af7d212da38b949051ae296a5",
            "7daab239271e088f04cae95627cc0066f48a1b178a1ff60b1140aa729126e928",
            "5d7eb6c36d261adeef1a59bde9eb965f5d8d7f56a2e607da913e782167ba6cb6",
            "900d08037d303d9b3d4a855e1a97d1f9283c28fe279e67eefe9997f856eeb439",
            "7e6a5e32596b99f45ea9099a14507a82c10a460c56585499d7cd640f2625567f",
            "ec553e14b84ccca9b84e96a9ed19188a1ba5f4bf1ca278ab88f928f0b00b9bd0",
            "9b49d6640f5f0f1d68f649252a96052f1d2e0822feadd7ebe3ab6a3cadd75985",
            "638c7a4f833dc95dbab5f0a81ef03b7d83704e30b5cdc630702475cc9fff86a2",
            "c6128f222f844e699760e32695d405bd5931635ec38ae50eddc17a0976ccefb4",
            "bab601635aafeae5fbfe1c1f7204de17b189b345efd91c46001f6d83efbb3c5a",
            "326dd85d76d33f3f04cbe7eef6d10ea73f800c84bfc3ed6f3963403c981bbb6e"
        ],
        "processed": true,
        "hsage": 5.914631075365499,
        "profile_without_enhance_5": "[profile]AteraAgent is a malware entity that has been used in malicious installations, with detection focusing on the use of the IntegratorLogin parameter for registering non-business emails. Its associated attack patterns include Endpoint Denial of Service (T1499), One-Way Communication for command and control (T1102.003), Office Application Startup for persistence (T1137), Local Account creation (T1136.001), and Data Destruction (T1485). It has been linked to threat groups such as APT29, APT32, and APT41, among others like Leviathan and Mustang Panda. Its infrastructure involves domains like googlevalues.com and webftpcloud.com, and it has been deployed via MSI installers from file-sharing services, with targeting observed in regions including Algeria, Egypt, the Central African Republic, Jordan, and Saudi Arabia.[/profile]"
    },
    "20963": {
        "semantic": 1,
        "phase_names": [
            "persistence"
        ],
        "entity_type": "attack-pattern",
        "aliases": [
            "Local Account"
        ],
        "unique_id": "04f2da72-327e-4b5d-8235-349156e04b44",
        "name": "T1136.001",
        "description": "Adversaries may create a local account to maintain access to victim systems. Local accounts are those configured by an organization for use by users, remote support, services, or for administration on a single system or service. \n\nFor example, with a sufficient level of access, the Windows `net user /add` command can be used to create a local account.  In Linux, the `useradd` command can be used, while on macOS systems, the `dscl -create` command can be used. Local accounts may also be added to network devices, often via common [Network Device CLI](https://attack.mitre.org/techniques/T1059/008) commands such as `username`, to ESXi servers via `esxcli system account add`, or to Kubernetes clusters using the `kubectl` utility.(Citation: cisco_username_cmd)(Citation: Kubernetes Service Accounts Security)\n\nAdversaries may also create new local accounts on network firewall management consoles – for example, by exploiting a vulnerable firewall management system, threat actors may be able to establish super-admin accounts that could be used to modify firewall rules and gain further access to the network.(Citation: Cyber Security News)\n\nSuch accounts may be used to establish secondary credentialed access that do not require persistent remote access tools to be deployed on the system.",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows",
            "Network Devices",
            "Containers",
            "ESXi"
        ],
        "standard_attck_id": "T1136.001",
        "standard_attck_name": "Local Account",
        "gid": 4849,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "fin13",
            "dragonfly",
            "kimsuky",
            "teamtnt",
            "apt3",
            "indrik spider",
            "magic hound",
            "apt5",
            "fox kitten",
            "apt41",
            "daggerfly",
            "leafminer",
            "apt39",
            "wizard spider"
        ],
        "uncertain_id": "t1136.001",
        "uncertain_name": "local account",
        "uncertain_mes": "Adversaries may create a local account to maintain access to victim systems. Local accounts are those configured by an organization for use by users, remote support, services, or for administration on a single system or service. \n\nFor example, with a sufficient level of access, the Windows <code>net user /add</code> command can be used to create a local account.  In Linux, the `useradd` command can be used, while on macOS systems, the <code>dscl -create</code> command can be used. Local accounts may also be added to network devices, often via common [Network Device CLI](https://attack.mitre.org/techniques/T1059/008) commands such as <code>username</code>, to ESXi servers via `esxcli system account add`, or to Kubernetes clusters using the `kubectl` utility.(Citation: cisco_username_cmd)(Citation: Kubernetes Service Accounts Security)\n\nAdversaries may also create new local accounts on network firewall management consoles – for example, by exploiting a vulnerable firewall management system, threat actors may be able to establish super-admin accounts that could be used to modify firewall rules and gain further access to the network.(Citation: Cyber Security News)\n\nSuch accounts may be used to establish secondary credentialed access that do not require persistent remote access tools to be deployed on the system.",
        "processed": true,
        "hsage": 13.491153060508609,
        "profile_without_enhance_5": "[profile]T1136.001, also known as Local Account, is a MITRE ATT&CK technique under the Persistence tactic. It operates across Windows, Linux, macOS, Network Devices, Containers, and ESXi platforms. Adversaries create local accounts to maintain secondary access, using commands like `net user /add` on Windows, `useradd` on Linux, `dscl -create` on macOS, `username` on network devices, `esxcli system account add` on ESXi, or `kubectl` for Kubernetes. This technique is associated with threat groups including APT3, APT5, APT39, APT41, Dragonfly, Fin13, Fox Kitten, Kimsuky, Leafminer, Magic Hound, TeamTNT, and Wizard Spider.[/profile]"
    },
    "20964": {
        "semantic": 1,
        "unique_id": "090a2d9f-52ba-4679-ae94-5b7659ccb7ed",
        "entity_type": "malware",
        "name": "NetBird",
        "is_family": false,
        "no_semantic_neighbors": [],
        "processed": true,
        "hsage": 5.716138077341079,
        "profile_without_enhance_5": "[profile]NetBird is a malware entity that uses the One-Way Communication C2 technique, leveraging services like Google or Twitter to send commands without receiving output over the same channel. It employs Data Encoding (T1132) to obfuscate C2 traffic and abuses Local Accounts (T1078.003) for credential misuse. The malware is associated with threat groups Gamaredon Group and Leviathan, and has been observed targeting systems in the Central African Republic, South Africa, and the United States.[/profile]"
    },
