    "24323": {
        "semantic": 1,
        "unique_id": "24697e8c-3e69-47ea-bc82-2a794aa102c2",
        "entity_type": "malware",
        "name": "UnmarshalPwn",
        "is_family": false,
        "no_semantic_neighbors": [
            "eba3138d0f3d2385b55b08d8886b1018834d194440691d33d612402ba8a11d28",
            "2e46fcadacfe9e2a63cfc18d95d5870de8b3414462bf14ba9e7c517678f235c9"
        ],
        "processed": true,
        "hsage": 5.669272351055948,
        "profile_without_enhance_5": "[profile]UnmarshalPwn is a malware that uses Remote Access Tools and Application Layer Protocols like HTTP for command and control. It performs OS Credential Dumping, System Owner/User Discovery, and queries the Windows Registry. It has targeted Taiwan, leveraging the vulnerability CVE-2018-0824, and uses infrastructure such as the domains www.nss.com.tw and IPs 103.56.114.69 and 45.85.76.18 to host payloads like p.ps1 and calc.exe.[/profile]"
    },
