        "entity_type": "malware",
        "name": "NETWIRE - S0198",
        "is_family": false,
        "no_semantic_neighbors": [
            "ce2b6d3aad07d3dec2b24f676cc9d2022bab5a086c7e773f9cfa3e7b7dc6d66a",
            "d973e7854f10b4d0a1060e55022dceadc51d038cee85d05e2c2c2fd3b40a42be",
            "9eddffbef4d9d7329d062db0a93c933104d00f12106bf91fa3b58e8f8b19aa41",
            "217196571088cfd63105ae836482d742befcb7db37308ce757162c005a5af6ab",
            "05880ff0442bbedc8f46076ef56d4d1ffeda68d9ef26b659c4868873fa84c1a9",
            "d6e6c786b793b46a1ee9b18b058e045d0aa1c83aa2b6aa493637f611d654d957",
            "3ccbd8bd7424506b26491e5ff5ff55b000adaab1074ccf3b7452d0883f668040",
            "03ee2011ad671b1781015024ea53edfbff92c28c2b123bba02d6a6f462e74105",
            "c3efbac8ebffcf3d8178ce23e59f3b4978f5a91bf93773889870d45cc1b554b0",
            "1301ec3006ad03742bfaef047aa434320aa0e725a99be5d6be27b955a814fcf4"
        ],
        "uncertain_related_groups": [
            "the white company",
            "silverterrier",
            "ta2541",
            "apt33"
        ],
        "uncertain_name": "netwire",
        "uncertain_mes": "[NETWIRE](https://attack.mitre.org/software/S0198) is a publicly available, multiplatform remote administration tool (RAT) that has been used by criminal and APT groups since at least 2012.(Citation: FireEye APT33 Sept 2017)(Citation: McAfee Netwire Mar 2015)(Citation: FireEye APT33 Webinar Sept 2017)",
        "processed": true,
        "hsage": 11.958008654905758,
        "profile_without_enhance_5": "[profile]NETWIRE - S0198, also known as Netwire, is a publicly available, multiplatform remote administration tool (RAT) used by criminal and APT groups since at least 2012, including groups like APT33, TA2541, and The White Company. Its key behaviors include defense evasion through masquerading, obfuscated files or information (T1027), and virtualization/sandbox evasion (T1497), as well as initial access via phishing (T1566) and indirect command execution. It targets multiple platforms and has been distributed by other malware like GuLoader, with associated infrastructure such as document-cdn.org.[/profile]"
    },
    "20782": {
        "semantic": 1,
        "unique_id": "3860e863-3a6e-4cae-a8ed-103a712605f1",
        "entity_type": "malware",
        "name": "Ozone RAT",
        "is_family": false,
        "no_semantic_neighbors": [
            "d6e6c786b793b46a1ee9b18b058e045d0aa1c83aa2b6aa493637f611d654d957",
            "3ccbd8bd7424506b26491e5ff5ff55b000adaab1074ccf3b7452d0883f668040",
