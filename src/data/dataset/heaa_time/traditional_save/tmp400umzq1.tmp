    "18147": {
        "semantic": 1,
        "unique_id": "1c89322f-03c1-4c9f-a6dd-db40287f3383",
        "entity_type": "malware",
        "name": "SilentGh0st",
        "is_family": false,
        "no_semantic_neighbors": [
            "93abcc4062a14ba3d3309fc5e8a910e81a4e3ce1bbbf5e6f7857779b6e76f43a",
            "7587ca6b8163e3e5b05e4a9fc79ec19deee9c971e6f76adadc4d970c99cad4f3",
            "6b5b8b12af21700a212d5ece27f065f8f9ed38b2969ad5dfaa790bc76754de6c",
            "1116efd48ca01623bf385cd612f4da1eb9eeba0329e41d0e068bcd6557a46f8f"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "silentgh0st",
        "uncertain_mes": "A previously unknown threat actor dubbed \"Unfading Sea Haze\" has been targeting military and government entities in the South China Sea region since 2018, remaining undetected all this time.\nBitdefender researchers who discovered the threat group report that its operations align with Chinese geo-political interests, focusing on intelligence collection and espionage.",
        "processed": true,
        "hsage": 13.457684885324102,
        "profile_without_enhance_5": "[profile]SilentGh0st, also known as SilentGh0st, is a malware variant attributed to the Chinese-aligned threat actor Unfading Sea Haze. It is the oldest variant of the Gh0stRAT family, offering extensive functionality through a rich set of commands and modules. Its key behaviors include abusing the Background Intelligent Transfer Service (BITS) for persistence and download, using Execution Guardrails to constrain payload execution to specific environments, and abusing elevation control mechanisms. It primarily targets Windows platforms and has been used in campaigns against military and government entities in the South China Sea region since at least 2018. Associated infrastructure includes domains like upupdate.ooguy.com and dns-log.d-n-s.org.uk.[/profile]"
    },
    "18148": {
        "semantic": 1,
        "unique_id": "85c281e3-ca7f-4146-9480-7bc866c4bcb1",
        "entity_type": "malware",
        "name": "SharpJSHandler",
        "is_family": false,
        "no_semantic_neighbors": [
            "6b5b8b12af21700a212d5ece27f065f8f9ed38b2969ad5dfaa790bc76754de6c",
            "93abcc4062a14ba3d3309fc5e8a910e81a4e3ce1bbbf5e6f7857779b6e76f43a",
            "7587ca6b8163e3e5b05e4a9fc79ec19deee9c971e6f76adadc4d970c99cad4f3",
            "1116efd48ca01623bf385cd612f4da1eb9eeba0329e41d0e068bcd6557a46f8f"
        ],
        "processed": true,
        "hsage": 5.761141004617037,
        "profile_without_enhance_5": "[profile]SharpJSHandler is a web shell that listens for HTTP requests and executes encoded JavaScript code. It is associated with the silentgh0st actor. Its technical behaviors include abusing Office Application Startup (T1137) for persistence, using BITS Jobs (T1197) for defense evasion and file transfer, and employing techniques like Abuse Elevation Control Mechanism (T1548) and Create Account (T1136). It targets the Windows platform and has used infrastructure domains such as upupdate.ooguy.com, mail.bomloginset.com, linklab.blinklab.com, fc.adswt.com, and provider.giize.com.[/profile]"
    },
    "18149": {
        "semantic": 0,
        "unique_id": "f4d79a1e-0610-4cfd-83ae-dd3a441d99c7",
        "entity_type": "indicator",
        "valid_until": "2025-05-20T16:15:05.628Z",
