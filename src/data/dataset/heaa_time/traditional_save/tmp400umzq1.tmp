    },
    "21349": {
        "created_time": "2025-08-14T07:29:18.322Z",
        "semantic": 1,
        "aka_name": [],
        "entity_type": "intrusion-set",
        "unique_id": "907fcc9c-d42a-4dcf-b2f8-1b659012e16e",
        "modified_time": "2025-08-14T17:50:30.556Z",
        "group_name": "Earth Krahang",
        "name": "unkown_apt_group",
        "description": "",
        "no_semantic_neighbors": [
            "15412d1a6b7f79fad45bcd32cf82f9d651d9ccca082f98a0cca3ad5335284e45",
            "3d93b8954ed1441516302681674f4989bd0f20232ac2b211f4b601af0fcfc13b",
            "57f64f170dfeaa1150493ed3f63ea6f1df3ca71ad1722e12ac0f77744fb1a829",
            "6302acdfce30cec5e9167ff7905800a6220c7dda495c0aae1f4594c7263a29b2",
            "ebdf3d3e0867b29e66d8b7570be4e6619c64fae7e1fbd052be387f736c980c8e",
            "bf830191215e0c8db207ea320d8e795990cf6b3e6698932e6e0c9c0588fc9eff",
            "a2c3073fa5587f8a70d7def7fd8355e1f6d20eb906c3cd4df8c744826cb81d91",
            "98b5b4f96d4e1a9a6e170a4b2740ce1a1dfc411ada238e42a5954e66559a5541"
        ],
        "processed": true,
        "hsage": 0.0,
        "profile_without_enhance_5": "[profile]This intrusion set, likely associated with the LuoYu threat group, is also known as BackdoorDiplomacy, Backdip, Quarian, and CloudComputating. Its key malware includes the cross-platform backdoor XDealer, the Remote Access Trojan DinodasRAT, and Linodas. The group's primary TTPs involve User Execution (T1204) for initial access, Application Layer Protocol (T1071) for command and control, and Process Injection (T1055), Masquerading (T1036), and Obfuscated Files or Information (T1027) for defense evasion. It is attributed to a China-aligned actor and primarily targets entities in China, Taiwan, Japan, Korea, and Hong Kong, focusing on sectors such as finance, education, media, and technology, with motivations likely aligned with espionage.[/profile]"
    },
