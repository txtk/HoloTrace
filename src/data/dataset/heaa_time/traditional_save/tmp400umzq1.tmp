    "21054": {
        "semantic": 1,
        "unique_id": "0b01858a-1f30-4c8f-b3c3-793aed65ecb8",
        "entity_type": "malware",
        "name": "PowerShell RAT",
        "is_family": false,
        "no_semantic_neighbors": [
            "46a76b3c7851f30d68ebc6a5584bc099435b0544d8707fff7a9178f46046708b"
        ],
        "uncertain_related_groups": [
            "web",
            "backdoor",
            ""
        ],
        "uncertain_name": "powershell",
        "uncertain_mes": "powershell_web_backdoor This is a very simple powershell web backdoor Usage: hxxp://127.0.0.1:9999/backdoor/?cmd=<Insert Your powershell compatible base64 encoded command here",
        "processed": true,
        "hsage": 12.288841973028386,
        "profile_without_enhance_5": "[profile]PowerShell RAT is a Remote Access Trojan (RAT) utilizing PowerShell for execution. It is associated with threat groups including APT29, APT32, APT41, and FIN7. Its key behaviors involve using automated exfiltration (T1020) over command-and-control channels, employing data encoding like Base64 (T1132) to obfuscate traffic, and establishing C2 via non-application layer protocols (T1095). It targets Windows platforms. Its infrastructure includes C2 domains such as swordoke[.]com and bestsecure2020[.]com/gate, and it has been linked to campaigns involving ZLoader.[/profile]"
    },
