    "19012": {
        "semantic": 1,
        "unique_id": "044450d0-3f6a-4a03-b936-8e0adf8629f0",
        "entity_type": "malware",
        "name": "LCollection",
        "is_family": false,
        "no_semantic_neighbors": [
            "f83e2b3be2e6db20806a4b9b216edc7508fa81ce60bf59436d53d3ae435b6060",
            "4ac088bf25d153ec2b9402377695b15a28019dc8087d98bd34e10fed3424125f",
            "89c1d1b61d7f863f8a651726e29f2ae3de7958f36b49a756069021817947d06c",
            "bc2597ce09987022ff0498c6710a9b51a1a47ed8082ac044be2838b384157527",
            "baac058ddfc96c8aea8c0057077505f0ad3ff20311d999886fed549924404849",
            "0180f4f29c550aa1ffaa21af51711b29de99fb1d7c932d008a0e9356ae8a7d60",
            "c67cd544a112cab1bb75b3c44df4caf2045ef0af51de9ece11261d6c504add32",
            "33a61ff123713da26f45b399a9828e29ad25fbda7e8994c954d714375ef92156",
            "82ae2eb470a5a16ca39ec84b387294eaa3ae82e5ada4b252470c1281e1f31c0a",
            "c3486133783379e13ed37c45dc6645cbee4c1c6e62e7988722931eef99c8eaf3"
        ],
        "processed": true,
        "hsage": 5.750767526537054,
        "profile_without_enhance_5": "[profile]LCollection is a malware targeting Windows systems, attributed to the APT group MuddyWater. It employs key TTPs including audio capture via system microphones, email collection from local clients, and deploying containers for evasion and execution. Its infrastructure involves C2 servers at domains like panel-short-check.live and check-pabnel-status.live, used for data exfiltration and command relay. The malware's activities are linked to locations including Israel and the United States.[/profile]"
    },
    "19013": {
        "semantic": 1,
        "unique_id": "8811d0ef-493f-4916-9b04-14e29933dd14",
