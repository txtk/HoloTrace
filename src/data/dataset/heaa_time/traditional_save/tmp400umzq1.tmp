    "20497": {
        "semantic": 1,
        "unique_id": "cacbcf38-3a8d-422f-a64c-37bd2e7dd567",
        "entity_type": "malware",
        "name": "DslogdRAT",
        "is_family": false,
        "no_semantic_neighbors": [
            "f48857263991eea1880de0f62b3d1d37101c2e7739dcd8629b24260d08850f9c",
            "1dd64c00f061425d484dd67b359ad99df533aa430632c55fa7e7617b55dab6a8",
            "b1221000f43734436ec8022caaa34b133f4581ca3ae8eccd8d57ea62573f301d"
        ],
        "processed": true,
        "hsage": 5.671897330225042,
        "profile_without_enhance_5": "[profile]DslogdRAT is a Remote Access Trojan (RAT) targeting Japan. Its key behaviors, as mapped to MITRE ATT&CK, include scheduling data exfiltration (T1029), conducting internal spearphishing for lateral movement (T1534), discovering system time (T1124), employing virtualization and sandbox evasion (T1497), and using data encoding like Base64 to obfuscate its command-and-control traffic (T1132).[/profile]"
    },
