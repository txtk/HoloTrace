    "19330": {
        "semantic": 1,
        "phase_names": [
            "execution",
            "persistence",
            "privilege-escalation"
        ],
        "aliases": [
            "Container Orchestration Job"
        ],
        "entity_type": "attack-pattern",
        "unique_id": "b9842039-6fd0-436a-ad63-ee64d37f2016",
        "name": "Container Orchestration Job",
        "kill_chain_names": [
            "mitre-attack",
            "mitre-attack",
            "mitre-attack"
        ],
        "description": "Adversaries may abuse task scheduling functionality provided by container orchestration tools such as Kubernetes to schedule deployment of containers configured to execute malicious code. Container orchestration jobs run these automated tasks at a specific date and time, similar to cron jobs on a Linux system. Deployments of this type can also be configured to maintain a quantity of containers over time, automating the process of maintaining persistence within a cluster.\n\nIn Kubernetes, a CronJob may be used to schedule a Job that runs one or more containers to perform specific tasks.(Citation: Kubernetes Jobs)(Citation: Kubernetes CronJob) An adversary therefore may utilize a CronJob to schedule deployment of a Job that executes malicious code in various nodes within a cluster.(Citation: Threat Matrix for Kubernetes)",
        "x_mitre_description": "",
        "platforms": [
            "Containers"
        ],
        "standard_attck_id": "T1053.007",
        "standard_attck_name": "Container Orchestration Job",
        "gid": 3213,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [],
        "uncertain_id": "t1053.007",
        "uncertain_name": "container orchestration job",
        "uncertain_mes": "Adversaries may abuse task scheduling functionality provided by container orchestration tools such as Kubernetes to schedule deployment of containers configured to execute malicious code. Container orchestration jobs run these automated tasks at a specific date and time, similar to cron jobs on a Linux system. Deployments of this type can also be configured to maintain a quantity of containers over time, automating the process of maintaining persistence within a cluster.\n\nIn Kubernetes, a CronJob may be used to schedule a Job that runs one or more containers to perform specific tasks.(Citation: Kubernetes Jobs)(Citation: Kubernetes CronJob) An adversary therefore may utilize a CronJob to schedule deployment of a Job that executes malicious code in various nodes within a cluster.(Citation: Threat Matrix for Kubernetes)",
        "processed": true,
        "hsage": 6.756184821259857,
        "profile_without_enhance_5": "[profile]Container Orchestration Job is identified as MITRE ATT&CK technique T1053.007 under the Execution, Persistence, and Privilege Escalation tactics for Containers platforms. It involves abusing scheduling features in orchestration tools like Kubernetes, where an adversary can use a CronJob to schedule a Job that deploys containers executing malicious code at specific times across cluster nodes, automating malicious task execution and persistence."
    },
