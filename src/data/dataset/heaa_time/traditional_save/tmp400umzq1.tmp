            "05880ff0442bbedc8f46076ef56d4d1ffeda68d9ef26b659c4868873fa84c1a9",
            "9162ccb4816d889787a7e25ba680684afca1d7f3679c856ceedaf6bf8991e486",
            "d2140ab69551f9b5d5ccda0fcea9415561b80f13ad32c061989975262d72f1e5",
            "aca207b6cc683f93861e953d2e8100f21f72c875ade84c7c4584d39cae49b738",
            "ce8ec776eb22c2bf9ec25fe36bd0dfa6617e4926103358b055fd55cdf7912328",
            "e50987f5f13de4a552778a691032d9fce3a102bfad3fb5b7edc4c48d2aa3b4f2",
            "086a0a68d3f8cbf4d07a7ea2c8d1e593d28de8b9cc7fa1fc144fa5e96333a1e1",
            "80f59439f0d76b5e7b1331051da100022ac68639be8b16958a786f4cb5fd33a2",
            "217196571088cfd63105ae836482d742befcb7db37308ce757162c005a5af6ab"
        ],
        "processed": true,
        "hsage": 5.719901917632274,
        "profile_without_enhance_5": "[profile]Lumma Trojan, also known as Lumma Stealer, is an information stealer malware family used since at least 2022 and operates as a Malware as a Service (MaaS) in criminal markets. It is associated with the threat actor Angry Likho and has infrastructure linked to domains like averageorganicfallfaw.shop. Key techniques include T1087 (Account Discovery), T1114 (Email Collection), T1552.001 (Credentials In Files), T1555 (Credentials from Password Stores), and T1204 (User Execution) to steal credentials and sensitive data from Windows systems.[/profile]"
    },
