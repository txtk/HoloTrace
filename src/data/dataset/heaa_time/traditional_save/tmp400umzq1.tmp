    "21453": {
        "semantic": 1,
        "unique_id": "68ce1eb3-e2c4-4ff8-869b-c68c2b4a9760",
        "entity_type": "malware",
        "name": "HustleCon",
        "is_family": false,
        "no_semantic_neighbors": [],
        "processed": true,
        "hsage": 6.333444686586416,
        "profile_without_enhance_5": "[profile]HustleCon is a malware entity. It employs MITRE ATT&CK techniques including Phishing (T1566) for initial access, Remote Services (T1021) for lateral movement, and Clipboard Data (T1115) for data collection. It is associated with the Handala Hacking Team and has utilized infrastructure domains such as eu-west-3.ukrainesec.cloud and townoflakelure.com."
    },
