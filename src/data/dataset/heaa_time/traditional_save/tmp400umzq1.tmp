    "20225": {
        "semantic": 1,
        "unique_id": "c22e0ede-c7e7-4e05-b2b7-3576e5cf820a",
        "entity_type": "malware",
        "name": "Dropping Elephant RAT",
        "is_family": false,
        "no_semantic_neighbors": [
            "01a635a11a140aef906efe9db22fb66b0d6510e1e702870c4c728099fd5ab455",
            "588021b5553838fae5498de40172d045b5168c8e608b8929a7309fd08abfaa93",
            "341f27419becc456b52d6fbe2d223e8598065ac596fa8dec23cc722726a28f62",
            "2cd2a4f1fc7e4b621b29d41e42789c1365e5689b4e3e8686b80f80268e2c0d8d",
            "89ec9f19958a442e9e3dd5c96562c61229132f3acb539a6b919c15830f403553",
            "8b6acc087e403b913254dd7d99f09136dc54fa45cf3029a8566151120d34d1c2"
        ],
        "processed": true,
        "hsage": 5.718687412322921,
        "profile_without_enhance_5": "[profile]Dropping Elephant RAT is a Remote Access Trojan. It employs TTPs including Data Encoding (T1132) for C2 obfuscation, Timestomp (T1099) for defense evasion by altering file timestamps, System Time Discovery (T1124), Virtualization/Sandbox Evasion (T1497), and Indicator Removal (T1070). It has been associated with the actor APT33. Its infrastructure includes domains like roseserve.org, expouav.org, and rosereserve.org, and it is known to exploit vulnerabilities such as CVE-2025-5777, CVE-2025-20337, and CVE-2025-53770.[/profile]"
    },
    "20226": {
        "semantic": 1,
        "unique_id": "34958b10-38c2-4380-b09c-c3a248d12354",
