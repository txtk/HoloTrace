            "109d4b8878b8c8f3b7015f6b3ae573a6799296becce0f32ca3bd216bee0ab473",
            "93c29bf19e09ea3b1e4ac5d31f47024a544738671488ff7ab2cd8f9a9c302262",
            "a67ac84f61b34b59827cef79b11709d137cc9490d6027e16279793b9b3e894c4",
            "1a9d78e5c255de239fb18b2cf47c4c2298f047073299c27fb54a0edf08a1d5a1",
            "c26d239f415bec27125862acafdeac267be398bc9208e27f09217dc8ecf64225",
            "ae1b66e35a4e1ab8870837a52f3e4acda9e722b3f835d238acb472be49e915d6"
        ],
        "processed": true,
        "hsage": 5.65163445899237,
        "profile_without_enhance_5": "[profile]WolfsBane is a malware targeting entities in Singapore, the Philippines, and Taiwan. It uses infrastructure including the domains domain.dns04.com, www.travel.dns04.com, 4vw37z.cn, info.96html.com, and asidomain.com for command and control. It is associated with the Latrodectus malware family and shares context with the Ozone RAT, which is delivered via malicious emails containing fake procurement orders.[/profile]"
    },
