    "19009": {
        "semantic": 1,
        "unique_id": "61f371f3-4c10-45dc-82a3-1c397c64712a",
        "entity_type": "malware",
        "name": "YCollection",
        "is_family": false,
        "no_semantic_neighbors": [
            "c3486133783379e13ed37c45dc6645cbee4c1c6e62e7988722931eef99c8eaf3",
            "f83e2b3be2e6db20806a4b9b216edc7508fa81ce60bf59436d53d3ae435b6060",
            "4ac088bf25d153ec2b9402377695b15a28019dc8087d98bd34e10fed3424125f",
            "89c1d1b61d7f863f8a651726e29f2ae3de7958f36b49a756069021817947d06c",
            "baac058ddfc96c8aea8c0057077505f0ad3ff20311d999886fed549924404849",
            "bc2597ce09987022ff0498c6710a9b51a1a47ed8082ac044be2838b384157527",
            "0180f4f29c550aa1ffaa21af51711b29de99fb1d7c932d008a0e9356ae8a7d60",
            "c67cd544a112cab1bb75b3c44df4caf2045ef0af51de9ece11261d6c504add32",
            "33a61ff123713da26f45b399a9828e29ad25fbda7e8994c954d714375ef92156",
            "82ae2eb470a5a16ca39ec84b387294eaa3ae82e5ada4b252470c1281e1f31c0a"
        ],
        "processed": true,
        "hsage": 5.75369833477003,
        "profile_without_enhance_5": "[profile]YCollection is a malware that communicates with C2 servers via HTTP POST requests to domains like panel-short-check.live and check-pabnel-status.live, primarily targeting victims in Israel and the United States. Its Tactics, Techniques, and Procedures (TTPs) include T1610 Deploy Container for execution and defense evasion, T1123 Audio Capture for collection, and reconnaissance techniques T1591 Gather Victim Org Information and T1598 Phishing for Information, alongside the resource development technique T1587 Develop Capabilities."
    },
    "19010": {
        "semantic": 1,
        "unique_id": "63e6beff-ea91-4e0e-a28e-53f699461e99",
        "entity_type": "malware",
        "name": "DWP",
        "is_family": false,
        "no_semantic_neighbors": [
            "82ae2eb470a5a16ca39ec84b387294eaa3ae82e5ada4b252470c1281e1f31c0a",
            "c3486133783379e13ed37c45dc6645cbee4c1c6e62e7988722931eef99c8eaf3",
            "f83e2b3be2e6db20806a4b9b216edc7508fa81ce60bf59436d53d3ae435b6060",
            "4ac088bf25d153ec2b9402377695b15a28019dc8087d98bd34e10fed3424125f",
            "89c1d1b61d7f863f8a651726e29f2ae3de7958f36b49a756069021817947d06c",
            "bc2597ce09987022ff0498c6710a9b51a1a47ed8082ac044be2838b384157527",
            "baac058ddfc96c8aea8c0057077505f0ad3ff20311d999886fed549924404849",
            "c67cd544a112cab1bb75b3c44df4caf2045ef0af51de9ece11261d6c504add32",
            "0180f4f29c550aa1ffaa21af51711b29de99fb1d7c932d008a0e9356ae8a7d60",
            "33a61ff123713da26f45b399a9828e29ad25fbda7e8994c954d714375ef92156"
        ],
        "processed": true,
        "hsage": 5.7531320168765046,
        "profile_without_enhance_5": "[profile]DWP is a malware entity with associated filenames including TpRIfutRxWlhn224.dwp, Traverser.dwp, and Midd.dwp. It operates as part of an infection chain where a file like ieinstal.exe performs keylogging and clipboard capture following system compromise. Its command and control infrastructure includes domains such as checking-paneling.live, check-pabnel-status.live, short-ion-per.live, and click-choose-figured.cfd, used for communication and payload retrieval. Its technical behaviors are linked to MITRE ATT&CK techniques including Deploy Container (T1610), Audio Capture (T1123), and Supply Chain Compromise (T1195). Associated activity has been geolocated to Israel and the United States.[/profile]"
    },
