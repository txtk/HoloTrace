    "19204": {
        "semantic": 1,
        "phase_names": [
            "defense-evasion"
        ],
        "entity_type": "attack-pattern",
        "aliases": [
            "Impair Defenses"
        ],
        "unique_id": "00a01aa7-19b2-42b9-9479-5f04f1d2c217",
        "name": "T1562",
        "description": "Adversaries may maliciously modify components of a victim environment in order to hinder or disable defensive mechanisms. This not only involves impairing preventative defenses, such as firewalls and anti-virus, but also detection capabilities that defenders can use to audit activity and identify malicious behavior. This may also span both native defenses as well as supplemental capabilities installed by users and administrators.\n\nAdversaries may also impair routine operations that contribute to defensive hygiene, such as blocking users from logging out, preventing a system from shutting down, or disabling or modifying the update process. Adversaries could also target event aggregation and analysis mechanisms, or otherwise disrupt these procedures by altering other system components. These restrictions can further enable malicious operations as well as the continued propagation of incidents.(Citation: Google Cloud Mandiant UNC3886 2024)(Citation: Emotet shutdown)",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows",
            "Network Devices",
            "Containers",
            "IaaS",
            "ESXi",
            "Office Suite",
            "Identity Provider"
        ],
        "standard_attck_id": "T1562.008",
        "standard_attck_name": "Disable or Modify Cloud Logs",
        "gid": 3087,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "blackbyte",
            "magic hound"
        ],
        "uncertain_id": "t1562",
        "uncertain_name": "impair defenses",
        "uncertain_mes": "Adversaries may maliciously modify components of a victim environment in order to hinder or disable defensive mechanisms. This not only involves impairing preventative defenses, such as firewalls and anti-virus, but also detection capabilities that defenders can use to audit activity and identify malicious behavior. This may also span both native defenses as well as supplemental capabilities installed by users and administrators.\n\nAdversaries may also impair routine operations that contribute to defensive hygiene, such as blocking users from logging out, preventing a system from shutting down, or disabling or modifying the update process. Adversaries could also target event aggregation and analysis mechanisms, or otherwise disrupt these procedures by altering other system components. These restrictions can further enable malicious operations as well as the continued propagation of incidents.(Citation: Google Cloud Mandiant UNC3886 2024)(Citation: Emotet shutdown)\n\n",
        "processed": true,
        "hsage": 11.742196623444464,
        "profile_without_enhance_5": "[profile]T1562, Impair Defenses, is a defense-evasion technique targeting macOS, Linux, Windows, Network Devices, Containers, IaaS, ESXi, Office Suite, and Identity Provider platforms. It involves maliciously modifying a victim environment to hinder or disable defensive mechanisms, including preventative tools like firewalls and detection capabilities used for auditing. This can extend to impairing routine security operations, such as blocking logouts, preventing shutdowns, or disrupting update processes and event analysis. Specific sub-techniques include Indicator Blocking (T1562.002) and Disable Windows Event Logging (T1562.004), and it can be used after activities like Cloud Service Discovery to evade identified defenses.[/profile]"
    },
    "19205": {
        "semantic": 1,
        "phase_names": [
            "defense-evasion"
        ],
        "entity_type": "attack-pattern",
        "unique_id": "c1b68645-4f67-488f-ba96-23a89961fd49",
        "aliases": [
            "Impair Defenses"
        ],
        "name": "Impair Defenses",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "description": "Adversaries may maliciously modify components of a victim environment in order to hinder or disable defensive mechanisms. This not only involves impairing preventative defenses, such as firewalls and anti-virus, but also detection capabilities that defenders can use to audit activity and identify malicious behavior. This may also span both native defenses as well as supplemental capabilities installed by users and administrators.\n\nAdversaries may also impair routine operations that contribute to defensive hygiene, such as blocking users from logging out, preventing a system from shutting down, or disabling or modifying the update process. Adversaries could also target event aggregation and analysis mechanisms, or otherwise disrupt these procedures by altering other system components. These restrictions can further enable malicious operations as well as the continued propagation of incidents.(Citation: Google Cloud Mandiant UNC3886 2024)(Citation: Emotet shutdown)",
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows",
            "Network Devices",
            "Containers",
            "IaaS",
            "ESXi",
            "Office Suite",
            "Identity Provider"
        ],
        "standard_attck_id": "T1629",
        "standard_attck_name": "Impair Defenses",
        "gid": 3088,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "blackbyte",
            "magic hound"
        ],
        "uncertain_id": "t1562",
        "uncertain_name": "impair defenses",
        "uncertain_mes": "Adversaries may maliciously modify components of a victim environment in order to hinder or disable defensive mechanisms. This not only involves impairing preventative defenses, such as firewalls and anti-virus, but also detection capabilities that defenders can use to audit activity and identify malicious behavior. This may also span both native defenses as well as supplemental capabilities installed by users and administrators.\n\nAdversaries may also impair routine operations that contribute to defensive hygiene, such as blocking users from logging out, preventing a system from shutting down, or disabling or modifying the update process. Adversaries could also target event aggregation and analysis mechanisms, or otherwise disrupt these procedures by altering other system components. These restrictions can further enable malicious operations as well as the continued propagation of incidents.(Citation: Google Cloud Mandiant UNC3886 2024)(Citation: Emotet shutdown)\n\n",
        "processed": true,
        "hsage": 11.724589913720841,
        "profile_without_enhance_5": "[profile]Impair Defenses is a MITRE ATT&CK technique (T1562) under the Defense Evasion tactic, applicable across Windows, Linux, macOS, and network platforms. It involves maliciously modifying a victim environment to hinder or disable defensive mechanisms, including preventative tools like firewalls and anti-virus, detection capabilities, and routine security hygiene operations. Specific sub-techniques include impairing command history logging by manipulating environment variables (e.g., `unset HISTFILE`, `export HISTFILESIZE=0`) or PowerShell settings, and conducting downgrade attacks to use less-secure system versions that bypass security logging.[/profile]"
    },
