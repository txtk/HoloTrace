    "20439": {
        "semantic": 1,
        "unique_id": "bec6b16c-362f-48bd-a2c4-eedcf2dd7bdb",
        "entity_type": "malware",
        "name": "CHAINSHOT",
        "is_family": false,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "chainshot",
        "uncertain_mes": "On April 14-15, 2021, Kaspersky technologies detected a wave of highly targeted attacks against multiple companies. Closer analysis revealed that all these attacks exploited a chain of Google Chrome and Microsoft Windows zero-day exploits.",
        "processed": true,
        "hsage": 13.434598156431239,
        "profile_without_enhance_5": "[profile]CHAINSHOT is a malware that exploits a chain of Google Chrome and Microsoft Windows zero-day vulnerabilities, as seen in a highly targeted attack wave in April 2021. It uses a first-stage dropper and shellcode payloads, and its delivery has involved malicious Excel documents and an Adobe Flash exploit (CVE-2018-5002). Its technical behaviors include Audio Capture (T1123), Boot or Logon Autostart Execution (T1547), Subvert Trust Controls (T1553), Clipboard Data collection (T1115), and credential access from password stores (T1555). It has primarily targeted systems in Armenia, Palestine, Azerbaijan, Uzbekistan, and Iran."
    },
    "20440": {
        "semantic": 1,
        "phase_names": [
            "defense-evasion"
        ],
        "entity_type": "attack-pattern",
        "aliases": [
            "Code Signing"
        ],
        "unique_id": "967e3025-1f03-4b55-b29c-c491d97a6388",
        "name": "Code Signing",
        "description": "Adversaries may create, acquire, or steal code signing materials to sign their malware or tools. Code signing provides a level of authenticity on a binary from the developer and a guarantee that the binary has not been tampered with. (Citation: Wikipedia Code Signing) The certificates used during an operation may be created, acquired, or stolen by the adversary. (Citation: Securelist Digital Certificates) (Citation: Symantec Digital Certificates) Unlike [Invalid Code Signature](https://attack.mitre.org/techniques/T1036/001), this activity will result in a valid signature.\n\nCode signing to verify software on first run can be used on modern Windows and macOS systems. It is not used on Linux due to the decentralized nature of the platform. (Citation: Wikipedia Code Signing)(Citation: EclecticLightChecksonEXECodeSigning)\n\nCode signing certificates may be used to bypass security policies that require signed code to execute on a system.",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "windows"
        ],
        "standard_attck_id": "T1553.002",
        "standard_attck_name": "Code Signing",
        "gid": 4326,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "patchwork",
            "fin6",
            "moses staff",
            "mustang panda",
            "copykittens",
            "scattered spider",
            "suckfly",
            "winnti group",
            "ta505",
            "medusa group",
            "apt41",
            "darkhotel",
            "molerats",
            "fin7",
            "leviathan",
            "gallium",
            "daggerfly",
            "lazarus group",
            "silence",
            "saint bear",
            "oilrig",
            "promethium",
            "kimsuky",
            "luminousmoth",
            "menupass",
            "wizard spider"
        ],
        "uncertain_id": "t1553.002",
        "uncertain_name": "code signing",
        "uncertain_mes": "Adversaries may create, acquire, or steal code signing materials to sign their malware or tools. Code signing provides a level of authenticity on a binary from the developer and a guarantee that the binary has not been tampered with. (Citation: Wikipedia Code Signing) The certificates used during an operation may be created, acquired, or stolen by the adversary. (Citation: Securelist Digital Certificates) (Citation: Symantec Digital Certificates) Unlike [Invalid Code Signature](https://attack.mitre.org/techniques/T1036/001), this activity will result in a valid signature.\n\nCode signing to verify software on first run can be used on modern Windows and macOS systems. It is not used on Linux due to the decentralized nature of the platform. (Citation: Wikipedia Code Signing)(Citation: EclecticLightChecksonEXECodeSigning)\n\nCode signing certificates may be used to bypass security policies that require signed code to execute on a system. ",
        "processed": true,
        "hsage": 10.258792904156113,
        "profile_without_enhance_5": "[profile]Code Signing is a Defense Evasion technique (T1553.002) targeting Windows and macOS platforms. It involves adversaries creating, acquiring, or stealing code signing certificates to digitally sign their malware, providing a false level of authenticity and bypassing security policies that require signed code to execute. This allows malicious binaries to masquerade as legitimate software from trusted developers."
    },
