            "System Binary Proxy Execution"
        ],
        "entity_type": "attack-pattern",
        "unique_id": "9c0438fa-6c7a-4546-8112-e7b829ff816c",
        "name": "System Binary Proxy Execution",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "description": "Adversaries may bypass process and/or signature-based defenses by proxying execution of malicious content with signed, or otherwise trusted, binaries. Binaries used in this technique are often Microsoft-signed files, indicating that they have been either downloaded from Microsoft or are already native in the operating system.(Citation: LOLBAS Project) Binaries signed with trusted digital certificates can typically execute on Windows systems protected by digital signature validation. Several Microsoft signed binaries that are default on Windows installations can be used to proxy execution of other files or commands.\n\nSimilarly, on Linux systems adversaries may abuse trusted binaries such as `split` to proxy execution of malicious commands.(Citation: split man page)(Citation: GTFO split)",
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows"
        ],
        "standard_attck_id": "T1218",
        "standard_attck_name": "System Binary Proxy Execution",
        "gid": 305,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "lazarus group",
            "volt typhoon"
        ],
        "uncertain_id": "t1218",
        "uncertain_name": "system binary proxy execution",
        "uncertain_mes": "Adversaries may bypass process and/or signature-based defenses by proxying execution of malicious content with signed, or otherwise trusted, binaries. Binaries used in this technique are often Microsoft-signed files, indicating that they have been either downloaded from Microsoft or are already native in the operating system.(Citation: LOLBAS Project) Binaries signed with trusted digital certificates can typically execute on Windows systems protected by digital signature validation. Several Microsoft signed binaries that are default on Windows installations can be used to proxy execution of other files or commands.\n\nSimilarly, on Linux systems adversaries may abuse trusted binaries such as <code>split</code> to proxy execution of malicious commands.(Citation: split man page)(Citation: GTFO split)",
        "processed": true,
        "hsage": 11.856727136225599,
        "profile_without_enhance_5": "[profile]System Binary Proxy Execution is MITRE ATT&CK technique T1218 under the Defense Evasion tactic, applicable to Windows, Linux, and macOS platforms. It involves adversaries bypassing security controls by using trusted, often digitally signed, system binaries to proxy the execution of malicious code or commands. Examples include using Microsoft-signed utilities like odbcconf.exe with its REGSVR flag to run DLLs or abusing native Linux binaries like split. This technique has been associated with groups including Lazarus Group and Volt Typhoon.[/profile]"
    },
    "16430": {
        "semantic": 1,
        "phase_names": [
            "defense-evasion"
        ],
        "entity_type": "attack-pattern",
        "aliases": [
            "Deobfuscate/Decode Files or Information"
        ],
        "unique_id": "cddfe983-315b-427b-a0b9-fbd7b784113c",
        "name": "Deobfuscate/Decode Files or Information",
        "description": "Adversaries may use [Obfuscated Files or Information](https://attack.mitre.org/techniques/T1027) to hide artifacts of an intrusion from analysis. They may require separate mechanisms to decode or deobfuscate that information depending on how they intend to use it. Methods for doing that include built-in functionality of malware or by using utilities present on the system.\n\nOne such example is the use of [certutil](https://attack.mitre.org/software/S0160) to decode a remote access tool portable executable file that has been hidden inside a certificate file.(Citation: Malwarebytes Targeted Attack against Saudi Arabia) Another example is using the Windows `copy /b` or `type` command to reassemble binary fragments into a malicious payload.(Citation: Carbon Black Obfuscation Sept 2016)(Citation: Sentinel One Tainted Love 2023)\n\nSometimes a user's action may be required to open it for deobfuscation or decryption as part of [User Execution](https://attack.mitre.org/techniques/T1204). The user may also be required to input a password to open a password protected compressed/encrypted file that was provided by the adversary.(Citation: Volexity PowerDuke November 2016)",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows",
            "ESXi"
        ],
        "standard_attck_id": "T1140",
        "standard_attck_name": "Deobfuscate/Decode Files or Information",
        "gid": 306,
        "no_semantic_neighbors": [
            "64677CAE14A2EC4D393A81548417B61B"
        ],
        "uncertain_related_groups": [
            "winter vivern",
            "fin13",
            "zirconium",
            "storm-1811",
            "wirte",
            "agrius",
            "mustang panda",
            "moonstone sleet",
            "cinnamon tempest",
            "apt28",
            "apt19",
            "gorgon group",
            "ke3chang",
            "ta505",
            "blackbyte",
            "malteiro",
            "turla",
            "threat group-3390",
            "darkhotel",
            "molerats",
            "volt typhoon",
            "earth lusca",
            "gamaredon group",
            "muddywater",
            "fin7",
