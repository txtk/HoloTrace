    "17142": {
        "semantic": 1,
        "unique_id": "f3410f62-73e5-4dae-83ba-3d6ca5108191",
        "entity_type": "malware",
        "name": "Downloader Module",
        "is_family": false,
        "no_semantic_neighbors": [
            "44ff1117bb0167f85d599236892deede636c358df3d8908582a6ce6a48070bd4",
            "57d761453bbc6ba9ace467f4491d7a19b9c7e097f81d9772efbcd2f43ada4dce"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "autocad downloader",
        "uncertain_mes": "Autolisp is a programming language for AutoCAD. Lisp sourcecode files have the extension LSP and the compiled Lisp-scripts FAS. This program will decrypt the resource part of fas and fsl files (write it to disk) and disassemble the it. With help of the disassembling you can see exactly :) what the program does, how thing are done and you can change some things with help of a Hexeditor.",
        "processed": true,
        "hsage": 13.517803549334605,
        "profile_without_enhance_5": "[profile]Downloader Module is a malware component, not a full family, known to exploit CVE-2017-11882 and operate in locations including Mozambique, Uganda, Nepal, Djibouti, and the Maldives. It connects to infrastructure like dgtk.depo-govpk.com, d0wnlaod.com, document-viewer.live, dirctt88.info, and directt88.com. Its key TTPs involve User Execution via phishing, Compile After Delivery to evade detection, Boot or Logon Autostart Execution for persistence, and Security Software Discovery. It targets Windows systems primarily, functioning as a downloader for further payloads.[/profile]"
    },
