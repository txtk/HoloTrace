    "16395": {
        "semantic": 1,
        "unique_id": "5b461013-cb6b-4e27-8331-9133f784cdfb",
        "entity_type": "malware",
        "name": "Kimsuky",
        "is_family": true,
        "no_semantic_neighbors": [
            "3314b6ea393e180c20db52448ab6980343bc3ed623f7af91df60189fec637744",
            "c1958894129800843f627bc791ae046f9f4c5b26a4cb7bd7b6d684b110be690a",
            "24a42a912c6ad98ab3910cb1e031edbdf9ed6f452371d5696006c9cf24319147"
        ],
        "uncertain_related_groups": [
            "kimsuki",
            "kimsuky"
        ],
        "uncertain_name": "kimsuky",
        "uncertain_mes": "Financial Security Institute, Republic of Korea\nThe Kimsuky group is a threat group that is known to have been behind the KHNP (Korea Hydro & Nuclear Power) cyber terrorism attacks of 2014 and is still active in 2019.\nSince 2018, we have been profiling and tracking spear-phishing emails and malicious code related to the Kimsuky group.",
        "processed": true,
        "hsage": 12.682366447546325,
        "profile_without_enhance_5": "[profile]Kimsuky, also known as Kimsuki, is a North Korean APT group active since at least 2013, attributed to cyberattacks like the 2014 Korea Hydro & Nuclear Power incident. Its TTPs include spear-phishing for initial access, using malicious documents for user execution, and employing persistence techniques like boot or logon autostart execution. The group utilizes backdoors, including open-source tools like Metasploit's Meterpreter, and has been associated with coinminer malware. It targets individuals and organizations in South Korea, Japan, and the US, focusing on foreign policy, national security, nuclear policy, and sanctions intelligence, using infrastructure like domains nomera.n-e.kr and update.screawear.ga.[/profile]"
    },
    "16396": {
        "semantic": 1,
        "unique_id": "72105041-ae76-4e25-9116-41b9418bb29a",
        "entity_type": "malware",
        "name": "BabyShark",
        "is_family": true,
        "no_semantic_neighbors": [
            "c1958894129800843f627bc791ae046f9f4c5b26a4cb7bd7b6d684b110be690a",
            "3314b6ea393e180c20db52448ab6980343bc3ed623f7af91df60189fec637744",
            "24a42a912c6ad98ab3910cb1e031edbdf9ed6f452371d5696006c9cf24319147"
        ],
        "uncertain_related_groups": [
            "kimsuky"
        ],
        "uncertain_name": "babyshark",
        "uncertain_mes": "[BabyShark](https://attack.mitre.org/software/S0414) is a Microsoft Visual Basic (VB) script-based malware family that is believed to be associated with several North Korean campaigns. (Citation: Unit42 BabyShark Feb 2019)",
        "processed": true,
        "hsage": 7.699500340161678,
        "profile_without_enhance_5": "[profile]BabyShark is a malware family also known as babyshark, associated with the North Korean group Kimsuky. It is a Visual Basic (VB) script-based malware that uses techniques like Boot or Logon Autostart Execution for persistence and Email Collection for data exfiltration. Its initial access often involves Phishing and User Execution, and it employs System Binary Proxy Execution for defense evasion. It targets Windows platforms and has used infrastructure including domains like woana.n-e.kr, peras1.n-e.kr, onsungtong.n-e.kr, nauji.n-e.kr, and download.uberlingen.com.[/profile]"
    },
