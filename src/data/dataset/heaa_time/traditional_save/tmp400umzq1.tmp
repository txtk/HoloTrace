    "17321": {
        "semantic": 1,
        "unique_id": "07cca396-ac35-4982-833e-782b03af9ca5",
        "entity_type": "malware",
        "name": "WarHawk",
        "is_family": false,
        "no_semantic_neighbors": [
            "3b7336d5851a59a95680b6b15abff99f86c83ab53b0b11da952cf171c6ee9dd4",
            "137d47864fb79c1a892265690bc8c64d67945847058b5a49ad5785ac902ae105",
            "f5766ece18b863c7747d739b4a0b944cdb13e9993dbc3401d4ea1923dbb0578a",
            "39e62d69ec3da04c3a3778fcd8dfbfc75cce9ac1e62df75537cc1b022d951cf5",
            "88c10674bb6a53791bfe08497948699bf57ea9980a878a3a5fc1afb160d1d234",
            "b41d54a9686b312f9e114f62e6bf11e21c8e97dda477d488ca19e2afa45efc9e",
            "076eaa395b1c0b473b252a04f286ea504286cf67bf439bd1ade67051c4b24da3"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "warhawk",
        "uncertain_mes": "Recently, Zscaler ThreatLabz discovered a new malware being used by the SideWinder APT threat group in campaigns targeting Pakistan: a backdoor we’ve called “WarHawk.” SideWinder APT, aka Rattlesnake or T-APT4, is a suspected Indian Threat Actor Group active since at least 2012, with a history of targeting government, military, and businesses throughout Asia, particularly Pakistan.",
        "processed": true,
        "hsage": 13.349143524277729,
        "profile_without_enhance_5": "[profile]WarHawk, also known as warhawk, is a backdoor malware attributed to the SideWinder APT group (aka Rattlesnake, T-APT4). Its key technical behaviors include string decryption routines for obfuscating library and function names (e.g., LoadLibraryA, GetUserNameA, GetComputerNameA) and it communicates with command-and-control infrastructure via specific domains and PHP scripts like http://plainboardssixty.com/drive/chilli.php and http://alibababackupcloud.com/spyder/smile.php. It has been used in campaigns targeting entities in Pakistan.[/profile]"
    },
