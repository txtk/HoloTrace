            "ab56501167fe689fe55f6e6ddc3bb91952299bd5c3ef004b02bf1c3b4061c7cf",
            "e5f1360d4c299bb32e33e081115f2b520251a983af2ebc649b4b9b70308246fe",
            "ec10a9396dca694fe64366e0dab82d046cf92457f97efd50a68ceb85adef6b74",
            "21fc0f50d545c0a373380934dc61c423c8a31d8c3e6eae4f8a35149ad9962d88"
        ],
        "processed": true,
        "hsage": 5.684981507957564,
        "profile_without_enhance_5": "[profile]SneakCross is a malware targeting Windows, Linux, and macOS platforms, employing techniques including Abuse Elevation Control Mechanism (e.g., bypassing UAC), Virtualization/Sandbox Evasion (e.g., detecting analysis environments), and Input Capture (e.g., keystroke logging) for credential theft. It also uses Remote Services like SSH or RDP for lateral movement and System Service Discovery via commands such as `sc query`. Associated infrastructure includes domains like track.cdn78544.ru, www.mircoupdate.https443.net, and www.sitennews.com, with observed targeting in locations such as Georgia, Qatar, Romania, and Italy.[/profile]"
    },
