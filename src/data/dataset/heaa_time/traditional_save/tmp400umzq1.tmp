            "f4222b240f88d43e6c63b9d9c09d93c10ba882b91fc4a61c0cd833f7c79b4c44",
            "1043ce610dd6e8b0cda635dbe1f15524c25d816f89ad22f9bc34403ef8e771cc"
        ],
        "uncertain_related_groups": [
            "smoky spider",
            "uac-0006"
        ],
        "uncertain_name": "smokeloader",
        "uncertain_mes": "Retefe is a banking Trojan that historically has routed online banking traffic intended for targeted banks through a proxy instead of the web injects more typical of other bankers. In the past, Retefe campaigns have targeted Austria, Sweden, and Switzerland, among other regions, such as users of UK online banking sites.",
        "processed": true,
        "hsage": 12.707332342889565,
        "profile_without_enhance_5": "[profile]SmokeLoader, also known as smokeloader, is a sophisticated and multifunctional malware attributed to groups including Smoky Spider and UAC-0006. It employs techniques such as System Binary Proxy Execution, Boot or Logon Autostart Execution, and User Execution, often delivered via phishing. It primarily targets Ukrainian financial and government organizations, using infrastructure like domains (restructurisationservice.ru, spotcarservice.ru, constractionscity1991.lat) and URLs (http://89.23.107.219/privat.exe) for distribution and command and control.[/profile]"
    },
