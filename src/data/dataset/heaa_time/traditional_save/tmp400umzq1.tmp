            "c3efbac8ebffcf3d8178ce23e59f3b4978f5a91bf93773889870d45cc1b554b0",
            "ce2b6d3aad07d3dec2b24f676cc9d2022bab5a086c7e773f9cfa3e7b7dc6d66a",
            "217196571088cfd63105ae836482d742befcb7db37308ce757162c005a5af6ab",
            "d973e7854f10b4d0a1060e55022dceadc51d038cee85d05e2c2c2fd3b40a42be",
            "9eddffbef4d9d7329d062db0a93c933104d00f12106bf91fa3b58e8f8b19aa41",
            "05880ff0442bbedc8f46076ef56d4d1ffeda68d9ef26b659c4868873fa84c1a9"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "ozone rat",
        "uncertain_mes": "FortiGuard Labs Threat Research",
        "processed": true,
        "hsage": 13.340143317720976,
        "profile_without_enhance_5": "[profile]Ozone RAT is a commercially available Remote Access Trojan (RAT) sold via a dedicated website with Standard and Platinum package options. Its client interface includes a main console, server builder, and control center. The malware employs Defense Evasion techniques such as Indirect Command Execution (e.g., using tools like Forfiles), Virtualization/Sandbox Evasion, Masquerading, and Obfuscated Files or Information. It uses infrastructure like the domain document-cdn.org and is distributed via Phishing. No specific threat actor group is attributed in the provided data.[/profile]"
    },
