    "18827": {
        "semantic": 1,
        "phase_names": [
            "credential-access"
        ],
        "entity_type": "attack-pattern",
        "aliases": [
            "Unsecured Credentials"
        ],
        "unique_id": "1362a34e-4477-4f9d-935c-71785097e37c",
        "name": "T1552",
        "description": "Adversaries may search compromised systems to find and obtain insecurely stored credentials. These credentials can be stored and/or misplaced in many locations on a system, including plaintext files (e.g. [Shell History](https://attack.mitre.org/techniques/T1552/003)), operating system or application-specific repositories (e.g. [Credentials in Registry](https://attack.mitre.org/techniques/T1552/002)),  or other specialized files/artifacts (e.g. [Private Keys](https://attack.mitre.org/techniques/T1552/004)).(Citation: Brining MimiKatz to Unix)",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows",
            "Network Devices",
            "Containers",
            "IaaS",
            "Office Suite",
            "Identity Provider",
            "SaaS"
        ],
        "standard_attck_id": "T1552",
        "standard_attck_name": "Unsecured Credentials",
        "gid": 2710,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "volt typhoon"
        ],
        "uncertain_id": "t1552",
        "uncertain_name": "unsecured credentials",
        "uncertain_mes": "Adversaries may search compromised systems to find and obtain insecurely stored credentials. These credentials can be stored and/or misplaced in many locations on a system, including plaintext files (e.g. [Shell History](https://attack.mitre.org/techniques/T1552/003)), operating system or application-specific repositories (e.g. [Credentials in Registry](https://attack.mitre.org/techniques/T1552/002)),  or other specialized files/artifacts (e.g. [Private Keys](https://attack.mitre.org/techniques/T1552/004)).(Citation: Brining MimiKatz to Unix)",
        "processed": true,
        "hsage": 13.261727814778917,
        "profile_without_enhance_5": "[profile]T1552, Unsecured Credentials, is a credential-access technique within the MITRE ATT&CK framework applicable to multiple platforms including Windows, Linux, and macOS. Adversaries exploit this by searching compromised systems for insecurely stored credentials, which are often found in plaintext files, OS/application-specific repositories like the Windows Registry, or specialized artifacts such as private key files. This method enables attackers to harvest credentials without needing to directly intercept them during entry or crack hashes.[/profile]"
    },
    "18828": {
        "semantic": 1,
