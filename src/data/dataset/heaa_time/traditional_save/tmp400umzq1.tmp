    "24342": {
        "semantic": 1,
        "phase_names": [
            "lateral-movement"
        ],
        "entity_type": "attack-pattern",
        "aliases": [
            "Remote Service Session Hijacking"
        ],
        "unique_id": "35f9752e-25a2-466b-8251-75a3e25989fd",
        "name": "T1563",
        "description": "Adversaries may take control of preexisting sessions with remote services to move laterally in an environment. Users may use valid credentials to log into a service specifically designed to accept remote connections, such as telnet, SSH, and RDP. When a user logs into a service, a session will be established that will allow them to maintain a continuous interaction with that service.\n\nAdversaries may commandeer these sessions to carry out actions on remote systems. [Remote Service Session Hijacking](https://attack.mitre.org/techniques/T1563) differs from use of [Remote Services](https://attack.mitre.org/techniques/T1021) because it hijacks an existing session rather than creating a new session using [Valid Accounts](https://attack.mitre.org/techniques/T1078).(Citation: RDP Hijacking Medium)(Citation: Breach Post-mortem SSH Hijack)",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows"
        ],
        "standard_attck_id": "T1563",
        "standard_attck_name": "Remote Service Session Hijacking",
        "gid": 8234,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [],
        "uncertain_id": "t1563",
        "uncertain_name": "remote service session hijacking",
        "uncertain_mes": "Adversaries may take control of preexisting sessions with remote services to move laterally in an environment. Users may use valid credentials to log into a service specifically designed to accept remote connections, such as telnet, SSH, and RDP. When a user logs into a service, a session will be established that will allow them to maintain a continuous interaction with that service.\n\nAdversaries may commandeer these sessions to carry out actions on remote systems. [Remote Service Session Hijacking](https://attack.mitre.org/techniques/T1563) differs from use of [Remote Services](https://attack.mitre.org/techniques/T1021) because it hijacks an existing session rather than creating a new session using [Valid Accounts](https://attack.mitre.org/techniques/T1078).(Citation: RDP Hijacking Medium)(Citation: Breach Post-mortem SSH Hijack)",
        "processed": true,
        "hsage": 0.0,
        "profile_without_enhance_5": "[profile]Remote Service Session Hijacking (T1563) is a Lateral Movement technique applicable to Windows, Linux, and macOS. It involves adversaries taking control of pre-existing, authenticated sessions on remote services like RDP, SSH, or telnet to execute actions, differing from creating new sessions with stolen credentials. This can be achieved by hijacking SSH agent sockets or connections, as seen in sub-technique T1563.001 (SSH Hijacking), and has been associated with exploitation such as CVE-2018-0824.[/profile]"
    },
    "24343": {
        "semantic": 1,
        "phase_names": [
