    "20472": {
        "semantic": 1,
        "phase_names": [
            "persistence",
            "privilege-escalation"
        ],
        "entity_type": "attack-pattern",
        "aliases": [
            "Account Manipulation"
        ],
        "unique_id": "96f8cde4-0d40-4d1e-9c57-1b0524b3dc89",
        "name": "T1098",
        "description": "Adversaries may manipulate accounts to maintain and/or elevate access to victim systems. Account manipulation may consist of any action that preserves or modifies adversary access to a compromised account, such as modifying credentials or permission groups.(Citation: FireEye SMOKEDHAM June 2021) These actions could also include account activity designed to subvert security policies, such as performing iterative password updates to bypass password duration policies and preserve the life of compromised credentials. \n\nIn order to create or manipulate accounts, the adversary must already have sufficient permissions on systems or the domain. However, account manipulation may also lead to privilege escalation where modifications grant access to additional roles, permissions, or higher-privileged [Valid Accounts](https://attack.mitre.org/techniques/T1078).",
        "kill_chain_names": [
            "mitre-attack",
            "mitre-attack"
        ],
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows",
            "Network Devices",
            "Containers",
            "IaaS",
            "ESXi",
            "Office Suite",
            "Identity Provider",
            "SaaS"
        ],
        "standard_attck_id": "T1098",
        "standard_attck_name": "Account Manipulation",
        "gid": 4358,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "lazarus group",
            "scattered spider",
            "hafnium"
        ],
        "uncertain_id": "t1098",
        "uncertain_name": "account manipulation",
        "uncertain_mes": "Adversaries may manipulate accounts to maintain and/or elevate access to victim systems. Account manipulation may consist of any action that preserves or modifies adversary access to a compromised account, such as modifying credentials or permission groups.(Citation: FireEye SMOKEDHAM June 2021) These actions could also include account activity designed to subvert security policies, such as performing iterative password updates to bypass password duration policies and preserve the life of compromised credentials. \n\nIn order to create or manipulate accounts, the adversary must already have sufficient permissions on systems or the domain. However, account manipulation may also lead to privilege escalation where modifications grant access to additional roles, permissions, or higher-privileged [Valid Accounts](https://attack.mitre.org/techniques/T1078).",
        "processed": true,
        "hsage": 7.578721971457923,
        "profile_without_enhance_5": "[profile]T1098, Account Manipulation, is a persistence and privilege-escalation technique used across Windows, Linux, macOS, and cloud platforms. Adversaries with sufficient permissions manipulate compromised accounts to maintain access, such as by modifying credentials or permission groups, and may perform iterative password updates to bypass duration policies. This manipulation can grant access to higher-privileged valid accounts. In cloud environments, this includes adding additional credentials or roles to created accounts, as seen in techniques like Additional Cloud Credentials (T1098.001) and Additional Cloud Roles (T1098.003). Associated threat groups include Lazarus Group, Scattered Spider, and Hafnium."
    },
