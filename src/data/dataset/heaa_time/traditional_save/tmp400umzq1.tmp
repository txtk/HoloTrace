        "uncertain_related_groups": [
            "ta428"
        ],
        "uncertain_name": "ncctrojan",
        "uncertain_mes": "Targeted attack\non industrial enterprises\nand public institutions  \n08.08.2022\nVersion 1.0  \nTARGETED ATTACK ON INDUSTRIAL ENTERPRISES\nAND PUBLIC INSTITUTIONS\n1\n© 2022 AO KASPERSKY LAB",
        "processed": true,
        "hsage": 13.97557812512381,
        "profile_without_enhance_5": "[profile]nccTrojan is a malware family, also known as ncctrojan. It is attributed to the threat group TA428. Its key behaviors include forging Kerberos Golden Tickets for credential access and gathering victim network and host information for reconnaissance. It uses data obfuscation for command and control and targets Windows platforms, as indicated by associated file paths and hostnames like doc.redstrpela.net.[/profile]"
    },
