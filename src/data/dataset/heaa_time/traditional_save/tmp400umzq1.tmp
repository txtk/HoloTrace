    "19325": {
        "semantic": 1,
        "unique_id": "43d7d0ec-cdc2-4fc7-878a-71292e3114b2",
        "entity_type": "malware",
        "name": "HijackLoader",
        "is_family": false,
        "no_semantic_neighbors": [
            "1dd7ae853911217095d2254337bedecee7267eea1ac9d0840eaf13506f40c9ab",
            "d6dd7a4f46f2cfde9c4eb9463b79d5ff90fc690da14672ba1da39708ee1b9b50",
            "372b14fce2eb35b264f6d4aeef7987da56d951d3a09ef866cf55ed72763caa12"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "hijackloader",
        "uncertain_mes": "Technical Analysis by: Thomas Elkins, Natalie Zargarov\nContributions: Evan McCann, Tyler McGraw\nRecently, Rapid7 observed the Fake Browser Update lure tricking users into executing malicious binaries. While analyzing the dropped binaries, Rapid7 determined a new loader is utilized in order to execute infostealers on compromised systems including StealC and Lumma.",
        "processed": true,
        "hsage": 13.367398903200389,
        "profile_without_enhance_5": "[profile]HijackLoader is a malware loader, also known as hijackloader, used to execute infostealers like StealC and Lumma on compromised systems. It employs Defense Evasion techniques including System Binary Proxy Execution (T1218) and specifically abuses the trusted msiexec.exe utility (T1218.007/Msiexec) to proxy execution and bypass controls. Its technical behavior involves using encrypted modules for payload delivery. The loader has been distributed via Fake Browser Update lures, primarily targeting systems in Colombia.[profile]"
    },
