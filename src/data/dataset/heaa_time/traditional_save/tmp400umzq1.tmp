    "24394": {
        "semantic": 1,
        "unique_id": "e66bc4e8-6d7a-41f1-879f-8f8d947a21e0",
        "entity_type": "malware",
        "name": "Spectre RAT",
        "is_family": false,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "spectre rat",
        "uncertain_mes": "Spectre (SPC) v9 Campaigns and Updates\nBy Jason Reaves and Joshua Platt\nSpectre RAT was previously discussed a few years ago[1] in an excellent overview by Yoroi but recently has resurfaced in campaigns being distributed on livechat-files[.com[3] using code signing certificates.",
        "processed": true,
        "hsage": 13.532090527525137,
        "profile_without_enhance_5": "[profile]Spectre RAT (SPC) is a remote access tool, with its v9 variant recently distributed via livechat-files.com using code signing certificates. It is associated with the threat group Gold Prelude and employs MITRE ATT&CK techniques including System Binary Proxy Execution (T1218), User Execution (T1204), Data Encoding (T1132), Trusted Relationship (T1199), and Encrypted Channel (T1573) for defense evasion, execution, and command-and-control. Its infrastructure has used domains such as okta-louisvuitton.com, mytsl.net, okta-onsolve.com, morningstar-okta.com, and acwa-apple.com, with targeting observed in the United Kingdom and the United States.[/profile]"
    },
