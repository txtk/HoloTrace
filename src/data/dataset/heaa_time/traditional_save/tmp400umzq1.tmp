        "name": "rule M_APT_Downloader_WINELOADER_2\r\n\r\n{\r\n\r\n    meta:\r\n\r\n        author = \"Mandiant\"\r\n\r\n        disclaimer = \"This rule is meant for hunting and is not tested to run in a production environment.\"\r\n\r\n        description = \"Detects payload invocation stub in WINELOADER\"\r\n\r\n \r\n\r\n    strings:\r\n\r\n        // 48 8D 0D ?? ?? 00 00  lea rcx, module_start (Pointer to encrypted resource)\r\n\r\n        // 48 C7 C2 ?? ?? 00 00  mov rdx, ???? (size of encrypted source)\r\n\r\n        // E8 [4]  call decryption\r\n\r\n        // 48 8D 05 [4]  lea rcx, ??\r\n\r\n        // 48 8D 0D [4]  lea rax, module_start (decrypted resource)\r\n\r\n        // 48 89 05 [4]  mov ptr_mod, rax\r\n\r\n        //\r\n\r\n        $ = {48 8D 0D ?? ?? 00 00 48 C7 C2 ?? ?? 00 00 E8 [4] 48 8d 0D [4] 48 8D 05 [4] 48 89 05 }\r\n\r\n \r\n\r\n    condition:\r\n\r\n        all of them\r\n\r\n}",
        "valid_from": "2024-03-22T19:49:37.000Z",
        "no_semantic_neighbors": [],
        "processed": true,
        "hsage": 8.179307969504034
    },
    "22105": {
        "semantic": 1,
        "unique_id": "90166cd9-b8c3-4f03-b471-83b79ea21824",
        "entity_type": "indicator",
        "valid_until": "2025-06-25T19:49:25.000Z",
        "name": "rule M_APT_Downloader_WINELOADER_1\r\n\r\n{\r\n\r\n    meta:\r\n\r\n        author = \"Mandiant\"\r\n\r\n        disclaimer = \"This rule is meant for hunting and is not tested to run in a production environment.\"\r\n\r\n        description = \"Detects rc4 decryption logic in WINELOADER samples\"\r\n\r\n \r\n\r\n    strings:\r\n\r\n        $ = {B9 00 01 00 00 99 F7 F9 8B 44 24 [50-200] 0F B6 00 3D FF 00 00 00} // Key initialization\r\n\r\n        $ = {0F B6 00 3D FF 00 00 00} // Key size\r\n\r\n \r\n\r\n    condition:\r\n\r\n        all of them\r\n\r\n \r\n\r\n}",
        "valid_from": "2024-03-22T19:49:25.000Z",
        "no_semantic_neighbors": [],
        "processed": true,
        "hsage": 8.179307969504034
    },
    "22106": {
        "semantic": 1,
        "unique_id": "fbfe2c93-f189-4d27-90b5-5aa20662a1fe",
        "entity_type": "indicator",
        "valid_until": "2025-06-25T19:49:13.000Z",
        "name": "rule M_APT_Dropper_Rootsaw_Obfuscated\r\n\r\n{\r\n\r\n    meta:\r\n\r\n        author = \"Mandiant\"\r\n\r\n        disclaimer = \"This rule is meant for hunting and is not tested to run in a production environment.\"\r\n\r\n        description = \"Detects obfuscated ROOTSAW payloads\"\r\n\r\n \r\n\r\n    strings:\r\n\r\n        $ = \"function _\"\r\n\r\n        $ = \"new XMLHttpRequest();\"\r\n\r\n        $ = \"'\\\\x2e\\\\x7a\\\\x69\\\\x70'\"\r\n\r\n        $ = \"'\\\\x4f\\\\x70\\\\x65\\\\x6e'\"\r\n\r\n        $ = \"\\\\x43\\\\x3a\\\\x5c\\\\x57\"\r\n\r\n \r\n\r\n    condition: \r\n\r\n        all of them\r\n\r\n}",
        "valid_from": "2024-03-22T19:49:13.000Z",
