    "20399": {
        "semantic": 1,
        "unique_id": "7fbe122f-bafb-45b7-bfc6-b024cb389d66",
        "entity_type": "malware",
        "name": "Truebot",
        "is_family": false,
        "no_semantic_neighbors": [
            "c0f8aeeb2d11c6e751ee87c40ee609aceb1c1036706a5af0d3d78738b6cc4125",
            "c9b874d54c18e895face055eeb6faa2da7965a336d70303d0bd6047bec27a29d",
            "0e3a14638456f4451fe8d76fdc04e591fba942c2f16da31857ca66293a58a4c3",
            "c042ad2947caf4449295a51f9d640d722b5a6ec6957523ebf68cddb87ef3545c"
        ],
        "processed": true,
        "hsage": 5.024211942266697,
        "profile_without_enhance_5": "[profile]Truebot is a malware attributed to the Silence Group and TA505. It performs system reconnaissance by scanning and enumerating OS version, processor architecture, and computer names. For defense evasion, it employs techniques including T1553 (Subverting Trust Controls), T1562 (Impairing Defenses), T1036.004 (Masquerading Tasks/Services), and T1132 (Data Encoding for C2 obfuscation). It also abuses local accounts (T1078.003). Its command-and-control infrastructure has used domains such as qweastradoc.com, winserverupdates.com, netviewremote.com, and windowservicecemter.com.[/profile]"
    },
    "20400": {
        "semantic": 1,
        "unique_id": "8b9e5037-1b94-40f7-a4f5-39e822db6611",
