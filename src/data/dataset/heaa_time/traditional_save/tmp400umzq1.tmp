    "17787": {
        "semantic": 1,
        "unique_id": "d8a8954d-a0ed-4e51-90a4-28b2d0b3c5df",
        "entity_type": "malware",
        "name": "XAgentOSX",
        "is_family": true,
        "no_semantic_neighbors": [
            "9562803f241fa89757bf5266f4378bd8ec0251df000bc7f324b7913e5fb6992a"
        ],
        "uncertain_related_groups": [
            "apt28"
        ],
        "uncertain_name": "xagentosx",
        "uncertain_mes": "[XAgentOSX](https://attack.mitre.org/software/S0161) is a trojan that has been used by [APT28](https://attack.mitre.org/groups/G0007)  on OS X and appears to be a port of their standard [CHOPSTICK](https://attack.mitre.org/software/S0023) or XAgent trojan. (Citation: XAgentOSX 2017)",
        "processed": true,
        "hsage": 7.699500340161678,
        "profile_without_enhance_5": "[profile]XAgentOSX, also known as XAgent, is a trojan malware family attributed to APT28. It is a port of the CHOPSTICK/XAgent trojan for OS X (macOS) and is developed similarly to the Komplex backdoor. Its key behaviors include capturing user input for credential theft (T1056), archiving collected data for exfiltration (T1560), querying the Windows Registry for system discovery (T1012), using application layer protocols like HTTP/S for command and control (T1071), and collecting data from the local system (T1005). Its primary target platform is macOS.[/profile]"
    },
    "17788": {
        "semantic": 1,
