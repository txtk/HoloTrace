            "a31f222fc283227f5e7988d1ad9c0aecd66d58bb7b4d8518ae23e110308dbf91",
            "bc1acdca196f1ff72722243be2afe1429b88122afb9d4852d6d6e57689411d3d",
            "81038a217237afd16d80da7fc9219cbd145f9698bb512e2b625559a47ba73fec",
            "93fb036e65c0683af5ffb98e2b61e30499dec068a4e15bf3bec8066d3e246852",
            "d777bcb6fba73faf96cb422383404c3b81a8afa5aebbc8ed70076081de7daa0c",
            "9f1f11a708d393e0a4109ae189bc64f1f3e312653dcf317a2bd406f18ffcc507",
            "902e087711ab8e612bd7cea9864bbadbe20a3500ba57f26f6eeb0b5b20b803ec"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "reverserat",
        "uncertain_mes": "APT attacks\non industrial\norganizations\nin H1 2021  \n26.10.2021\nVersion 1.1  \nAPT ATTACKS ON INDUSTRIAL ORGANIZATIONS\nIN H1 2021\n1\n© 2021 AO KASPERSKY LAB  \nSolarWinds ............................................................................................................................................................................................................ 2",
        "processed": true,
        "hsage": 13.384917666336335,
        "profile_without_enhance_5": "[profile]ReverseRAT is a Remote Access Trojan (RAT) malware. It uses the Application Layer Protocol for command and control (C2) and has been observed communicating with infrastructure such as reviewassignment.in and dns1.indianblog.xyz. For persistence, it employs the Boot or Logon Autostart Execution technique, specifically by modifying the Windows Registry. It also performs Security Software Discovery to identify defensive tools on the host. The malware is delivered via malicious HTA files hosted on domains like reviewassignment.online. Its primary targets are located in India and the British Indian Ocean Territory.[/profile]"
    },
    "19986": {
        "semantic": 1,
        "unique_id": "9914316f-b6b1-4a1f-bce3-485de929b270",
        "entity_type": "malware",
        "name": "Action RAT - S1028",
        "is_family": false,
        "no_semantic_neighbors": [
            "93fb036e65c0683af5ffb98e2b61e30499dec068a4e15bf3bec8066d3e246852",
            "81038a217237afd16d80da7fc9219cbd145f9698bb512e2b625559a47ba73fec",
            "902e087711ab8e612bd7cea9864bbadbe20a3500ba57f26f6eeb0b5b20b803ec",
            "d777bcb6fba73faf96cb422383404c3b81a8afa5aebbc8ed70076081de7daa0c",
            "9f1f11a708d393e0a4109ae189bc64f1f3e312653dcf317a2bd406f18ffcc507",
            "4a81bb3f9f9fe8a10002c043210ff537c2fd4a879a694d0f18468c70eaf65cfe",
            "37f20f232aa86316901baccbb44af1668b1d868c1ca9aba8fcb36584352b3e0f",
            "a31f222fc283227f5e7988d1ad9c0aecd66d58bb7b4d8518ae23e110308dbf91",
            "bc1acdca196f1ff72722243be2afe1429b88122afb9d4852d6d6e57689411d3d"
        ],
        "uncertain_related_groups": [
            "sidecopy"
        ],
        "uncertain_name": "action rat",
        "uncertain_mes": "[Action RAT](https://attack.mitre.org/software/S1028) is a  remote access tool written in Delphi that has been used by [SideCopy](https://attack.mitre.org/groups/G1008) since at least December 2021 against Indian and Afghani government personnel.(Citation: MalwareBytes SideCopy Dec 2021)",
        "processed": true,
        "hsage": 13.385148408836233,
        "profile_without_enhance_5": "[profile]Action RAT - S1028, also known as Action RAT, is a Delphi-written remote access tool attributed to the SideCopy threat group and used since at least December 2021. Its key behaviors include persistence via Boot or Logon Autostart Execution (T1547), defense evasion by modifying the Windows Registry (T1112), discovery of security software (T1518.001), execution via Windows Management Instrumentation (T1047), and command and control using application layer protocols like HTTP (T1071). It primarily targets government personnel in India and Afghanistan, with associated infrastructure including domains like reviewassignment.online and reviewassignment.in.[/profile]"
    },
