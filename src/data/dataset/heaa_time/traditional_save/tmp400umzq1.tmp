    "19403": {
        "semantic": 1,
        "unique_id": "d4398230-82bf-48ed-8428-55b2a1917bae",
        "entity_type": "malware",
        "name": "BellaCiao",
        "is_family": false,
        "no_semantic_neighbors": [
            "e4e3f09c4257269cef6cfbebc83c8a60376ce5e547080502e3e408a3f9916218"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "bellaciao",
        "uncertain_mes": "Identifier: TRR240801.",
        "processed": true,
        "hsage": 13.370696046006024,
        "profile_without_enhance_5": "[profile]BellaCiao, also known as bellaciao, is a malware publicly associated with the APT group Charming Kitten. Its key technical behaviors include using DNS (T1071.004) for command and control, employing data encoding (T1132) and asymmetric cryptography (T1573.002) to obfuscate C2 traffic, and establishing persistence via Boot or Logon Autostart Execution (T1547). It also utilizes binary padding (T1027.001) for defense evasion. The malware targets Windows, Linux, and macOS platforms and has used infrastructure such as the domain systemupdate.info and other potential validator domains like servicechecker[.]top and servicesupdate[.]info.[/profile]"
    },
    "19404": {
        "semantic": 1,
        "unique_id": "de6ff438-4cc4-4b4b-8d5b-d85f078b7102",
        "entity_type": "malware",
        "name": "BellaCPP",
        "is_family": false,
        "no_semantic_neighbors": [
            "e4e3f09c4257269cef6cfbebc83c8a60376ce5e547080502e3e408a3f9916218"
        ],
        "processed": true,
        "hsage": 5.673393106413264,
        "profile_without_enhance_5": "[profile]BellaCPP, also known as OtterCookie, BeaverTail, and GolangGhost, is attributed to the criminal group Wagemole. Its key technical behaviors include using Binary Padding (T1027.001) to evade detection, establishing command and control via DNS (T1071.004) and Data Encoding (T1132), and achieving persistence through Boot or Logon Autostart Execution (T1547). It also uses SSH (T1021.004) for lateral movement. The malware targets Windows, Linux, and macOS platforms and has been associated with the domain systemupdate.info.[/profile]"
    },
