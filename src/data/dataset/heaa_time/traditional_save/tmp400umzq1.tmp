    "17991": {
        "semantic": 1,
        "unique_id": "86dcff8b-76b0-4060-8054-4844715188fb",
        "entity_type": "malware",
        "name": "HTA Trojan",
        "is_family": false,
        "no_semantic_neighbors": [
            "4132840174222c62aa10950e9583463a614c3ecf24775aa44cffd7530f2e80b9",
            "11992682f4c485bb0543cba2830b061a050bc9fcc853358a4c38f1e706451ff8",
            "0fa7e3ffb8a9ca246cc1f1e3f6118ced7a7b785de510d777b316dfcefdddb0be",
            "332d9db35daa83c5ad226b9bf50e992713bc6a69c9ecd52a1223b81e992bc725"
        ],
        "processed": true,
        "hsage": 5.642865365212516,
        "profile_without_enhance_5": "[profile]HTA Trojan is a malware entity primarily targeting Windows platforms, often delivered via spearphishing attachments that trick users into executing malicious .hta files (User Execution). It leverages scripting interpreters like JavaScript (T1059.007) and Visual Basic (T1059.005) for execution, and employs obfuscation (T1027) and deobfuscation (T1140) techniques for defense evasion. It has been associated with APT34 (OilRig) in campaigns where .hta files activate scripts to deploy other payloads like the Helminth Trojan, and has been observed targeting locations such as Kazakhstan.[/profile]"
    },
