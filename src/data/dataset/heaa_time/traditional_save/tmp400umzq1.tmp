    "20101": {
        "semantic": 1,
        "unique_id": "56edba2d-a24f-42c5-af6d-77b9199ecf3b",
        "entity_type": "malware",
        "name": "FadeStealer",
        "is_family": false,
        "no_semantic_neighbors": [],
        "processed": true,
        "hsage": 5.706160710144438,
        "profile_without_enhance_5": "[profile]FadeStealer is a malware entity that employs defense evasion techniques such as Process Doppelgänging (T1055.013) to execute code without writing to disk and Mshta (T1218.005) to proxy malicious execution. It also utilizes techniques like Rename Legitimate Utilities (T1036.003) to bypass monitoring, and performs collection activities including Audio Capture (T1123) and Data from Removable Media (T1025). The malware targets Windows platforms."
    },
    "20102": {
        "semantic": 1,
        "phase_names": [
            "defense-evasion"
        ],
        "entity_type": "attack-pattern",
        "aliases": [
            "Masquerade Task or Service"
        ],
        "unique_id": "18f1cfa8-4472-4494-b008-f0679bf28531",
        "name": "T1036.004",
        "description": "Adversaries may attempt to manipulate the name of a task or service to make it appear legitimate or benign. Tasks/services executed by the Task Scheduler or systemd will typically be given a name and/or description.(Citation: TechNet Schtasks)(Citation: Systemd Service Units) Windows services will have a service name as well as a display name. Many benign tasks and services exist that have commonly associated names. Adversaries may give tasks or services names that are similar or identical to those of legitimate ones.\n\nTasks or services contain other fields, such as a description, that adversaries may attempt to make appear legitimate.(Citation: Palo Alto Shamoon Nov 2016)(Citation: Fysbis Dr Web Analysis)",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows"
        ],
        "standard_attck_id": "T1036.004",
        "standard_attck_name": "Masquerade Task or Service",
        "gid": 3988,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "fin13",
