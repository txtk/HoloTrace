        "entity_type": "malware",
        "name": "DarkTrack",
        "is_family": false,
        "no_semantic_neighbors": [
            "05880ff0442bbedc8f46076ef56d4d1ffeda68d9ef26b659c4868873fa84c1a9",
            "d6e6c786b793b46a1ee9b18b058e045d0aa1c83aa2b6aa493637f611d654d957",
