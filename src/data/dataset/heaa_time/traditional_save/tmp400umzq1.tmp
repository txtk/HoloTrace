    "21119": {
        "semantic": 1,
        "unique_id": "f3659d6b-d5b3-41d5-97c6-c2475ea1ac01",
        "entity_type": "malware",
        "name": "GhostLocker",
        "is_family": false,
        "no_semantic_neighbors": [
            "a1b468e9550f9960c5e60f7c52ca3c058de19d42eafa760b9d5282eb24b7c55f",
            "8fa28795e4cd95e6c78c4a1308ea80674102669f9980b2006599d82eff6237b3",
            "36760e9bbfaf5a28ec7f85d13c7e8078a4ee4e5168b672639e97037d66eb1d17",
            "8b758ccdfbfa5ff3a0b67b2063c2397531cf0f7b3d278298da76528f443779e9"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "ghostlocker",
        "uncertain_mes": "The hacker collective called GhostSec has unveiled an innovative Ransomware-as-a-Service (RaaS) framework called GhostLocker. They provide comprehensive assistance to customers interested in acquiring this service through a dedicated Telegram channel. Presently, GhostSec is focusing its attacks on Israel. This move represents a surprising departure from their past activities and stated agenda.",
        "processed": true,
        "hsage": 13.357051600877316,
        "profile_without_enhance_5": "[profile]GhostLocker is a sophisticated Ransomware-as-a-Service (RaaS) framework operated by the hacktivist group GhostSec. Its key technical behaviors include encrypting data for impact (T1486), inhibiting system recovery by targeting features like Volume Shadow Copies (T1490), and performing indicator removal (T1070). It also modifies the Windows Registry (T1112) and captures user input (T1056). The malware primarily targets systems in Israel, as indicated by its infrastructure, which uses HTTP endpoints like http://94.103.91.246/addInfection for command and control.[/profile]"
    },
    "21120": {
        "created_time": "2025-08-14T07:26:35.106Z",
        "semantic": 1,
        "aka_name": [],
        "entity_type": "intrusion-set",
        "unique_id": "3609924c-88c5-4f72-8076-ce0be11e4eb9",
        "modified_time": "2025-08-14T15:24:34.306Z",
        "group_name": "GhostSec",
        "name": "unkown_apt_group",
        "description": "",
        "no_semantic_neighbors": [
            "36760e9bbfaf5a28ec7f85d13c7e8078a4ee4e5168b672639e97037d66eb1d17",
            "a1b468e9550f9960c5e60f7c52ca3c058de19d42eafa760b9d5282eb24b7c55f",
            "8fa28795e4cd95e6c78c4a1308ea80674102669f9980b2006599d82eff6237b3",
            "8b758ccdfbfa5ff3a0b67b2063c2397531cf0f7b3d278298da76528f443779e9"
        ],
        "processed": true,
        "hsage": 0.0,
        "profile_without_enhance_5": "[profile]This intrusion set, likely associated with the hacktivist group GhostSec, is best identified by its operation of the GhostLocker ransomware. It is also known as BackdoorDiplomacy, Backdip, Quarian, and CloudComputating. Its key malware is the GhostLocker Ransomware-as-a-Service (RaaS) framework, and its primary technical behaviors include data encryption for impact (T1486), inhibiting system recovery by deleting backups and Volume Shadow Copies (T1490), performing indicator removal (T1070), and capturing user input (T1056). The group is attributed to hacktivist motivations and primarily targets systems in Israel, using infrastructure such as http://94.103.91.246 for command and control.[/profile]"
    },
