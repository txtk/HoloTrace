    "20488": {
        "semantic": 1,
        "unique_id": "2b69d27f-7822-4657-a671-44f0a23a2b04",
        "entity_type": "malware",
        "name": "BRICKSTORM",
        "is_family": false,
        "no_semantic_neighbors": [
            "b42159d68ba58d7857c091b5acc59e30e50a854b15f7ce04b61ff6c11cdf0156",
            "42692bd13333623e9085d0c1326574a3391efcbf18158bb04972103c9ee4a3b8"
        ],
        "uncertain_related_groups": [
            "uta0178"
        ],
        "uncertain_name": "brickstorm",
        "uncertain_mes": "Another BRICKSTORM: Stealthy Backdoor Enabling Espionage into Tech and Legal Sectors\nMandiant\nGoogle Threat Intelligence Group\nWritten by: Sarah Yoder, John Wolfram, Ashley Pearson, Doug Bienstock, Josh Madeley, Josh Murchie, Brad Slaybaugh, Matt Lin, Geoff Carstairs, Austin Larsen\nIntroduction",
        "processed": true,
        "hsage": 13.353009894003847,
        "profile_without_enhance_5": "[profile]BRICKSTORM is a stealthy espionage backdoor attributed to the UTA0178 group. Its key technical behaviors include command-and-control via application layer protocols like HTTP, employing data encoding and encrypted channels to obfuscate traffic, and using remote services for lateral movement. It has been observed targeting the technology and legal sectors, utilizing infrastructure such as ms-azure.herokuapp.com.[/profile]"
    },
