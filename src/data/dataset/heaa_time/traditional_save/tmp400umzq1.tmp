            "615bfe8f7f3903bb380f59bca6339d1b37125cc9d303f935e7197ff0706fded7",
            "244885707e1ccfb02160ae60d749bafcfbcfd1d2572afed9113010609cd43820",
            "3b26e27031a00a32f3616de5179a003951a9c92381cd8ec552d39f7285ff42ee",
            "ad39ad35084d8339744299def3af979e666add8103ebd706de3cd1430d3ca8a1",
            "3e7bf3a34c4dfa6abfce8254f213cbc98331504fa956b8d35e0961966593034f",
            "e58fcd4a8d13cb1847f08fd3db6f86473c589f935bcf76ff2837bfac3e8f8f6e",
            "ff8eccca561e07a4d3b1a229b307cd1e787fe9fe21a781f361e3f01750def89c",
            "597dd1e09bd23cd18132ce27a731d0b66c78381e90292ece0f23738773743a7c",
            "45bfc3928dd2bb3f7ed388ddd0e109b93aebe3dd0e22609d743673c6c0425732",
            "8b27b0482330d0cb38ac7b578576de5658faeba242d2abc9d94289271e2d16b3",
            "e7914f823ed0763c7a03c3cfdbcf9344e1da93597733ac22fe3d31a5a4e179aa",
            "7c72e817069bc966a8166a701da397508d44fe9da0e72a047fcf3d694eee81e9",
            "2ba51d7e338242bc6a8109317b91dd13137e296693c535ceacc1288775acc81f",
            "916153d8265a2f9344648e302c6b7b8d7e1f40f704b0df83edde43986ab68e56",
            "6a3a0606293941ce9c3cebe0a3e63d7cdc6fb92fd4507d99b14c7675dd29ab40",
            "555ef671179b83989858b6d084b3aee0a379c9d8c75ca292961373d3b71315f8",
            "dd65c3ad7473f211ae661ccc37f8017b9697dfffb75d415cb035399c14bc1bc9"
        ],
        "uncertain_related_groups": [
            "未知"
        ],
        "uncertain_name": "romcom rat",
        "uncertain_mes": "Ukraine remains Russia’s biggest cyber focus in 2023\nGoogle’s Threat Analysis Group (TAG) continues to disrupt campaigns from multiple sets of Russian government-backed attackers focused on the war in Ukraine. This blog provides insights on attacker trends from primarily January - March 2023, continuing our analysis from Fog of War: How the Ukraine Conflict Transformed the Cyber Threat Landscape.",
        "processed": true,
        "hsage": 13.49347089301644,
        "profile_without_enhance_5": "[profile]ROMCOM RAT, also known as romcom rat, is a Remote Access Tool (RAT) deployed via dropper files like setup.exe and hlpr.dat. It is associated with activity targeting Ukraine and leverages phishing (T1566) for initial access. Its command and control utilizes domains such as gangstergo.com, mansoftwarecoz.com, nexiandevel.com, pdf-filer.com, and wexonlake.com, which aligns with the Acquire Infrastructure (T1583) technique. The malware employs Remote Access Tools (T1219) for C2, can capture screens (T1113), and targets credentials from password stores (T1555), indicating a focus on Windows platforms for credential theft and data collection.[/profile]"
    },
    "21134": {
        "semantic": 0,
        "unique_id": "0a1b93a9-8b25-432d-9615-b83c61a8cecf",
        "entity_type": "indicator",
        "valid_until": "2024-09-01T15:10:56.000Z",
        "name": "8b27b0482330d0cb38ac7b578576de5658faeba242d2abc9d94289271e2d16b3",
        "valid_from": "2023-05-30T15:10:56.000Z",
        "no_semantic_neighbors": [
            "{'SHA-256': '8b27b0482330d0cb38ac7b578576de5658faeba242d2abc9d94289271e2d16b3'}"
        ],
