    "16519": {
        "semantic": 1,
        "unique_id": "24129228-281c-4fda-980b-609b5cc2e4dc",
        "entity_type": "malware",
        "name": "QuasarRAT",
        "is_family": false,
        "no_semantic_neighbors": [
            "18f11ac8be104b23e282d01156ae251b59e9a93d5d504a32306f15358d4da019",
            "503ba890a3a849057c199aa78367aec8e99d77270fc280df7f1988dff7331d80",
            "22f98117e5e182bf3de5b86dbf29953163df88eff0a182729931b9976bf884c0",
            "7860838e0e073637ec889ba1f1564d363b6a16d6185f9cbb9bb30d38a394335b",
            "ec2dd6753e42f0e0b173a98f074aa41d2640390c163ae77999eb6c10ff7e2ebd",
            "7c24496d765ada6b1de182bb3a5e36894f699a855a17810dc163a615a47db714",
            "b55ea05c32535a6089c3db3124163c023facd2ea7c42e21ad32c599e498a3bf5"
        ],
        "processed": true,
        "hsage": 5.844166854842222,
        "profile_without_enhance_5": "[profile]QuasarRAT is a remote access trojan (RAT) also known as Quasar rat. It has been attributed to threat groups including APT33, Dropping Elephant, Stone Panda, and The Gorgon Group. Its key technical behaviors include GUI Input Capture for credential theft, the use of Mark-of-the-Web Bypass for defense evasion, and data obfuscation via Steganography. It targets Windows systems and has been associated with infrastructure domains such as securedrive.privatedns.org, account-profile.servepics.com, and bikaro.store, with observed activity in Colombia, Ecuador, Australia, Japan, and Taiwan.[/profile]"
    },
