    "19375": {
        "semantic": 1,
        "phase_names": [
            "command-and-control"
        ],
        "entity_type": "attack-pattern",
        "aliases": [
            "Data Obfuscation"
        ],
        "unique_id": "42368e21-4ffb-43e7-b3e8-69adf7ea1554",
        "name": "T1001",
        "description": "Adversaries may obfuscate command and control traffic to make it more difficult to detect.(Citation: Bitdefender FunnyDream Campaign November 2020) Command and control (C2) communications are hidden (but not necessarily encrypted) in an attempt to make the content more difficult to discover or decipher and to make the communication less conspicuous and hide commands from being seen. This encompasses many methods, such as adding junk data to protocol traffic, using steganography, or impersonating legitimate protocols.",
        "kill_chain_names": [
            "mitre-attack"
        ],
        "x_mitre_description": "",
        "platforms": [
            "macos",
            "linux",
            "windows",
            "ESXi"
        ],
        "standard_attck_id": "T1001",
        "standard_attck_name": "Data Obfuscation",
        "gid": 3258,
        "no_semantic_neighbors": [],
        "uncertain_related_groups": [
            "gamaredon group"
        ],
        "uncertain_id": "t1001",
        "uncertain_name": "data obfuscation",
        "uncertain_mes": "Adversaries may obfuscate command and control traffic to make it more difficult to detect.(Citation: Bitdefender FunnyDream Campaign November 2020) Command and control (C2) communications are hidden (but not necessarily encrypted) in an attempt to make the content more difficult to discover or decipher and to make the communication less conspicuous and hide commands from being seen. This encompasses many methods, such as adding junk data to protocol traffic, using steganography, or impersonating legitimate protocols. ",
        "processed": true,
        "hsage": 13.946371158082073,
        "profile_without_enhance_5": "[profile]T1001, known as Data Obfuscation, is a Command and Control technique applicable to Windows, Linux, macOS, and ESXi platforms. It involves hiding C2 traffic to evade detection, not necessarily through encryption, but by methods such as adding junk data to protocol traffic, using steganography, or impersonating legitimate protocols. A specific sub-technique, T1001.001 (Junk Data), involves appending random characters to hinder traffic analysis. This technique is distinct from Protocol Tunneling (T1572) or Custom C2 Protocols (T1094), which encapsulate or create entirely new protocols, respectively."
    },
    "19376": {
        "semantic": 1,
        "unique_id": "cb82388c-8c5b-4678-b76f-882b1bac659b",
        "entity_type": "vulnerability",
        "name": "CVE-2024-43451",
        "no_semantic_neighbors": [],
