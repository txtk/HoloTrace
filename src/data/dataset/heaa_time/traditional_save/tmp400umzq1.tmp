    "20691": {
        "created_time": "2018-04-18T17:59:24.739Z",
        "semantic": 1,
        "aka_name": [],
        "entity_type": "intrusion-set",
        "unique_id": "ed7454e2-18f3-4384-a3fe-bd350a28bf8f",
        "modified_time": "2025-08-21T12:24:15.131Z",
        "group_name": "APT33",
        "name": "unkown_apt_group",
        "description": "",
        "no_semantic_neighbors": [
            "22017c9b022e6f2560fee7d544a83ea9e3d85abee367f2f20b3b0448691fe2d4",
            "5df4269998ed79fbc997766303759768ce89ff1412550b35ff32e85db3c1f57b",
            "{'SHA-256': '364275326bbfc4a3b89233dabdaf3230a3d149ab774678342a40644ad9f8d614'}",
            "56ac00856b19b41bc388ecf749eb4651369e7ced0529e9bf422284070de457b6",
            "364275326bbfc4a3b89233dabdaf3230a3d149ab774678342a40644ad9f8d614",
            "e984d9085ae1b1b0849199d883d05efbccc92242b1546aeca8afd4b1868c54f5",
            "fb70ff49411ce04951895977acfc06fa468e4aa504676dedeb40ba5cea76f37f",
            "7eb2e9e8cd450fc353323fd2e8b84fbbdfe061a8441fd71750250752c577d198",
            "711d3deccc22f5acfd3a41b8c8defb111db0f2b474febdc7f20a468f67db0350",
            "dad53a78662707d182cdb230e999ef6effc0b259def31c196c51cc3e8c42a9b8",
            "ccb617cc7418a3b22179e00d21db26754666979b4c4f34c7fda8c0082d08cec4"
        ],
        "processed": true,
        "hsage": 0.0,
        "profile_without_enhance_5": "[profile]This intrusion set is most likely APT28 (also known as Fancy Bear, Sofacy, and Strontium), with retrieved information suggesting possible overlaps or links with the group known as Backdoordiplomacy (aka backdip, quarian, cloudcomputating). Its key malware is Tickler (aka Cannon), which notably employs the One-Way Communication (T1102.003) C2 technique using external web services. Key TTPs include credential dumping via NTDS (T1003.003) and abuse of remote services (T1021) for lateral movement. The group is attributed to Russian state-sponsored actors. Its operations, as indicated by the malware's targeting, have affected entities in Australia, the United Arab Emirates, and the United States, with a motivation consistent with espionage.[/profile]"
    },
