    "24279": {
        "semantic": 1,
        "unique_id": "4885fd17-5ffa-495a-8ec9-d7508292162a",
        "entity_type": "malware",
        "name": "PLUSINJECT",
        "is_family": false,
        "no_semantic_neighbors": [
            "469b534bec827be03c0823e72e7b4da0b84f53199040705da203986ef154406a",
            "151257e9dfda476cdafd9983266ad3255104d72a66f9265caa8417a5fe1df5d7",
            "50124174a4ac0d65bf8b6fd66f538829d1589edc73aa7cf36502e57aa5513360",
            "3b88b3efbdc86383ee9738c92026b8931ce1c13cd75cd1cda2fa302791c2c4fb"
        ],
        "processed": true,
        "hsage": 5.749132821114339,
        "profile_without_enhance_5": "[profile]PLUSINJECT is a malware injector. Its technical behaviors include using Domain Generation Algorithms (DGA), One-Way Communication via web services (T1102.003), Process Hollowing (T1055.012), Multi-hop Proxy routing (T1090.003), and Binary Padding (T1027.001). It targets Windows systems and has used infrastructure domains such as word.msapp.workers.dev, cloud.msapp.workers.dev, resource.infinityfreeapp.com, pubs.infinityfreeapp.com, and term-restore-satisfied-hence.trycloudflare.com. It is associated with activity targeting Taiwan.[/profile]"
    },
    "24280": {
        "semantic": 1,
        "unique_id": "3a0801b7-b247-44db-b775-2c0349958abc",
        "entity_type": "malware",
        "name": "PLUSDROP",
        "is_family": false,
        "no_semantic_neighbors": [
            "50124174a4ac0d65bf8b6fd66f538829d1589edc73aa7cf36502e57aa5513360",
            "469b534bec827be03c0823e72e7b4da0b84f53199040705da203986ef154406a",
            "151257e9dfda476cdafd9983266ad3255104d72a66f9265caa8417a5fe1df5d7",
            "3b88b3efbdc86383ee9738c92026b8931ce1c13cd75cd1cda2fa302791c2c4fb"
        ],
        "processed": true,
        "hsage": 5.745528372886488,
        "profile_without_enhance_5": "[profile]PLUSDROP, also known as MAGICHOUND.DROPIT, is a malware associated with groups like Magic Hound, Rocket Kitten, APT33, APT35, and OilRig. Its key techniques include using Domain Generation Algorithms (DGAs) for resilient command-and-control, One-Way Communication via services like Google or Twitter to send instructions, Process Hollowing to evade detection on Windows by masking malicious code in legitimate processes, Multi-hop Proxy chaining to obscure traffic sources, and Data Encoding (e.g., Base64) to obfuscate C2 content. It targets platforms including Windows, macOS, Linux, and ESXi, and has used infrastructure such as resource.infinityfreeapp.com, cloud.msapp.workers.dev, and trycloudflare.com domains.[/profile]"
    },
    "24281": {
        "semantic": 1,
        "unique_id": "a416de72-9fbf-478b-b2e1-918b2b4c2bba",
        "entity_type": "malware",
        "name": "ToughProgress",
        "is_family": false,
        "no_semantic_neighbors": [
            "469b534bec827be03c0823e72e7b4da0b84f53199040705da203986ef154406a",
            "151257e9dfda476cdafd9983266ad3255104d72a66f9265caa8417a5fe1df5d7",
            "50124174a4ac0d65bf8b6fd66f538829d1589edc73aa7cf36502e57aa5513360",
            "3b88b3efbdc86383ee9738c92026b8931ce1c13cd75cd1cda2fa302791c2c4fb"
        ],
        "processed": true,
        "hsage": 5.741561384680613,
        "profile_without_enhance_5": "[profile]ToughProgress is a malware that employs Domain Generation Algorithms (DGA) for resilient command-and-control, uses One-Way Communication via external web services to send instructions, and utilizes Process Hollowing for defense evasion on Windows. Its infrastructure includes domains like cloud.msapp.workers.dev, pubs.infinityfreeapp.com, and resource.infinityfreeapp.com, and it has been observed targeting Taiwan.[/profile]"
    },
