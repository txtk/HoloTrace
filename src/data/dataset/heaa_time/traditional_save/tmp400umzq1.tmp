    "20804": {
        "semantic": 1,
        "unique_id": "ea22852c-7e75-48c4-996c-a4d078d2369d",
        "entity_type": "malware",
        "name": "DCHSpy",
        "is_family": true,
        "no_semantic_neighbors": [
            "79.132.128.81",
            "46.30.188.243",
            "n14mit69company.top",
            "422819e7f665ae0d411cf2a877a2f7b6721abb8df44df852d2d0e76eb74331b7",
            "55e8b2d87f80ba609dcf793afc50f66e5967e40dbf54229a256709fa348f3351",
            "a4913f52bd90add74b796852e2a1d9acb1d6ecffe359b5710c59c82af59483ec",
            "aa656a243d2008327e06fd5bbad919eea99aa271132dbaeabb146e22effbfd1b",
            "3a052d56706a67f918ed3a9acec9a2da428a20065e261d8e40b73badb4c9d7f4",
            "162ce2ad2611626988c8520366f1f76feca2c75505a3686c955ecc25f4946442"
        ],
        "uncertain_related_groups": [
            "muddywater"
        ],
        "uncertain_name": "dchspy",
        "uncertain_mes": "Article\nDHCSpy - Discovering the Iranian APT MuddyWater\n29 sept. 2025\nRandorisec - Shindan\nAuthors: Paul (R3dy) Viard\nIn this article, we will deep dive into internals works and key components of a new sample of the DHCSpy Android spyware family, discovered by Lookout after the start of the Israel-Iran conflict. This malware is developed and maintained by an Iranian APT : MuddyWater.",
        "processed": true,
        "hsage": 13.406937192088847,
        "profile_without_enhance_5": "[profile]DCHSpy, also known as DHCSpy, is an Android spyware family attributed to the Iranian APT group MuddyWater. Its key technical behaviors include audio recording, screenshot capture, keylogging, and functioning as a DNS-tunneling backdoor. It targets Android platforms and has been associated with infrastructure indicators such as the C2 server https://r1.earthvpn.org:3413 and the download URL http://45.86.163.10/class/mcrypt.php.[/profile]"
    },
